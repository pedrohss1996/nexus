{
  "name": "dataflow",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de documentos e processos hospitalares",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:css\"",
    "dev:server": "nodemon server.js",
    "dev:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "postinstall": "npm run build:css",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:baseline": "node scripts/migrate.js baseline",
    "check:orfaos": "node scripts/check-orfaos-unidade.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "seed": "node scripts/seed.js",
    "seed:marlon": "node scripts/seed-usuario-marlon.js",
    "generate-secrets": "node scripts/generate-secrets.js",
    "test:db": "node scripts/test-connection.js",
    "fix:constraint": "node scripts/fix-usuarios-grupos-constraint.js",
    "check:usuarios-grupos": "node scripts/check-usuarios-grupos-structure.js"
  },
  "keywords": [
    "documentos",
    "processos",
    "hospital",
    "gestao"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "html-to-text": "^9.0.5",
    "htmlparser2": "^10.1.0",
    "jodit": "^4.9.14",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "puppeteer": "^24.37.5",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.1"
  }
}
