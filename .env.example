# ============================================
# DataFlow - Configuração de Ambiente (TEMPLATE)
# ============================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env na raiz do projeto:  cp .env.example .env
# 2. Preencha os valores abaixo com suas informações
# 3. NUNCA commite o arquivo .env no Git!
#
# ============================================

# Servidor
NODE_ENV=development
PORT=3000

# ============================================
# Banco de Dados PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataflow
DB_USER=postgres
DB_PASSWORD=

# Alternativa: string de conexão completa (tem precedência sobre as variáveis acima)
DATABASE_URL=

# Verificação do certificado TLS do banco.
# Em produção mantenha "true" e informe o CA em DB_SSL_CA quando o provedor
# usar certificado próprio. Use "false" apenas em desenvolvimento local.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# ============================================
# Autenticação JWT
# ============================================
# OBRIGATÓRIO. Gere com: npm run generate-secrets
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ============================================
# Session
# ============================================
# OBRIGATÓRIO. Gere com: npm run generate-secrets
SESSION_SECRET=

# ============================================
# Upload de Arquivos
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# ============================================
# Socket.io (Real-time)
# ============================================
SOCKET_CORS_ORIGIN=http://localhost:3000

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Proxy reverso (Railway, Heroku, Nginx...)
# ============================================
# Número de proxies à frente da aplicação. Necessário para que o rate limit
# e os logs de auditoria enxerguem o IP real do cliente. Use 0 sem proxy.
TRUST_PROXY=1

# ============================================
# Agendador de tarefas em background
# ============================================
# Defina "true" em apenas UMA instância quando houver múltiplas réplicas,
# para evitar notificações duplicadas.
ENABLE_SCHEDULER=true

# ============================================
# IA (opcional — sugestão de fluxos)
# ============================================
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Login
# ============================================
LOGIN_IMAGE_PATH=/imgs/login-banner.jpg
