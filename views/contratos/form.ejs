<%- include('../partials/header', { title: title, user: user }) %>
<%
  const c = contrato || {};
  const tipoLabels = typeof TIPO_LABELS !== 'undefined' ? TIPO_LABELS : {};
  const statusLabels = typeof STATUS_LABELS !== 'undefined' ? STATUS_LABELS : {};
  function fmtDateInput(v) { if (!v) return ''; const d = new Date(v); if (isNaN(d)) return ''; return d.toISOString().split('T')[0]; }
%>

<div class="w-full px-6 py-6">
  <div class="max-w-6xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-5">
      <a href="/contratos" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Contratos</a>
      <svg class="w-4 h-4 mx-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-900 dark:text-white font-medium"><%= editando ? 'Editar ' + c.codigo : 'Novo Contrato' %></span>
    </nav>

    <% if (erro) { %>
      <div class="mb-4 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 text-sm text-red-700 dark:text-red-300 flex items-center gap-2">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= erro %>
      </div>
    <% } %>

    <form method="POST" action="<%= editando ? '/contratos/' + c.id : '/contratos' %>" class="space-y-4" id="contratoForm">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <!-- Seção 1: Informações Básicas -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Informações Básicas
          </h2>
        </div>
        <div class="p-5 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Código <span class="text-red-500">*</span></label>
              <input type="text" name="codigo" value="<%= c.codigo || '' %>" required maxlength="50" <%= editando ? 'readonly' : '' %>
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 <%= editando ? 'bg-gray-50 dark:bg-slate-600 cursor-not-allowed' : '' %>">
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Nome do Contrato <span class="text-red-500">*</span></label>
              <input type="text" name="nome" value="<%= c.nome || '' %>" required maxlength="255" placeholder="Ex: Manutenção predial sede"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Tipo de Contrato <span class="text-red-500">*</span></label>
              <select name="tipo" required class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
                <option value="">Selecione...</option>
                <% Object.entries(tipoLabels).forEach(function([k,v]) { %>
                  <option value="<%= k %>" <%= c.tipo === k ? 'selected' : '' %>><%= v %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Status</label>
              <select name="status" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
                <% Object.entries(statusLabels).forEach(function([k,v]) { %>
                  <option value="<%= k %>" <%= c.status === k ? 'selected' : '' %>><%= v %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Descrição</label>
            <textarea name="descricao" rows="3" placeholder="Descreva o objeto do contrato..."
              class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500"><%= c.descricao || '' %></textarea>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Fornecedor (cadastrado)</label>
              <select name="fornecedor_id" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
                <option value="">— Nenhum —</option>
                <% if (fornecedores) { fornecedores.forEach(function(f) { %>
                  <option value="<%= f.id %>" <%= String(c.fornecedor_id) === String(f.id) ? 'selected' : '' %>><%= f.nome_fantasia || f.razao_social %> (<%= f.cnpj %>)</option>
                <% }); } %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Ou nome da empresa contratada</label>
              <input type="text" name="empresa_contratada" value="<%= c.empresa_contratada || '' %>" maxlength="255" placeholder="Nome livre"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Responsável Interno</label>
              <select name="responsavel_interno_id" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
                <option value="">— Nenhum —</option>
                <% if (usuarios) { usuarios.forEach(function(u) { %>
                  <option value="<%= u.id %>" <%= String(c.responsavel_interno_id) === String(u.id) ? 'selected' : '' %>><%= u.nome %></option>
                <% }); } %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Departamento Responsável</label>
              <input type="text" name="departamento_responsavel" value="<%= c.departamento_responsavel || '' %>" maxlength="255" placeholder="Ex: TI, Jurídico, RH..."
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
          </div>
        </div>
      </div>

      <!-- Seção 2: Dados Financeiros -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Dados Financeiros
          </h2>
        </div>
        <div class="p-5 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Valor Total (R$)</label>
              <input type="number" step="0.01" name="valor_total" value="<%= c.valor_total || '' %>" placeholder="0,00"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Valor Mensal (R$)</label>
              <input type="number" step="0.01" name="valor_mensal" value="<%= c.valor_mensal || '' %>" placeholder="0,00"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Moeda</label>
              <select name="moeda" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
                <option value="BRL" <%= c.moeda === 'BRL' ? 'selected' : '' %>>R$ (BRL)</option>
                <option value="USD" <%= c.moeda === 'USD' ? 'selected' : '' %>>US$ (USD)</option>
                <option value="EUR" <%= c.moeda === 'EUR' ? 'selected' : '' %>>€ (EUR)</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Forma de Pagamento</label>
              <input type="text" name="forma_pagamento" value="<%= c.forma_pagamento || '' %>" maxlength="100" placeholder="Ex: Boleto, transferência..."
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Índice de Reajuste</label>
              <div class="flex gap-2">
                <select name="indice_reajuste" id="indiceReajuste" class="flex-1 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
                  <option value="">— Nenhum —</option>
                  <option value="IPCA" <%= c.indice_reajuste === 'IPCA' ? 'selected' : '' %>>IPCA</option>
                  <option value="IGPM" <%= c.indice_reajuste === 'IGPM' ? 'selected' : '' %>>IGP-M</option>
                  <option value="OUTRO" <%= c.indice_reajuste === 'OUTRO' ? 'selected' : '' %>>Outro</option>
                </select>
                <input type="text" name="indice_reajuste_outro" id="indiceOutro" value="<%= c.indice_reajuste_outro || '' %>" maxlength="100" placeholder="Qual?"
                  class="flex-1 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 <%= c.indice_reajuste !== 'OUTRO' ? 'hidden' : '' %>">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Seção 3: Datas e Vigência -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Datas e Vigência
          </h2>
        </div>
        <div class="p-5">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Data de Início</label>
              <input type="date" name="data_inicio" value="<%= fmtDateInput(c.data_inicio) %>"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Data de Término</label>
              <input type="date" name="data_termino" value="<%= fmtDateInput(c.data_termino) %>" id="dataTermino"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Prazo (meses)</label>
              <input type="number" name="prazo_meses" value="<%= c.prazo_meses || '' %>" min="1" id="prazoMeses"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Próximo Reajuste</label>
              <input type="date" name="data_proximo_reajuste" value="<%= fmtDateInput(c.data_proximo_reajuste) %>"
                class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
            </div>
          </div>
        </div>
      </div>

      <!-- Botões -->
      <div class="flex items-center justify-between pt-2">
        <a href="<%= editando ? '/contratos/' + c.id : '/contratos' %>" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white font-medium transition-colors">Cancelar</a>
        <button type="submit" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <%= editando ? 'Salvar Alterações' : 'Criar Contrato' %>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Toggle do campo "Outro" índice de reajuste
  document.getElementById('indiceReajuste')?.addEventListener('change', function() {
    var outro = document.getElementById('indiceOutro');
    if (this.value === 'OUTRO') { outro.classList.remove('hidden'); } else { outro.classList.add('hidden'); outro.value = ''; }
  });
  // Auto-calcular prazo em meses quando preenche datas
  var dataInicio = document.querySelector('[name="data_inicio"]');
  var dataTermino = document.getElementById('dataTermino');
  var prazo = document.getElementById('prazoMeses');
  function calcPrazo() {
    if (dataInicio.value && dataTermino.value) {
      var d1 = new Date(dataInicio.value), d2 = new Date(dataTermino.value);
      var meses = (d2.getFullYear() - d1.getFullYear()) * 12 + (d2.getMonth() - d1.getMonth());
      if (meses > 0) prazo.value = meses;
    }
  }
  dataInicio?.addEventListener('change', calcPrazo);
  dataTermino?.addEventListener('change', calcPrazo);
</script>

<%- include('../partials/footer') %>
