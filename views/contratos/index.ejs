<%- include('../partials/header', { title: title, user: user }) %>
<%
  const tipoLabels = typeof TIPO_LABELS !== 'undefined' ? TIPO_LABELS : {};
  const statusLabels = typeof STATUS_LABELS !== 'undefined' ? STATUS_LABELS : {};
  const statusColors = {
    ativo: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
    suspenso: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300',
    encerrado: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
    em_renovacao: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300'
  };
  const d = typeof dash !== 'undefined' ? dash : { stats: {} };
  const s = d.stats || {};
  const al = typeof alertas !== 'undefined' ? alertas : {};
  const totalAl = typeof totalAlertas !== 'undefined' ? totalAlertas : 0;
  function fmtMoney(v) { return Number(v||0).toLocaleString('pt-BR', {style:'currency',currency:'BRL'}); }
  function fmtDate(v) { if (!v) return '—'; const dt = new Date(v); return dt.toLocaleDateString('pt-BR'); }
%>

<div class="w-full px-6 py-4 space-y-4">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Gestão de Contratos</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Controle completo de contratos, SLAs, obrigações e financeiro</p>
    </div>
    <a href="/contratos/novo" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-medium text-sm transition-colors whitespace-nowrap">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Novo Contrato
    </a>
  </div>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="p-3 rounded-lg text-sm <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 text-red-700 dark:text-red-300' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 text-green-700 dark:text-green-300' %>"><%= flash.error || flash.success %></div>
  <% } %>

  <!-- Gráfico de Custo Mensal -->
  <%
    const cm = typeof custoMensal !== 'undefined' ? custoMensal : [];
    const gi = typeof grafInicio !== 'undefined' ? grafInicio : '';
    const gf = typeof grafFim !== 'undefined' ? grafFim : '';
    const mesSelecionado = filtros.mes || '';
    const mesesNomes = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  %>
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-100 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <h2 class="text-sm font-bold text-gray-900 dark:text-white">Custo Mensal dos Contratos</h2>
        <% if (mesSelecionado) { %>
          <span class="ml-2 px-2 py-0.5 rounded-full text-xs font-semibold bg-cyan-100 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-300">
            Filtrando: <%= mesesNomes[parseInt(mesSelecionado.split('-')[1]) - 1] %>/<%= mesSelecionado.split('-')[0] %>
          </span>
          <a href="/contratos?<%= filtros.status ? 'status=' + filtros.status + '&' : '' %><%= filtros.tipo ? 'tipo=' + filtros.tipo + '&' : '' %><%= filtros.busca ? 'busca=' + encodeURIComponent(filtros.busca) + '&' : '' %>graf_inicio=<%= gi %>&graf_fim=<%= gf %>" class="text-xs text-red-500 hover:text-red-700 font-medium ml-1">Limpar filtro</a>
        <% } %>
      </div>
      <form method="GET" action="/contratos" class="flex items-center gap-2 flex-shrink-0" id="formGrafico">
        <% if (filtros.busca) { %><input type="hidden" name="busca" value="<%= filtros.busca %>"><% } %>
        <% if (filtros.status) { %><input type="hidden" name="status" value="<%= filtros.status %>"><% } %>
        <% if (filtros.tipo) { %><input type="hidden" name="tipo" value="<%= filtros.tipo %>"><% } %>
        <% if (filtros.departamento) { %><input type="hidden" name="departamento" value="<%= filtros.departamento %>"><% } %>
        <label class="text-xs text-gray-500 dark:text-gray-400">De:</label>
        <input type="month" name="graf_inicio" value="<%= gi.slice(0,7) %>"
          class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-2 py-1.5 text-xs focus:ring-2 focus:ring-cyan-500">
        <label class="text-xs text-gray-500 dark:text-gray-400">Até:</label>
        <input type="month" name="graf_fim" value="<%= gf.slice(0,7) %>"
          class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-2 py-1.5 text-xs focus:ring-2 focus:ring-cyan-500">
        <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">Aplicar</button>
      </form>
    </div>
    <div class="p-4" style="height: 260px; position: relative;">
      <canvas id="chartCustoMensal"></canvas>
    </div>
  </div>

  <!-- Mini Dashboard -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Contratos Ativos</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= s.ativos || 0 %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Valor Total Contratado</p>
      <p class="text-lg font-bold text-gray-900 dark:text-white mt-1"><%= fmtMoney(s.valor_total_ativo) %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Custo Mensal</p>
      <p class="text-lg font-bold text-gray-900 dark:text-white mt-1"><%= fmtMoney(s.valor_mensal_ativo) %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Vencendo em 30d</p>
      <p class="text-2xl font-bold <%= parseInt(s.vencendo_30||0) > 0 ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white' %> mt-1"><%= s.vencendo_30 || 0 %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-3 relative">
      <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Alertas</p>
      <p class="text-2xl font-bold <%= totalAl > 0 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-900 dark:text-white' %> mt-1"><%= totalAl %></p>
      <% if (totalAl > 0) { %>
        <span class="absolute top-2 right-2 w-2.5 h-2.5 bg-orange-500 rounded-full animate-pulse"></span>
      <% } %>
    </div>
  </div>

  <!-- Alertas (colapsável) -->
  <% if (totalAl > 0) { %>
  <details class="bg-orange-50 dark:bg-orange-900/10 border border-orange-200 dark:border-orange-800 rounded-lg overflow-hidden">
    <summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-orange-800 dark:text-orange-300 flex items-center gap-2 select-none">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      <%= totalAl %> alerta<%= totalAl > 1 ? 's' : '' %> — clique para expandir
    </summary>
    <div class="px-4 pb-4 space-y-2">
      <% if (al.vencendo && al.vencendo.length > 0) { al.vencendo.forEach(function(c) { %>
        <a href="/contratos/<%= c.id %>" class="block p-2 bg-white dark:bg-slate-800 rounded border border-orange-100 dark:border-slate-700 text-sm hover:shadow transition-shadow">
          <span class="font-semibold text-gray-900 dark:text-white"><%= c.codigo %></span> — <%= c.nome %>
          <span class="ml-2 text-xs px-2 py-0.5 rounded-full <%= c.dias_restantes <= 30 ? 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-300' %>">Vence em <%= c.dias_restantes %> dia<%= c.dias_restantes !== 1 ? 's' : '' %></span>
        </a>
      <% }); } %>
      <% if (al.obrigacoesAtrasadas && al.obrigacoesAtrasadas.length > 0) { al.obrigacoesAtrasadas.forEach(function(o) { %>
        <a href="/contratos/<%= o.contrato_id %>?aba=obrigacoes" class="block p-2 bg-white dark:bg-slate-800 rounded border border-red-100 dark:border-slate-700 text-sm hover:shadow transition-shadow">
          <span class="text-red-600 dark:text-red-400 font-semibold">Obrigação atrasada</span> — <%= o.contrato_codigo %>: <%= (o.descricao || '').slice(0, 60) %>
        </a>
      <% }); } %>
      <% if (al.slaFora && al.slaFora.length > 0) { al.slaFora.forEach(function(s) { %>
        <a href="/contratos/<%= s.contrato_id %>?aba=sla" class="block p-2 bg-white dark:bg-slate-800 rounded border border-purple-100 dark:border-slate-700 text-sm hover:shadow transition-shadow">
          <span class="text-purple-600 dark:text-purple-400 font-semibold">SLA fora</span> — <%= s.contrato_codigo %>: <%= s.nome_indicador %>
        </a>
      <% }); } %>
      <% if (al.reajustes && al.reajustes.length > 0) { al.reajustes.forEach(function(r) { %>
        <a href="/contratos/<%= r.id %>" class="block p-2 bg-white dark:bg-slate-800 rounded border border-blue-100 dark:border-slate-700 text-sm hover:shadow transition-shadow">
          <span class="text-blue-600 dark:text-blue-400 font-semibold">Reajuste próximo</span> — <%= r.codigo %>: <%= r.nome %> (<%= r.indice_reajuste %> em <%= fmtDate(r.data_proximo_reajuste) %>)
        </a>
      <% }); } %>
    </div>
  </details>
  <% } %>

  <!-- Filtros -->
  <form method="GET" action="/contratos" class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-3">
    <div class="flex flex-wrap gap-2 items-end">
      <div class="flex-1 min-w-[200px]">
        <input type="text" name="busca" value="<%= filtros.busca || '' %>" placeholder="Buscar por nome, código, empresa ou fornecedor..."
          class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
      </div>
      <select name="status" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
        <option value="">Todos os Status</option>
        <% Object.entries(statusLabels).forEach(function([k,v]) { %>
          <option value="<%= k %>" <%= filtros.status === k ? 'selected' : '' %>><%= v %></option>
        <% }); %>
      </select>
      <select name="tipo" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
        <option value="">Todos os Tipos</option>
        <% Object.entries(tipoLabels).forEach(function([k,v]) { %>
          <option value="<%= k %>" <%= filtros.tipo === k ? 'selected' : '' %>><%= v %></option>
        <% }); %>
      </select>
      <% if (departamentos && departamentos.length > 0) { %>
      <select name="departamento" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
        <option value="">Todos os Deptos</option>
        <% departamentos.forEach(function(d) { %>
          <option value="<%= d %>" <%= filtros.departamento === d ? 'selected' : '' %>><%= d %></option>
        <% }); %>
      </select>
      <% } %>
      <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">Filtrar</button>
      <% if (filtros.busca || filtros.status || filtros.tipo || filtros.departamento) { %>
        <a href="/contratos" class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 px-2 py-2">Limpar</a>
      <% } %>
    </div>
  </form>

  <!-- Lista de contratos -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <% if (!contratos || contratos.length === 0) { %>
      <div class="p-12 text-center text-gray-500 dark:text-gray-400">
        <svg class="w-12 h-12 mx-auto mb-3 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <p class="mb-2 font-medium">Nenhum contrato encontrado</p>
        <a href="/contratos/novo" class="text-cyan-600 dark:text-cyan-400 hover:underline font-medium text-sm">Cadastrar primeiro contrato</a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-600">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase">Código</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase">Contrato</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase hidden md:table-cell">Fornecedor / Empresa</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase hidden lg:table-cell">Tipo</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase hidden lg:table-cell">Valor</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase hidden md:table-cell">Vigência</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase">Status</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-600">
            <% contratos.forEach(function(c) {
              const fornNome = (c.fornecedor_fantasia || c.fornecedor_razao || c.empresa_contratada || '—');
              const diasRestantes = c.data_termino ? Math.ceil((new Date(c.data_termino) - new Date()) / (1000*60*60*24)) : null;
            %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors">
                <td class="px-4 py-3">
                  <a href="/contratos/<%= c.id %>" class="font-mono text-sm font-semibold text-cyan-600 dark:text-cyan-400 hover:underline"><%= c.codigo %></a>
                </td>
                <td class="px-4 py-3">
                  <a href="/contratos/<%= c.id %>" class="text-sm font-medium text-gray-900 dark:text-white hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"><%= c.nome.length > 40 ? c.nome.slice(0,40) + '…' : c.nome %></a>
                  <% if (c.responsavel_nome) { %>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= c.responsavel_nome %></p>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300 hidden md:table-cell"><%= fornNome.length > 30 ? fornNome.slice(0,30) + '…' : fornNome %></td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300 hidden lg:table-cell"><%= tipoLabels[c.tipo] || c.tipo %></td>
                <td class="px-4 py-3 text-sm text-right font-medium text-gray-900 dark:text-white hidden lg:table-cell"><%= c.valor_total ? fmtMoney(c.valor_total) : '—' %></td>
                <td class="px-4 py-3 text-center hidden md:table-cell">
                  <% if (c.data_inicio || c.data_termino) { %>
                    <span class="text-xs text-gray-600 dark:text-gray-300"><%= fmtDate(c.data_inicio) %> — <%= fmtDate(c.data_termino) %></span>
                    <% if (diasRestantes !== null && diasRestantes <= 90 && diasRestantes > 0 && c.status === 'ativo') { %>
                      <span class="block text-xs mt-0.5 <%= diasRestantes <= 30 ? 'text-red-600 dark:text-red-400 font-semibold' : 'text-orange-600 dark:text-orange-400' %>"><%= diasRestantes %>d restantes</span>
                    <% } %>
                  <% } else { %><span class="text-xs text-gray-400">—</span><% } %>
                </td>
                <td class="px-4 py-3 text-center">
                  <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded-full <%= statusColors[c.status] || 'bg-gray-100 text-gray-800' %>"><%= statusLabels[c.status] || c.status %></span>
                </td>
                <td class="px-4 py-3 text-right">
                  <a href="/contratos/<%= c.id %>" class="text-cyan-600 dark:text-cyan-400 hover:underline text-sm font-medium mr-2">Ver</a>
                  <a href="/contratos/<%= c.id %>/editar" class="text-gray-500 dark:text-gray-400 hover:underline text-sm font-medium">Editar</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-gray-100 dark:border-slate-700 text-sm text-gray-500 dark:text-gray-400">
        <%= contratos.length %> contrato<%= contratos.length !== 1 ? 's' : '' %> encontrado<%= contratos.length !== 1 ? 's' : '' %>
      </div>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(function() {
  var rawData = <%- jsonSeguro(cm) %>;
  var mesSel = '<%= mesSelecionado %>';

  if (!rawData || rawData.length === 0) {
    var el = document.getElementById('chartCustoMensal');
    if (el) el.parentElement.innerHTML = '<p class="text-sm text-gray-400 text-center py-10">Nenhum dado para o período selecionado.</p>';
    return;
  }

  var labels = rawData.map(function(d) { return d.label; });
  var valores = rawData.map(function(d) { return parseFloat(d.valor) || 0; });
  var anosMeses = rawData.map(function(d) { return d.ano_mes; });
  var qtds = rawData.map(function(d) { return parseInt(d.qtd_contratos) || 0; });

  var isDark = document.documentElement.classList.contains('dark');
  var gridColor = isDark ? 'rgba(148,163,184,0.15)' : 'rgba(0,0,0,0.06)';
  var textColor = isDark ? '#94a3b8' : '#6b7280';

  var bgColors = anosMeses.map(function(m) {
    if (mesSel && m === mesSel) return isDark ? 'rgba(6,182,212,0.9)' : 'rgba(8,145,178,0.85)';
    return isDark ? 'rgba(6,182,212,0.45)' : 'rgba(8,145,178,0.55)';
  });
  var hoverColors = anosMeses.map(function() {
    return isDark ? 'rgba(6,182,212,0.75)' : 'rgba(8,145,178,0.75)';
  });

  var ctx = document.getElementById('chartCustoMensal');
  if (!ctx) return;

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{
        label: 'Custo Mensal (R$)',
        data: valores,
        backgroundColor: bgColors,
        hoverBackgroundColor: hoverColors,
        borderRadius: 6,
        borderSkipped: false,
        maxBarThickness: 48
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { intersect: false, mode: 'index' },
      onClick: function(evt, elements) {
        if (elements.length > 0) {
          var idx = elements[0].index;
          var mes = anosMeses[idx];
          var url = new URL(window.location);
          if (url.searchParams.get('mes') === mes) {
            url.searchParams.delete('mes');
          } else {
            url.searchParams.set('mes', mes);
          }
          window.location.href = url.toString();
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: isDark ? '#1e293b' : '#fff',
          titleColor: isDark ? '#f1f5f9' : '#111827',
          bodyColor: isDark ? '#cbd5e1' : '#374151',
          borderColor: isDark ? '#334155' : '#e5e7eb',
          borderWidth: 1,
          padding: 12,
          cornerRadius: 8,
          displayColors: false,
          callbacks: {
            title: function(items) { return items[0].label; },
            label: function(item) {
              var val = item.raw || 0;
              var fmt = val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
              var q = qtds[item.dataIndex] || 0;
              return fmt + '  (' + q + ' contrato' + (q !== 1 ? 's' : '') + ')';
            },
            afterLabel: function() {
              return 'Clique para filtrar contratos deste mes';
            }
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: textColor, font: { size: 11, weight: '500' } }
        },
        y: {
          beginAtZero: true,
          grid: { color: gridColor },
          ticks: {
            color: textColor,
            font: { size: 11 },
            callback: function(v) {
              if (v >= 1000000) return 'R$ ' + (v / 1000000).toFixed(1) + 'M';
              if (v >= 1000) return 'R$ ' + (v / 1000).toFixed(0) + 'k';
              return 'R$ ' + v;
            }
          }
        }
      }
    }
  });

  var formGrafico = document.getElementById('formGrafico');
  if (formGrafico) {
    formGrafico.addEventListener('submit', function() {
      var inputs = this.querySelectorAll('input[type="month"]');
      for (var i = 0; i < inputs.length; i++) {
        if (inputs[i].value && inputs[i].value.length === 7) inputs[i].value = inputs[i].value + '-01';
      }
    });
  }
})();
</script>

