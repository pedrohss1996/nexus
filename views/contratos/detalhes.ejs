<%- include('../partials/header', { title: title, user: user }) %>
<%
  const c = contrato || {};
  const tipoLabels = typeof TIPO_LABELS !== 'undefined' ? TIPO_LABELS : {};
  const statusLabels = typeof STATUS_LABELS !== 'undefined' ? STATUS_LABELS : {};
  const statusColors = {
    ativo: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
    suspenso: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300',
    encerrado: 'bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
    em_renovacao: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300',
    cancelado: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300'
  };
  const abaAtual = typeof aba !== 'undefined' ? aba : 'resumo';
  const fin = typeof financeiro !== 'undefined' ? financeiro : {};
  const slaT = typeof slaTaxa !== 'undefined' ? slaTaxa : { total: 0, cumpridos: 0, taxa: 100 };
  function fmtMoney(v) { return Number(v||0).toLocaleString('pt-BR', {style:'currency',currency:'BRL'}); }
  function fmtDate(v) { if (!v) return '—'; const dt = new Date(v); return dt.toLocaleDateString('pt-BR'); }
  function fmtDateInput(v) { if (!v) return ''; const d = new Date(v); if (isNaN(d)) return ''; return d.toISOString().split('T')[0]; }
  function fmtDateTime(v) { if (!v) return '—'; const dt = new Date(v); return dt.toLocaleDateString('pt-BR') + ' ' + dt.toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'}); }
  const diasRestantes = c.data_termino ? Math.ceil((new Date(c.data_termino) - new Date()) / (1000*60*60*24)) : null;
  const pctExec = fin.valor_contratado > 0 ? Math.min(100, Math.round((fin.valor_executado / fin.valor_contratado) * 100)) : 0;
%>

<div class="w-full px-6 py-4 space-y-4">
  <!-- Breadcrumb + Ações -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <nav class="flex items-center text-sm text-gray-500 dark:text-gray-400">
      <a href="/contratos" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Contratos</a>
      <svg class="w-4 h-4 mx-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-900 dark:text-white font-medium"><%= c.codigo %></span>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/contratos/<%= c.id %>/editar" class="inline-flex items-center gap-1.5 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      </a>
      <% if (c.status !== 'cancelado' && c.status !== 'encerrado') { %>
      <a href="?cancelar=1&aba=<%= abaAtual %>" class="inline-flex items-center gap-1.5 bg-orange-50 dark:bg-orange-900/20 hover:bg-orange-100 dark:hover:bg-orange-900/40 text-orange-600 dark:text-orange-400 border border-orange-200 dark:border-orange-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors no-underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
        Cancelar Contrato
      </a>
      <% } %>
      <form action="/contratos/<%= c.id %>/excluir" method="POST" onsubmit="return confirm('Excluir este contrato permanentemente?');" class="inline">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="inline-flex items-center gap-1.5 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Excluir
        </button>
      </form>
    </div>
  </div>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="p-3 rounded-lg text-sm <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 text-red-700 dark:text-red-300' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 text-green-700 dark:text-green-300' %>"><%= flash.error || flash.success %></div>
  <% } %>

  <!-- Painel de Cancelamento (sem JavaScript) -->
  <% if (cancelar && c.status !== 'cancelado' && c.status !== 'encerrado') { %>
  <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-700 rounded-xl p-5 shadow-sm">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/40 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-orange-800 dark:text-orange-300">Cancelar Contrato</h3>
        <p class="text-sm text-orange-600 dark:text-orange-400"><%= c.codigo %> — <%= c.nome %></p>
      </div>
    </div>
    <form action="/contratos/<%= c.id %>/cancelar" method="POST" class="space-y-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="text-sm font-medium text-orange-800 dark:text-orange-300 mb-2">Selecione o motivo:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <% const motivos = ['Inadimplência da contratada','Descumprimento de cláusulas contratuais','Acordo mútuo entre as partes','Conveniência da administração','Término antecipado por necessidade','Falência ou recuperação judicial da contratada']; %>
        <% motivos.forEach(function(m) { %>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-orange-200 dark:border-orange-700 bg-white dark:bg-slate-800 cursor-pointer hover:bg-orange-50 dark:hover:bg-orange-900/30">
          <input type="radio" name="motivo_cancelamento" value="<%= m %>" required class="mt-0.5 accent-orange-600">
          <span class="text-sm text-gray-700 dark:text-gray-300"><%= m %></span>
        </label>
        <% }); %>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-orange-200 dark:border-orange-700 bg-white dark:bg-slate-800 cursor-pointer hover:bg-orange-50 dark:hover:bg-orange-900/30 sm:col-span-2">
          <input type="radio" name="motivo_cancelamento" value="outro" class="mt-0.5 accent-orange-600">
          <span class="text-sm text-gray-700 dark:text-gray-300">Outro motivo:</span>
          <input type="text" name="motivo_outro" placeholder="Descreva o motivo..." class="flex-1 ml-1 border-b border-orange-300 dark:border-orange-600 bg-transparent text-sm text-gray-900 dark:text-white outline-none focus:border-orange-500">
        </label>
      </div>
      <div class="flex items-center gap-2 pt-2">
        <button type="submit" class="bg-orange-600 hover:bg-orange-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition-colors">Confirmar Cancelamento</button>
        <a href="?aba=<%= abaAtual %>" class="px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 no-underline">Voltar</a>
      </div>
    </form>
  </div>
  <% } %>

  <!-- Header do contrato -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-5">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= c.nome %></h1>
          <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full <%= statusColors[c.status] || '' %>"><%= statusLabels[c.status] || c.status %></span>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-600 dark:text-gray-400">
          <span><strong>Código:</strong> <%= c.codigo %></span>
          <span><strong>Tipo:</strong> <%= tipoLabels[c.tipo] || c.tipo %></span>
          <% if (c.fornecedor_fantasia || c.fornecedor_nome) { %><span><strong>Fornecedor:</strong> <%= c.fornecedor_fantasia || c.fornecedor_nome %></span><% } %>
          <% if (c.empresa_contratada) { %><span><strong>Empresa:</strong> <%= c.empresa_contratada %></span><% } %>
          <% if (c.responsavel_nome) { %><span><strong>Responsável:</strong> <%= c.responsavel_nome %></span><% } %>
          <% if (c.departamento_responsavel) { %><span><strong>Depto:</strong> <%= c.departamento_responsavel %></span><% } %>
        </div>
      </div>
      <!-- Mini cards financeiros -->
      <div class="grid grid-cols-3 gap-3 text-center flex-shrink-0">
        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg px-3 py-2 min-w-[100px]">
          <p class="text-[10px] font-medium text-blue-600 dark:text-blue-400 uppercase">Contratado</p>
          <p class="text-sm font-bold text-blue-800 dark:text-blue-200"><%= fmtMoney(fin.valor_contratado) %></p>
        </div>
        <div class="bg-green-50 dark:bg-green-900/20 rounded-lg px-3 py-2 min-w-[100px]">
          <p class="text-[10px] font-medium text-green-600 dark:text-green-400 uppercase">Executado</p>
          <p class="text-sm font-bold text-green-800 dark:text-green-200"><%= fmtMoney(fin.valor_executado) %></p>
        </div>
        <div class="bg-gray-50 dark:bg-slate-700 rounded-lg px-3 py-2 min-w-[100px]">
          <p class="text-[10px] font-medium text-gray-500 dark:text-gray-400 uppercase">Restante</p>
          <p class="text-sm font-bold text-gray-800 dark:text-gray-200"><%= fmtMoney(fin.valor_restante) %></p>
        </div>
      </div>
    </div>
    <!-- Barra de execução -->
    <% if (fin.valor_contratado > 0) { %>
    <div class="mt-3">
      <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 mb-1">
        <span>Execução financeira</span>
        <span><%= pctExec %>%</span>
      </div>
      <div class="w-full bg-gray-200 dark:bg-slate-600 rounded-full h-2">
        <div class="h-2 rounded-full transition-all <%= pctExec >= 90 ? 'bg-red-500' : pctExec >= 70 ? 'bg-yellow-500' : 'bg-green-500' %>" style="width: <%= pctExec %>%"></div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Navegação por abas -->
  <div class="border-b border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 rounded-t-xl overflow-x-auto">
    <nav class="flex px-2">
      <% const abas = [
        { id: 'resumo', label: 'Resumo', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
        { id: 'obrigacoes', label: 'Obrigações', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
        { id: 'financeiro', label: 'Financeiro', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
        { id: 'sla', label: 'SLA', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
        { id: 'aditivos', label: 'Aditivos', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
        { id: 'anexos', label: 'Anexos', icon: 'M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13' },
        { id: 'auditoria', label: 'Histórico', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' }
      ]; %>
      <% abas.forEach(function(a) { %>
        <a href="?aba=<%= a.id %>"
          class="flex items-center gap-1.5 px-4 py-3 text-sm font-medium border-b-2 transition-colors whitespace-nowrap no-underline
          <%= abaAtual === a.id ? 'border-cyan-500 text-cyan-600 dark:text-cyan-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300' %>">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= a.icon %>"/></svg>
          <%= a.label %>
        </a>
      <% }); %>
    </nav>
  </div>

  <!-- Conteúdo das abas -->
  <div class="bg-white dark:bg-slate-800 rounded-b-xl border border-t-0 border-gray-200 dark:border-slate-700 shadow-sm">

    <!-- ABA: Resumo -->
    <div class="tab-content p-5 space-y-4" data-tab="resumo" style="<%= abaAtual !== 'resumo' ? 'display:none' : '' %>">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-3">
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Vigência</span><span class="text-gray-900 dark:text-white font-medium"><%= fmtDate(c.data_inicio) %> — <%= fmtDate(c.data_termino) %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Prazo</span><span class="text-gray-900 dark:text-white font-medium"><%= c.prazo_meses ? c.prazo_meses + ' meses' : '—' %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Valor Total</span><span class="text-gray-900 dark:text-white font-medium"><%= c.valor_total ? fmtMoney(c.valor_total) : '—' %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Valor Mensal</span><span class="text-gray-900 dark:text-white font-medium"><%= c.valor_mensal ? fmtMoney(c.valor_mensal) : '—' %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Moeda</span><span class="text-gray-900 dark:text-white font-medium"><%= c.moeda || '—' %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Forma Pagamento</span><span class="text-gray-900 dark:text-white font-medium"><%= c.forma_pagamento || '—' %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Índice Reajuste</span><span class="text-gray-900 dark:text-white font-medium"><%= c.indice_reajuste ? (c.indice_reajuste === 'OUTRO' ? c.indice_reajuste_outro : c.indice_reajuste) : '—' %></span></div>
            <div><span class="text-gray-500 dark:text-gray-400 block text-xs">Próx. Reajuste</span><span class="text-gray-900 dark:text-white font-medium"><%= fmtDate(c.data_proximo_reajuste) %></span></div>
          </div>
        </div>
        <div class="space-y-3">
          <% if (c.descricao) { %>
          <div>
            <span class="text-gray-500 dark:text-gray-400 text-xs block mb-1">Descrição</span>
            <p class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-line"><%= c.descricao %></p>
          </div>
          <% } %>
          <% if (c.status === 'cancelado') { %>
          <div class="p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800">
            <p class="text-sm font-semibold text-red-700 dark:text-red-300">Contrato Cancelado</p>
            <% if (c.motivo_cancelamento) { %><p class="text-sm text-red-600 dark:text-red-400 mt-1"><strong>Motivo:</strong> <%= c.motivo_cancelamento %></p><% } %>
            <% if (c.data_cancelamento) { %><p class="text-xs text-red-500 dark:text-red-400 mt-0.5">Em <%= fmtDateTime(c.data_cancelamento) %></p><% } %>
          </div>
          <% } %>
          <% if (diasRestantes !== null && c.status === 'ativo') { %>
          <div class="p-3 rounded-lg <%= diasRestantes <= 30 ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800' : diasRestantes <= 90 ? 'bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800' %>">
            <p class="text-sm font-semibold <%= diasRestantes <= 30 ? 'text-red-700 dark:text-red-300' : diasRestantes <= 90 ? 'text-yellow-700 dark:text-yellow-300' : 'text-green-700 dark:text-green-300' %>">
              <% if (diasRestantes <= 0) { %>Contrato vencido há <%= Math.abs(diasRestantes) %> dia(s)<% } else { %><%= diasRestantes %> dia(s) restante(s) de vigência<% } %>
            </p>
          </div>
          <% } %>
          <!-- SLA resumo -->
          <div class="flex items-center gap-3 p-3 bg-gray-50 dark:bg-slate-700/50 rounded-lg">
            <div class="w-12 h-12 rounded-full flex items-center justify-center text-sm font-bold
              <%= slaT.taxa >= 90 ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300' : slaT.taxa >= 70 ? 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-300' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' %>">
              <%= slaT.taxa %>%
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900 dark:text-white">Taxa de SLA</p>
              <p class="text-xs text-gray-500 dark:text-gray-400"><%= slaT.cumpridos %>/<%= slaT.total %> indicadores dentro da meta</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ABA: Obrigações -->
    <div class="tab-content p-5 space-y-4" data-tab="obrigacoes" style="<%= abaAtual !== 'obrigacoes' ? 'display:none' : '' %>">
      <details class="border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden">
        <summary class="flex items-center gap-2 px-4 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white cursor-pointer text-sm font-medium list-none select-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Nova Obrigação
        </summary>
        <form action="/contratos/<%= c.id %>/obrigacoes" method="POST" class="bg-gray-50 dark:bg-slate-700/50 p-4 space-y-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="sm:col-span-2"><textarea name="descricao" required placeholder="Descrição da obrigação" rows="2" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500"></textarea></div>
            <select name="responsavel_id" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"><option value="">Responsável...</option><% usuarios.forEach(function(u) { %><option value="<%= u.id %>"><%= u.nome %></option><% }); %></select>
            <input type="date" name="prazo" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <select name="frequencia" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"><option value="">Frequência...</option><option value="mensal">Mensal</option><option value="trimestral">Trimestral</option><option value="anual">Anual</option></select>
            <select name="status" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"><option value="pendente">Pendente</option><option value="concluido">Concluído</option><option value="atrasado">Atrasado</option></select>
          </div>
          <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Salvar Obrigação</button>
        </form>
      </details>
      <!-- Lista -->
      <% if (!obrigacoes || obrigacoes.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-6">Nenhuma obrigação cadastrada.</p>
      <% } else { %>
      <div class="space-y-2">
        <% obrigacoes.forEach(function(o) {
          const obgColor = o.status === 'concluido' ? 'border-l-green-500' : o.status === 'atrasado' ? 'border-l-red-500' : 'border-l-yellow-500';
          const obgBg = o.status === 'atrasado' ? 'bg-red-50 dark:bg-red-900/10' : '';
        %>
        <div class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 dark:border-slate-600 border-l-4 <%= obgColor %> <%= obgBg %>">
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-900 dark:text-white font-medium"><%= o.descricao %></p>
            <div class="flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-gray-500 dark:text-gray-400 mt-1">
              <% if (o.responsavel_nome) { %><span>Resp: <%= o.responsavel_nome %></span><% } %>
              <% if (o.prazo) { %><span>Prazo: <%= fmtDate(o.prazo) %></span><% } %>
              <% if (o.frequencia) { %><span>Freq: <%= o.frequencia %></span><% } %>
              <span class="font-semibold <%= o.status === 'concluido' ? 'text-green-600' : o.status === 'atrasado' ? 'text-red-600' : 'text-yellow-600' %>"><%= o.status %></span>
            </div>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <% if (o.status !== 'concluido') { %>
              <form action="/contratos/<%= c.id %>/obrigacoes/<%= o.id %>" method="POST" class="inline">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="descricao" value="<%= o.descricao %>"><input type="hidden" name="responsavel_id" value="<%= o.responsavel_id %>"><input type="hidden" name="prazo" value="<%= fmtDateInput(o.prazo) %>"><input type="hidden" name="frequencia" value="<%= o.frequencia %>"><input type="hidden" name="status" value="concluido">
                <button type="submit" class="p-1.5 text-green-600 hover:bg-green-50 dark:hover:bg-green-900/20 rounded" title="Marcar concluído"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></button>
              </form>
            <% } %>
            <form action="/contratos/<%= c.id %>/obrigacoes/<%= o.id %>/excluir" method="POST" class="inline" onsubmit="return confirm('Excluir esta obrigação?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="p-1.5 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded" title="Excluir"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
            </form>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- ABA: Financeiro -->
    <div class="tab-content p-5 space-y-4" data-tab="financeiro" style="<%= abaAtual !== 'financeiro' ? 'display:none' : '' %>">
      <details class="border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden">
        <summary class="flex items-center gap-2 px-4 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white cursor-pointer text-sm font-medium list-none select-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Registrar Pagamento
        </summary>
        <form action="/contratos/<%= c.id %>/pagamentos" method="POST" class="bg-gray-50 dark:bg-slate-700/50 p-4 space-y-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <input type="date" name="data_pagamento" required class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="number" step="0.01" name="valor_pago" required placeholder="Valor pago (R$)" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="text" name="numero_nota" placeholder="Nº nota fiscal" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <select name="status" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"><option value="pago">Pago</option><option value="pendente">Pendente</option><option value="atrasado">Atrasado</option><option value="cancelado">Cancelado</option></select>
          </div>
          <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Salvar Pagamento</button>
        </form>
      </details>
      <% if (!pagamentos || pagamentos.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-6">Nenhum pagamento registrado.</p>
      <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead><tr class="border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <th class="text-left py-2 px-2">Data</th><th class="text-right py-2 px-2">Valor</th><th class="text-left py-2 px-2">NF</th><th class="text-center py-2 px-2">Status</th><th class="text-right py-2 px-2"></th>
          </tr></thead>
          <tbody>
            <% pagamentos.forEach(function(p) { %>
            <tr class="border-b border-gray-100 dark:border-slate-700">
              <td class="py-2 px-2 text-gray-900 dark:text-white"><%= fmtDate(p.data_pagamento) %></td>
              <td class="py-2 px-2 text-right font-medium text-gray-900 dark:text-white"><%= fmtMoney(p.valor_pago) %></td>
              <td class="py-2 px-2 text-gray-600 dark:text-gray-400"><%= p.numero_nota || '—' %></td>
              <td class="py-2 px-2 text-center"><span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= p.status === 'pago' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300' : p.status === 'atrasado' ? 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300' %>"><%= p.status %></span></td>
              <td class="py-2 px-2 text-right"><form action="/contratos/<%= c.id %>/pagamentos/<%= p.id %>/excluir" method="POST" class="inline" onsubmit="return confirm('Excluir?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="text-red-500 hover:text-red-700 text-xs">Excluir</button></form></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- ABA: SLA -->
    <div class="tab-content p-5 space-y-4" data-tab="sla" style="<%= abaAtual !== 'sla' ? 'display:none' : '' %>">
      <div class="flex items-center gap-3 mb-1">
        <h3 class="font-semibold text-gray-900 dark:text-white text-sm">Indicadores de SLA</h3>
        <span class="px-2 py-0.5 rounded-full text-xs font-bold <%= slaT.taxa >= 90 ? 'bg-green-100 text-green-700' : slaT.taxa >= 70 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700' %>"><%= slaT.taxa %>% cumprido</span>
      </div>
      <details class="border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden">
        <summary class="flex items-center gap-2 px-4 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white cursor-pointer text-sm font-medium list-none select-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Nova Medição de SLA
        </summary>
        <form action="/contratos/<%= c.id %>/slas" method="POST" class="bg-gray-50 dark:bg-slate-700/50 p-4 space-y-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <input type="text" name="nome_indicador" required placeholder="Nome do indicador" class="sm:col-span-2 rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="number" step="0.01" name="meta" placeholder="Meta" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="number" step="0.01" name="valor_medido" placeholder="Valor medido" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="date" name="data_medicao" required class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <select name="status" required class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"><option value="dentro">Dentro do SLA</option><option value="fora">Fora do SLA</option></select>
          </div>
          <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Salvar Medição</button>
        </form>
      </details>
      <% if (!slas || slas.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-6">Nenhuma medição de SLA registrada.</p>
      <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead><tr class="border-b border-gray-200 dark:border-slate-600 text-xs text-gray-500 dark:text-gray-400 uppercase">
            <th class="text-left py-2 px-2">Indicador</th><th class="text-right py-2 px-2">Meta</th><th class="text-right py-2 px-2">Medido</th><th class="text-center py-2 px-2">Data</th><th class="text-center py-2 px-2">Status</th><th class="text-right py-2 px-2"></th>
          </tr></thead>
          <tbody>
            <% slas.forEach(function(s) { %>
            <tr class="border-b border-gray-100 dark:border-slate-700">
              <td class="py-2 px-2 text-gray-900 dark:text-white font-medium"><%= s.nome_indicador %></td>
              <td class="py-2 px-2 text-right text-gray-600 dark:text-gray-400"><%= s.meta != null ? s.meta : '—' %></td>
              <td class="py-2 px-2 text-right text-gray-900 dark:text-white font-medium"><%= s.valor_medido != null ? s.valor_medido : '—' %></td>
              <td class="py-2 px-2 text-center text-gray-600 dark:text-gray-400"><%= fmtDate(s.data_medicao) %></td>
              <td class="py-2 px-2 text-center"><span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= s.status === 'dentro' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300' %>"><%= s.status === 'dentro' ? 'Dentro' : 'Fora' %></span></td>
              <td class="py-2 px-2 text-right"><form action="/contratos/<%= c.id %>/slas/<%= s.id %>/excluir" method="POST" class="inline" onsubmit="return confirm('Excluir?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="text-red-500 hover:text-red-700 text-xs">Excluir</button></form></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- ABA: Aditivos -->
    <div class="tab-content p-5 space-y-4" data-tab="aditivos" style="<%= abaAtual !== 'aditivos' ? 'display:none' : '' %>">
      <details class="border border-gray-200 dark:border-slate-600 rounded-lg overflow-hidden">
        <summary class="flex items-center gap-2 px-4 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white cursor-pointer text-sm font-medium list-none select-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Novo Aditivo
        </summary>
        <form action="/contratos/<%= c.id %>/aditivos" method="POST" class="bg-gray-50 dark:bg-slate-700/50 p-4 space-y-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <select name="tipo" required class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"><option value="">Tipo...</option><option value="prorrogacao">Prorrogação</option><option value="alteracao_valor">Alteração de Valor</option><option value="alteracao_escopo">Alteração de Escopo</option></select>
            <input type="date" name="data_aditivo" required class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="number" step="0.01" name="novo_valor" placeholder="Novo valor (R$)" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
            <input type="date" name="nova_data_termino" class="rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm">
          </div>
          <textarea name="descricao" rows="2" placeholder="Descrição da alteração" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm"></textarea>
          <button type="submit" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Salvar Aditivo</button>
        </form>
      </details>
      <% if (!aditivos || aditivos.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-6">Nenhum aditivo registrado.</p>
      <% } else { %>
      <div class="space-y-2">
        <% aditivos.forEach(function(a) { const tipoAd = { prorrogacao: 'Prorrogação', alteracao_valor: 'Alteração de Valor', alteracao_escopo: 'Alteração de Escopo' }; %>
        <div class="p-3 rounded-lg border border-gray-200 dark:border-slate-600 flex items-start justify-between gap-3">
          <div>
            <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 mr-2"><%= tipoAd[a.tipo] || a.tipo %></span>
            <span class="text-xs text-gray-500 dark:text-gray-400"><%= fmtDate(a.data_aditivo) %></span>
            <% if (a.novo_valor) { %><span class="ml-2 text-xs text-gray-600 dark:text-gray-300">Novo valor: <strong><%= fmtMoney(a.novo_valor) %></strong></span><% } %>
            <% if (a.nova_data_termino) { %><span class="ml-2 text-xs text-gray-600 dark:text-gray-300">Novo término: <strong><%= fmtDate(a.nova_data_termino) %></strong></span><% } %>
            <% if (a.descricao) { %><p class="text-sm text-gray-700 dark:text-gray-300 mt-1"><%= a.descricao %></p><% } %>
          </div>
          <form action="/contratos/<%= c.id %>/aditivos/<%= a.id %>/excluir" method="POST" class="flex-shrink-0" onsubmit="return confirm('Excluir?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="p-1 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button></form>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- ABA: Anexos -->
    <div class="tab-content p-5 space-y-4" data-tab="anexos" style="<%= abaAtual !== 'anexos' ? 'display:none' : '' %>">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold text-gray-900 dark:text-white text-sm">Documentos e Anexos</h3>
      </div>
      <form action="/contratos/<%= c.id %>/anexos?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-4 border border-gray-200 dark:border-slate-600">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-2">Enviar arquivo (PDF, DOC, XLS, imagens, ZIP — até 25 MB)</label>
        <div class="flex gap-2">
          <input type="file" name="anexo" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.webp,.zip" required class="block w-full text-sm text-gray-600 dark:text-gray-400 file:mr-2 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-cyan-50 file:text-cyan-700 dark:file:bg-cyan-900/30 dark:file:text-cyan-300 file:text-sm file:font-medium">
          <button type="submit" class="flex-shrink-0 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">Anexar</button>
        </div>
      </form>
      <% if (!anexos || anexos.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-4">Nenhum anexo.</p>
      <% } else { %>
      <ul class="space-y-2">
        <% anexos.forEach(function(a) { %>
        <li class="flex items-center justify-between gap-3 p-3 rounded-lg bg-gray-50 dark:bg-slate-700/50 border border-gray-200 dark:border-slate-600">
          <div class="flex items-center gap-2 min-w-0 flex-1">
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
            <a href="/<%= a.caminho %>" target="_blank" class="text-cyan-600 dark:text-cyan-400 hover:underline text-sm truncate" title="<%= a.nome_original %>"><%= a.nome_original || a.nome_arquivo %></a>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0 text-xs text-gray-500 dark:text-gray-400">
            <% if (a.criador_nome) { %><span><%= a.criador_nome %></span><% } %>
            <span><%= fmtDate(a.criado_em) %></span>
            <form action="/contratos/<%= c.id %>/anexos/<%= a.id %>/excluir" method="POST" onsubmit="return confirm('Excluir este anexo?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="p-1 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button></form>
          </div>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>

    <!-- ABA: Auditoria -->
    <div class="tab-content p-5 space-y-4" data-tab="auditoria" style="<%= abaAtual !== 'auditoria' ? 'display:none' : '' %>">
      <h3 class="font-semibold text-gray-900 dark:text-white text-sm">Histórico de Alterações</h3>
      <% if (!auditoria || auditoria.length === 0) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-6">Nenhuma alteração registrada.</p>
      <% } else { %>
      <div class="space-y-2">
        <% auditoria.forEach(function(a) { %>
        <div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-slate-700/50 border border-gray-100 dark:border-slate-600">
          <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-slate-600 flex items-center justify-center text-xs font-bold text-gray-600 dark:text-gray-300 flex-shrink-0"><%= (a.usuario_nome || '?').charAt(0).toUpperCase() %></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-900 dark:text-white"><strong><%= a.usuario_nome || 'Sistema' %></strong> alterou <span class="font-mono text-xs bg-gray-100 dark:bg-slate-600 px-1.5 py-0.5 rounded"><%= a.campo %></span></p>
            <% if (a.valor_anterior || a.valor_novo) { %>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
              <% if (a.valor_anterior) { %><span class="line-through text-red-500"><%= (a.valor_anterior || '').slice(0, 60) %></span> → <% } %>
              <span class="text-green-600 dark:text-green-400"><%= (a.valor_novo || '').slice(0, 60) %></span>
            </div>
            <% } %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5"><%= fmtDateTime(a.criado_em) %></p>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>

  </div>
</div>

<!-- Modal Cancelar Contrato -->
<div id="modalCancelar" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="toggleModal('modalCancelar', false)"></div>
  <div class="relative bg-white dark:bg-slate-800 rounded-xl shadow-2xl w-full max-w-md border border-gray-200 dark:border-slate-700 p-6 space-y-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
        <svg class="w-5 h-5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Cancelar Contrato</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= c.codigo %> — <%= c.nome %></p>
      </div>
    </div>

    <form action="/contratos/<%= c.id %>/cancelar" method="POST" id="formCancelar">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-3">Selecione o motivo do cancelamento:</p>
      <div class="space-y-2">
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="Inadimplência da contratada" class="mt-0.5 text-orange-600 focus:ring-orange-500" required>
          <span class="text-sm text-gray-700 dark:text-gray-300">Inadimplência da contratada</span>
        </label>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="Descumprimento de cláusulas contratuais" class="mt-0.5 text-orange-600 focus:ring-orange-500">
          <span class="text-sm text-gray-700 dark:text-gray-300">Descumprimento de cláusulas contratuais</span>
        </label>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="Acordo mútuo entre as partes" class="mt-0.5 text-orange-600 focus:ring-orange-500">
          <span class="text-sm text-gray-700 dark:text-gray-300">Acordo mútuo entre as partes</span>
        </label>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="Conveniência da administração" class="mt-0.5 text-orange-600 focus:ring-orange-500">
          <span class="text-sm text-gray-700 dark:text-gray-300">Conveniência da administração</span>
        </label>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="Término antecipado por necessidade" class="mt-0.5 text-orange-600 focus:ring-orange-500">
          <span class="text-sm text-gray-700 dark:text-gray-300">Término antecipado por necessidade</span>
        </label>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="Falência ou recuperação judicial da contratada" class="mt-0.5 text-orange-600 focus:ring-orange-500">
          <span class="text-sm text-gray-700 dark:text-gray-300">Falência ou recuperação judicial da contratada</span>
        </label>
        <label class="flex items-start gap-2 p-2.5 rounded-lg border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer transition-colors">
          <input type="radio" name="motivo_cancelamento" value="outro" id="radioCancelOutro" class="mt-0.5 text-orange-600 focus:ring-orange-500">
          <span class="text-sm text-gray-700 dark:text-gray-300">Outro motivo</span>
        </label>
      </div>
      <textarea name="motivo_outro" id="campoMotivoOutro" rows="2" placeholder="Descreva o motivo..." class="hidden mt-2 w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500"></textarea>

      <div class="flex items-center justify-end gap-2 mt-4 pt-4 border-t border-gray-200 dark:border-slate-700">
        <button type="button" onclick="toggleModal('modalCancelar', false)" class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 rounded-lg transition-colors">Voltar</button>
        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-orange-600 hover:bg-orange-700 rounded-lg transition-colors">Confirmar Cancelamento</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
