<% const formatBrLocal = (typeof formatBrFn !== 'undefined') ? formatBrFn : (v) => (typeof v === 'number' ? v : parseFloat(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<% const valor = parseFloat(conta.valor) || 0; %>
<% const disponivel = parseFloat(conta.disponivel) || 0; %>
<% const usado = valor - disponivel; %>
<% const percentual = valor > 0 ? Math.round((usado / valor) * 100) : 0; %>
<% const subcontas = (conta.children && conta.children.length) || 0; %>
<% const corPct = percentual >= 90 ? 'text-amber-600 dark:text-amber-400' : 'text-green-600 dark:text-green-400'; %>
<% const marginLeft = (typeof depth !== 'undefined' ? depth : 0) * 8; %>
<details class="border border-gray-200 dark:border-slate-600 rounded py-1 px-2 hover:border-cyan-500 dark:hover:border-cyan-500 transition-colors group" style="margin-left: <%= marginLeft %>px">
  <summary class="flex items-center justify-between gap-1 cursor-pointer list-none text-[10px]">
    <span class="flex items-center gap-1 min-w-0 flex-1">
      <svg class="w-3 h-3 text-slate-400 group-open:rotate-90 flex-shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      <span class="font-mono text-slate-600 dark:text-slate-300 flex-shrink-0"><%= conta.codigo %></span>
      <span class="font-medium text-gray-900 dark:text-white truncate"><%= conta.nome %></span>
      <% if (subcontas > 0) { %>
        <span class="text-[10px] px-1.5 py-0 rounded bg-slate-100 dark:bg-slate-700 text-slate-500 flex-shrink-0"><%= subcontas %> sub</span>
      <% } %>
    </span>
    <span class="flex items-center gap-1.5 flex-shrink-0">
      <span class="font-semibold text-gray-900 dark:text-white">R$ <%= formatBrLocal(valor) %></span>
      <span class="<%= corPct %>"><%= percentual %>%</span>
    </span>
  </summary>
  <div class="mt-1 pt-1 border-t border-slate-200 dark:border-slate-600 space-y-0.5">
    <% if (subcontas > 0) { %>
      <% conta.children.forEach(function (c) { %>
        <%- include('detalhamento-orcamento-item', { conta: c, depth: (typeof depth !== 'undefined' ? depth : 0) + 1, formatBrFn: formatBrLocal }) %>
      <% }); %>
    <% } else { %>
      <p class="text-[10px] text-slate-400 py-0.5 px-2 ml-2">Nenhuma subconta</p>
    <% } %>
  </div>
</details>
