<%#
  Escolha de acesso: unidades em blocos, grupos como botões de opção.
  Parâmetros: unidadesAcesso ([{ id, nome, grupos: [{ id, nome }] }]), selecionado (id do grupo), obrigatorio (bool)
%>
<% var _sel = typeof selecionado !== 'undefined' && selecionado != null ? String(selecionado) : ''; %>
<fieldset class="seletor-acesso">
  <legend class="mb-2 block text-sm font-medium text-ink">Unidade e grupo</legend>
  <div class="grid gap-2 sm:grid-cols-2">
    <% unidadesAcesso.forEach(function (un) { %>
      <div class="rounded-lg border border-line bg-raised px-3 py-2.5">
        <p class="mb-2 truncate text-sm font-medium text-ink" title="<%= un.nome %>"><%= un.nome %><% if (un.acessoTotal) { %> <span class="font-normal text-muted">· acessa todas as unidades</span><% } %></p>
        <div class="flex flex-wrap gap-1.5">
          <% un.grupos.forEach(function (g) {
               // Sem escolha prévia, nada vem marcado: evita dar acesso (ex.: à
               // unidade administradora, que abre todas) sem a pessoa decidir
               var marcado = _sel !== '' && _sel === String(g.id); %>
            <label class="cursor-pointer">
              <input type="radio" name="grupo_id" value="<%= g.id %>" class="peer sr-only" <%= marcado ? 'checked' : '' %> <%= (typeof obrigatorio === 'undefined' || obrigatorio) ? 'required' : '' %>>
              <span class="chip-opcao"><%= g.nome %></span>
            </label>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
</fieldset>
