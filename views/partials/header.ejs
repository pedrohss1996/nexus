        { href: '/protocolo', label: 'Protocolos', icone: 'protocolo', match: ['/protocolo'] },
        { href: '/tramitacao', label: 'Tramitações', icone: 'tramitacao', match: ['/tramitacao'] },
        { href: '/contratos', label: 'Contratos', icone: 'contratos', match: ['/contratos'] },
        { href: '/centros-custo', label: 'Centros de custo', icone: 'centros', match: ['/centros-custo'] },
        { href: '/fornecedores', label: 'Fornecedores', icone: 'fornecedores', match: ['/fornecedores'] }
      ]},
