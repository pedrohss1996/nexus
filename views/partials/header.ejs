          <script>
            // Dropdown de Cadastros - Sobreposto (Overlay)
            (function() {
              const btn = document.getElementById('cadastrosBtn');
              const dropdown = document.getElementById('cadastrosDropdown');
              const arrow = document.getElementById('cadastrosArrow');
              
              function positionDropdown() {
                if (!btn || !dropdown) return;
                
                const btnRect = btn.getBoundingClientRect();
                const scrollY = window.scrollY || window.pageYOffset;
                const scrollX = window.scrollX || window.pageXOffset;
                
                // Posicionar abaixo do botão
                dropdown.style.top = (btnRect.bottom + scrollY + 4) + 'px';
                dropdown.style.left = (btnRect.left + scrollX) + 'px';
              }
              
              if (btn && dropdown) {
                // Abrir/fechar dropdown
                btn.addEventListener('click', (e) => {
                  e.stopPropagation();
                  const isHidden = dropdown.classList.contains('hidden');
                  
                  if (isHidden) {
                    positionDropdown();
                    dropdown.classList.remove('hidden');
                    arrow?.classList.add('rotate-180');
                  } else {
                    dropdown.classList.add('hidden');
                    arrow?.classList.remove('rotate-180');
                  }
                });
                
                // Reposicionar ao redimensionar ou rolar
                window.addEventListener('resize', () => {
                  if (!dropdown.classList.contains('hidden')) {
                    positionDropdown();
                  }
                });
                
                window.addEventListener('scroll', () => {
                  if (!dropdown.classList.contains('hidden')) {
                    positionDropdown();
                  }
                }, true);
                
                // Fechar ao clicar fora
                document.addEventListener('click', (e) => {
                  if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.add('hidden');
                    arrow?.classList.remove('rotate-180');
                  }
                });
                
                // Prevenir fechar ao clicar nos links
                dropdown.addEventListener('click', (e) => {
                  e.stopPropagation();
                });
              }
            })();
          </script>
          <script>
            (function() {
              var path = window.location.pathname || '';
              document.querySelectorAll('.nav-link[data-nav]').forEach(function(el) {
                el.classList.remove('nav-link-active');
                var nav = el.getAttribute('data-nav');
                var active = (nav === 'inicio' && (path === '/inicio' || path === '/')) ||
                  (nav === 'processos' && path.indexOf('/processos') === 0) ||
                  (nav === 'documentos' && path.indexOf('/documentos-pdf') === 0) ||
                  (nav === 'contratos' && path.indexOf('/contratos') === 0) ||
                  (nav === 'fluxos' && path.indexOf('/fluxos') === 0) ||
                  (nav === 'assinaturas' && path.indexOf('/assinaturas') === 0) ||
                  (nav === 'verificar' && path.indexOf('/verificar') === 0) ||
                  (nav === 'notificacoes-admin' && path.indexOf('/notificacoes') === 0) ||
                  (nav === 'centros-custo' && path.indexOf('/centros-custo') === 0) ||
                  (nav === 'cadastros' && (path.indexOf('/cadastros') === 0 || path.indexOf('/grupos') === 0 || path.indexOf('/unidades') === 0 || path.indexOf('/fornecedores') === 0));
                if (active) el.classList.add('nav-link-active');
              });
            })();
          </script>
        </div>
      </div>
    </nav>
