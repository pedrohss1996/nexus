  <!-- Barra do celular: nome do produto, menu e notificações -->
  <header class="shell-topbar lg:hidden">
    <button type="button" id="navOpen" class="shell-icon-btn" aria-controls="sidebar" aria-expanded="false" aria-label="Abrir menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a href="/inicio" class="flex items-center gap-2 min-w-0" aria-label="Nexus — início">
      <img src="/imgs/favicon.png" alt="" class="h-6 w-6">
      <span class="text-base font-semibold tracking-tight text-ink">Nexus</span>
    </a>
    <a href="/notificacoes" class="shell-icon-btn relative" aria-label="Notificações">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      <span class="notif-badge hidden"></span>
    </a>
  </header>

  <!-- Menu lateral (no celular vira uma folha em tela cheia) -->
  <aside id="sidebar" class="shell-sidebar" aria-label="Navegação principal">
    <div class="flex items-center justify-between px-4 pt-4 pb-3">
      <a href="/inicio" class="flex items-center gap-2" aria-label="Nexus — início">
        <img src="/imgs/favicon.png" alt="" class="h-7 w-7">
        <span class="text-[17px] font-semibold tracking-tight text-ink">Nexus</span>
      </a>
      <button type="button" id="navClose" class="shell-icon-btn lg:hidden" aria-label="Fechar menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <!-- Unidade em que se está trabalhando -->
    <form action="/api/selecionar-unidade" method="POST" id="formUnidade" class="px-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="seletorUnidade" class="block px-1 pb-1 text-xs text-muted">Unidade</label>
      <select name="unidade_id" id="seletorUnidade" class="shell-select" <%= (typeof unidades === 'undefined' || !unidades.length) ? 'disabled' : '' %>>
        <% if (typeof unidades !== 'undefined' && unidades.length > 0) { %>
          <% unidades.forEach(function (unidade) { %>
            <option value="<%= unidade.id %>" <%= unidadeSelecionada == unidade.id ? 'selected' : '' %>><%= unidade.nome %></option>
          <% }); %>
        <% } else { %>
          <option value="">Nenhuma unidade vinculada</option>
        <% } %>
      </select>
      <noscript><button type="submit" class="btn btn-secondary mt-2 w-full">Trocar unidade</button></noscript>
    </form>

    <div class="px-3 pt-3">
      <a href="/processos/novo" class="btn btn-primary w-full">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
        Novo processo
      </a>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 pb-4">
      <% grupos.forEach(function (g) { %>
        <% if (g.titulo) { %><p class="shell-group"><%= g.titulo %></p><% } else { %><div class="h-4"></div><% } %>
        <ul class="space-y-0.5">
          <% g.itens.forEach(function (it) { %>
            <li>
              <a href="<%= it.href %>" class="shell-link" data-match="<%= it.match.join(',') %>" data-exceto="<%= (it.exceto || []).join(',') %>">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icones[it.icone] %>"/></svg>
                <span><%= it.label %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      <% }); %>
    </nav>

    <!-- Utilitários e conta, no pé do menu -->
    <div class="px-3 py-3 border-t border-line space-y-0.5">
      <a href="/notificacoes" class="shell-link" data-match="/notificacoes" data-exceto="/notificacoes/admin">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span class="flex-1">Notificações</span>
        <span class="notif-count hidden"></span>
      </a>
      <a href="/verificar" class="shell-link" data-match="/verificar">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icones.verificar %>"/></svg>
        <span>Verificar assinatura</span>
      </a>
      <div class="relative pt-1">
        <button type="button" id="userMenuBtn" class="flex w-full items-center gap-3 rounded-md px-2 py-2 text-left hover:bg-active" aria-expanded="false" aria-haspopup="true" aria-controls="userMenuDropdown">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-50 text-sm font-semibold text-primary-700 dark:bg-neutral-800 dark:text-primary-300"><%= inicial %></span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium text-ink"><%= user.nome %></span>
            <span class="block truncate text-xs text-muted capitalize"><%= user.perfil %></span>
          </span>
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
        </button>
        <div id="userMenuDropdown" class="shell-menu hidden" role="menu">
          <a href="/cadastros/usuarios/<%= user.id %>/editar" role="menuitem">Meus dados</a>
          <a href="/cadastros/usuarios/<%= user.id %>/alterar-senha" role="menuitem">Alterar senha</a>
          <button type="button" id="themeToggle" role="menuitem">
            <span class="dark:hidden">Usar tema escuro</span><span class="hidden dark:inline">Usar tema claro</span>
          </button>
          <a href="/auth/logout" role="menuitem" class="text-negative">Sair</a>
        </div>
      </div>
    </div>
  </aside>
  <div id="navScrim" class="fixed inset-0 z-40 hidden bg-black/40 lg:hidden" aria-hidden="true"></div>

  <script>
    (function () {
      // Item ativo pelo caminho atual
      var path = window.location.pathname || '';
      document.querySelectorAll('.shell-link[data-match]').forEach(function (el) {
        var match = (el.getAttribute('data-match') || '').split(',').filter(Boolean);
        var exceto = (el.getAttribute('data-exceto') || '').split(',').filter(Boolean);
        var ativo = match.some(function (m) { return path === m || path.indexOf(m + '/') === 0; }) &&
                    !exceto.some(function (m) { return path === m || path.indexOf(m + '/') === 0; });
        if (ativo) { el.classList.add('is-active'); el.setAttribute('aria-current', 'page'); }
      });

      // Trocar unidade
      document.getElementById('seletorUnidade')?.addEventListener('change', function () {
        document.getElementById('formUnidade').submit();
      });

      // Menu do celular
      var sidebar = document.getElementById('sidebar');
      var scrim = document.getElementById('navScrim');
      var abrir = document.getElementById('navOpen');
      function setNav(aberto) {
        sidebar.classList.toggle('is-open', aberto);
        scrim.classList.toggle('hidden', !aberto);
        abrir && abrir.setAttribute('aria-expanded', aberto ? 'true' : 'false');
        document.body.style.overflow = aberto ? 'hidden' : '';
      }
      abrir?.addEventListener('click', function () { setNav(true); });
      document.getElementById('navClose')?.addEventListener('click', function () { setNav(false); });
      scrim?.addEventListener('click', function () { setNav(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setNav(false); });

      // Menu da conta
      var btn = document.getElementById('userMenuBtn');
      var menu = document.getElementById('userMenuDropdown');
      btn?.addEventListener('click', function (e) {
        e.stopPropagation();
        var abre = menu.classList.contains('hidden');
        menu.classList.toggle('hidden', !abre);
        btn.setAttribute('aria-expanded', abre ? 'true' : 'false');
      });
      document.addEventListener('click', function (e) {
        if (menu && !menu.contains(e.target) && !btn.contains(e.target)) {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });

      // Tema
      document.getElementById('themeToggle')?.addEventListener('click', function () {
        var escuro = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', escuro);
        try { localStorage.setItem('theme', escuro ? 'dark' : 'light'); } catch (e) {}
      });

      // Notificações não lidas: badge no celular, contagem no menu
      function atualizarBadge() {
        fetch('/api/notificacoes/nao-lidas', { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var total = d.total || 0;
            var txt = total > 99 ? '99+' : String(total);
            document.querySelectorAll('.notif-badge, .notif-count').forEach(function (b) {
              b.textContent = txt;
              b.classList.toggle('hidden', total === 0);
            });
          }).catch(function () {});
      }
      atualizarBadge();
      setInterval(atualizarBadge, 60000);
    })();
  </script>
  <% } %>

  <main id="mainContent" class="<%= (typeof user !== 'undefined' && user) ? 'shell-main' : '' %>">
