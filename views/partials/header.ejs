<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%= typeof title !== 'undefined' ? title : 'DataFlow' %></title>
  <link href="/css/output.css" rel="stylesheet">
</head>
<body class="bg-gray-50 antialiased">
  <% if (typeof user !== 'undefined' && user) { %>
    <!-- Header -->
    <header class="bg-white dark:bg-slate-900 shadow-sm border-b border-gray-200 dark:border-slate-700 sticky top-0 z-50 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Logo -->
          <div class="flex items-center">
            <h1 class="text-2xl font-bold bg-gradient-to-r from-primary-600 to-primary-700 dark:from-cyan-400 dark:to-teal-400 bg-clip-text text-transparent">DataFlow</h1>
          </div>

          <!-- Seletor de Unidade -->
          <div class="hidden md:flex items-center space-x-4">
            <form action="/api/selecionar-unidade" method="POST" id="formUnidade">
              <select name="unidade_id" id="seletorUnidade" class="border border-gray-300 dark:border-slate-600 rounded-lg px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-100 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-primary-500 dark:focus:ring-cyan-500 focus:border-primary-500 dark:focus:border-cyan-500 transition-all cursor-pointer">
                <% if (typeof unidades !== 'undefined' && unidades.length > 0) { %>
                  <% unidades.forEach(unidade => { %>
                    <option value="<%= unidade.id %>" <%= unidadeSelecionada == unidade.id ? 'selected' : '' %>>
                      <%= unidade.nome %>
                    </option>
                  <% }); %>
                <% } else { %>
                  <option value="">Nenhuma unidade disponível</option>
                <% } %>
              </select>
            </form>
          </div>
          <script>
            // Auto-submit ao mudar unidade
            document.getElementById('seletorUnidade')?.addEventListener('change', function() {
              document.getElementById('formUnidade').submit();
            });
          </script>

          <!-- User Menu -->
          <div class="flex items-center space-x-3">
            <!-- Notificações -->
            <div class="relative">
              <button class="p-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors relative">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <span class="absolute top-1 right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-semibold">3</span>
              </button>
            </div>

            <!-- Dark Mode Toggle -->
            <button id="themeToggle" class="p-2 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors" title="Alternar tema">
              <!-- Ícone Sol (Light Mode) -->
              <svg id="sunIcon" class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <!-- Ícone Lua (Dark Mode) -->
              <svg id="moonIcon" class="w-6 h-6 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
            </button>

            <!-- Perfil e Logout -->
            <div class="flex items-center space-x-3 pl-3 border-l border-gray-200 dark:border-slate-700">
              <div class="w-10 h-10 bg-gradient-to-br from-primary-500 to-primary-600 dark:from-cyan-500 dark:to-teal-500 rounded-full flex items-center justify-center text-white font-semibold text-sm shadow-sm">
                <%= user.nome.charAt(0).toUpperCase() %>
              </div>
              <div class="hidden lg:block">
                <p class="text-sm font-medium text-gray-700 dark:text-gray-100"><%= user.nome %></p>
                <p class="text-xs text-gray-500 dark:text-gray-400 capitalize"><%= user.perfil %></p>
              </div>
              <a href="/auth/logout" class="p-2 text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-lg transition-colors" title="Sair">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-white dark:bg-slate-800 border-b border-gray-200 dark:border-slate-700 shadow-sm transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center space-x-2 overflow-x-auto py-2">
          <!-- Iniciar Processo - Botão Azul -->
          <a href="/processos/novo" class="bg-blue-600 dark:bg-blue-600 text-white px-4 py-2.5 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-700 transition-all shadow-sm hover:shadow-md text-sm font-medium flex items-center whitespace-nowrap">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Iniciar Processo
          </a>
          
          <!-- Acompanhamento - Botão Verde Teal (Ativo) -->
          <a href="/dashboard" class="bg-teal-500 dark:bg-teal-600 text-white px-4 py-2.5 rounded-lg hover:bg-teal-600 dark:hover:bg-teal-500 transition-all shadow-sm hover:shadow-md text-sm font-medium flex items-center whitespace-nowrap">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Acompanhamento
          </a>
          
          <!-- Anexos - Item de Menu -->
          <a href="/anexos" class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-slate-700 rounded-lg transition-colors whitespace-nowrap flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
            </svg>
            Anexos
          </a>
          
          <!-- Notas Fiscais - Item de Menu -->
          <a href="/notas-fiscais" class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-slate-700 rounded-lg transition-colors whitespace-nowrap flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Notas Fiscais
          </a>
          
          <!-- Fornecedores - Item de Menu -->
          <a href="/fornecedores" class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-slate-700 rounded-lg transition-colors whitespace-nowrap flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            Fornecedores
          </a>
          
          <!-- Cadastros - Dropdown Menu -->
          <div class="relative">
            <button id="cadastrosBtn" type="button" class="px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-slate-700 rounded-lg transition-colors whitespace-nowrap flex items-center focus:outline-none">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              Cadastros
              <svg class="w-4 h-4 ml-1 transition-transform duration-200" id="cadastrosArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <!-- Dropdown Menu: Usuários > Grupos > Unidades -->
            <div id="cadastrosDropdown" class="hidden fixed bg-white dark:bg-slate-800 rounded-lg shadow-2xl border border-gray-200 dark:border-slate-600 overflow-hidden z-[9999] min-w-[200px]">
              <!-- 1. Usuários -->
              <a href="/cadastros/usuarios" class="flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors border-b border-gray-100 dark:border-slate-700 last:border-b-0">
                <svg class="w-4 h-4 mr-3 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                Usuários
              </a>
              
              <!-- 2. Grupos -->
              <a href="/grupos" class="flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors border-b border-gray-100 dark:border-slate-700 last:border-b-0">
                <svg class="w-4 h-4 mr-3 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                Grupos
              </a>
              
              <!-- 3. Unidades -->
              <a href="/unidades" class="flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">
                <svg class="w-4 h-4 mr-3 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Unidades
              </a>
            </div>
          </div>
          
          <script>
            // Dropdown de Cadastros - Sobreposto (Overlay)
            (function() {
              const btn = document.getElementById('cadastrosBtn');
              const dropdown = document.getElementById('cadastrosDropdown');
              const arrow = document.getElementById('cadastrosArrow');
              
              function positionDropdown() {
                if (!btn || !dropdown) return;
                
                const btnRect = btn.getBoundingClientRect();
                const scrollY = window.scrollY || window.pageYOffset;
                const scrollX = window.scrollX || window.pageXOffset;
                
                // Posicionar abaixo do botão
                dropdown.style.top = (btnRect.bottom + scrollY + 4) + 'px';
                dropdown.style.left = (btnRect.left + scrollX) + 'px';
              }
              
              if (btn && dropdown) {
                // Abrir/fechar dropdown
                btn.addEventListener('click', (e) => {
                  e.stopPropagation();
                  const isHidden = dropdown.classList.contains('hidden');
                  
                  if (isHidden) {
                    positionDropdown();
                    dropdown.classList.remove('hidden');
                    arrow?.classList.add('rotate-180');
                  } else {
                    dropdown.classList.add('hidden');
                    arrow?.classList.remove('rotate-180');
                  }
                });
                
                // Reposicionar ao redimensionar ou rolar
                window.addEventListener('resize', () => {
                  if (!dropdown.classList.contains('hidden')) {
                    positionDropdown();
                  }
                });
                
                window.addEventListener('scroll', () => {
                  if (!dropdown.classList.contains('hidden')) {
                    positionDropdown();
                  }
                }, true);
                
                // Fechar ao clicar fora
                document.addEventListener('click', (e) => {
                  if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.add('hidden');
                    arrow?.classList.remove('rotate-180');
                  }
                });
                
                // Prevenir fechar ao clicar nos links
                dropdown.addEventListener('click', (e) => {
                  e.stopPropagation();
                });
              }
            })();
          </script>
        </div>
      </div>
    </nav>
    
    <!-- Script de Dark Mode -->
    <script>
      // Função para aplicar o tema
      function applyTheme(theme) {
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        }
      }

      // Verificar preferência salva ou preferência do sistema
      const savedTheme = localStorage.getItem('theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const initialTheme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
      applyTheme(initialTheme);

      // Toggle de tema
      document.getElementById('themeToggle')?.addEventListener('click', function() {
        const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
      });

      // Listener para mudanças na preferência do sistema
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          applyTheme(e.matches ? 'dark' : 'light');
        }
      });
    </script>
  <% } %>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 bg-gray-50 dark:bg-slate-900 min-h-screen transition-colors">
