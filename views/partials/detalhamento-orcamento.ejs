<% const roots = typeof planoTree !== 'undefined' ? planoTree : []; %>
<% const totalOrcado = roots.reduce((s, r) => s + (parseFloat(r.valor) || 0), 0); %>
<% const totalUsado = roots.reduce((s, r) => s + (parseFloat(r.valor) || 0) - (parseFloat(r.disponivel) || 0), 0); %>
<% const percentualGeral = totalOrcado > 0 ? Math.round((totalUsado / totalOrcado) * 100) : 0; %>
<% const formatBr = (v) => (typeof v === 'number' ? v : parseFloat(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>

<div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-2">
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-xs font-bold text-gray-900 dark:text-white flex items-center">
      <svg class="w-4 h-4 mr-1.5 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
      </svg>
      Detalhamento de Orçamento
    </h2>
    <div class="flex items-center gap-2">
      <a href="/inicio" class="text-[10px] font-medium text-cyan-600 dark:text-cyan-400 hover:underline inline-flex items-center gap-1" title="Atualizar orçamento">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Atualizar
      </a>
      <% if (typeof showLink !== 'undefined' && showLink && unidade) { %>
        <a href="/unidades/<%= unidade.id %>/plano-contas" class="text-[10px] font-medium text-cyan-600 dark:text-cyan-400 hover:underline">Ver plano</a>
      <% } %>
    </div>
  </div>

  <% if (roots.length === 0) { %>
    <p class="text-[10px] text-gray-500 dark:text-gray-400">Nenhuma conta na unidade. Selecione uma unidade ou cadastre o plano.</p>
  <% } else { %>
    <div class="mb-2">
      <p class="text-[10px] text-gray-600 dark:text-gray-300 mb-0.5">
        R$ <%= formatBr(totalUsado) %> / R$ <%= formatBr(totalOrcado) %> (<%= percentualGeral %>%)
      </p>
      <div class="h-1.5 bg-gray-200 dark:bg-slate-600 rounded-full overflow-hidden">
        <div class="h-full bg-cyan-600 rounded-full transition-all" style="width: <%= Math.min(percentualGeral, 100) %>%"></div>
      </div>
    </div>

    <div class="space-y-1">
      <% roots.forEach((conta) => { %>
        <%- include('detalhamento-orcamento-item', { conta: conta, depth: 0, formatBrFn: formatBr }) %>
      <% }); %>
    </div>
  <% } %>
</div>
