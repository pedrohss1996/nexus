<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Minhas Tarefas - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<%
  function dataBR(v) {
    if (!v) return '—';
    return new Date(v).toLocaleDateString('pt-BR');
  }
  var atrasadas = (tarefas || []).filter(function (t) { return t.atrasada; }).length;
%>

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Minhas tarefas</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
        Etapas de fluxo aguardando ação dos seus grupos
        <% if (atrasadas > 0) { %>
          · <span class="text-red-600 dark:text-red-400 font-medium"><%= atrasadas %> atrasada<%= atrasadas > 1 ? 's' : '' %></span>
        <% } %>
      </p>
    </div>
    <a href="/processos" class="text-sm text-cyan-600 dark:text-cyan-400 hover:underline self-start sm:self-auto">Ver todos os processos →</a>
  </div>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <% if (!tarefas || tarefas.length === 0) { %>
      <div class="p-12 text-center text-gray-500 dark:text-gray-400">
        <p>Nenhuma tarefa aguardando você.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-600">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Processo</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Etapa</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Grupo</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Prazo</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Ação</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-600">
            <% tarefas.forEach(function (t) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors <%= t.atrasada ? 'bg-red-50/50 dark:bg-red-900/10' : '' %>">
                <td class="px-4 py-3 text-sm">
                  <div class="font-mono text-xs text-gray-500 dark:text-gray-400"><%= t.numero_processo || '—' %></div>
                  <div class="text-gray-900 dark:text-white"><%= (t.titulo || '—').slice(0, 60) %><%= (t.titulo || '').length > 60 ? '…' : '' %></div>
                </td>
                <td class="px-4 py-3 text-sm text-gray-900 dark:text-white">
                  <%= t.etapa_nome %>
                  <% if (t.exige_assinatura) { %>
                    <span class="ml-1 text-xs px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-200">assinatura</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300"><%= t.grupo_nome || '—' %></td>
                <td class="px-4 py-3 text-sm <%= t.atrasada ? 'text-red-600 dark:text-red-400 font-medium' : 'text-gray-600 dark:text-gray-300' %>">
                  <%= dataBR(t.prazo) %><%= t.atrasada ? ' (atrasada)' : '' %>
                </td>
                <td class="px-4 py-3 text-right">
                  <a href="/processos/<%= t.processo_id %>" class="text-cyan-600 dark:text-cyan-400 hover:underline text-sm font-medium">Abrir</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/paginacao', { meta: meta }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
