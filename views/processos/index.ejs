<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Processos - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Processos</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Gerencie os processos do sistema</p>
    </div>
    <a href="/processos/novo" class="inline-flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-medium text-sm transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Novo Processo
    </a>
  </div>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="mb-4 p-4 rounded-lg <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200' %> text-sm">
      <%= flash.error || flash.success %>
    </div>
  <% } %>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <% if (!processos || processos.length === 0) { %>
      <div class="p-12 text-center text-gray-500 dark:text-gray-400">
        <p class="mb-4">Nenhum processo cadastrado.</p>
        <a href="/processos/novo" class="text-cyan-600 dark:text-cyan-400 hover:underline font-medium">Criar primeiro processo</a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-600">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Nº</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Título</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Status</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Centro de custo</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-600">
            <% processos.forEach(function(p) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors">
                <td class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white"><%= p.numero_processo || '—' %></td>
                <td class="px-4 py-3 text-sm text-gray-900 dark:text-white"><%= (p.titulo || '—').slice(0, 50) %><%= (p.titulo || '').length > 50 ? '…' : '' %></td>
                <td class="px-4 py-3 text-sm"><span class="px-2 py-0.5 rounded text-xs font-medium <%= p.status === 'aprovado' ? 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-200' : p.status === 'rejeitado' ? 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-200' : 'bg-gray-100 dark:bg-slate-600 text-gray-800 dark:text-gray-200' %>"><%= p.status || 'pendente' %></span></td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300"><%= p.centro_custo_nome || '—' %></td>
                <td class="px-4 py-3 text-right">
                  <a href="/processos/<%= p.id %>" class="text-cyan-600 dark:text-cyan-400 hover:underline text-sm font-medium">Ver</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/paginacao', { meta: meta }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
