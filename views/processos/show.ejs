<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Processo - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<%
  function dataBR(v) {
    if (!v) return '—';
    var d = new Date(v);
    return d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }
  var corStatus = {
    aprovado: 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-200',
    rejeitado: 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-200',
    em_andamento: 'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200'
  };
  var temFluxo = fluxo && fluxo.fluxo_id;
  var etapaAberta = temFluxo && fluxo.etapa_atual_id;
  var atrasada = etapaAberta && fluxo.prazo && new Date(fluxo.prazo) < new Date();
%>

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">

  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
    <div>
      <a href="/processos" class="text-sm text-cyan-600 dark:text-cyan-400 hover:underline">← Processos</a>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mt-1"><%= processo.titulo %></h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 font-mono"><%= processo.numero_processo || '—' %></p>
    </div>
    <span class="self-start px-3 py-1 rounded-full text-sm font-medium <%= corStatus[processo.status] || 'bg-gray-100 dark:bg-slate-600 text-gray-800 dark:text-gray-200' %>">
      <%= (processo.status || 'pendente').replace('_', ' ') %>
    </span>
  </div>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="mb-4 p-4 rounded-lg <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200' %> text-sm">
      <%= flash.error || flash.success %>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- ── Coluna principal ──────────────────────────────────────────── -->
    <div class="lg:col-span-2 space-y-6">

      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-6">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider mb-4">Dados do processo</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div><dt class="text-gray-500 dark:text-gray-400">Centro de custo</dt><dd class="text-gray-900 dark:text-white mt-0.5"><%= processo.centro_custo_nome || '—' %></dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Criado por</dt><dd class="text-gray-900 dark:text-white mt-0.5"><%= processo.criado_por_nome || '—' %></dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Criado em</dt><dd class="text-gray-900 dark:text-white mt-0.5"><%= dataBR(processo.criado_em) %></dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Vencimento</dt><dd class="text-gray-900 dark:text-white mt-0.5"><%= processo.data_vencimento ? new Date(processo.data_vencimento).toLocaleDateString('pt-BR') : '—' %></dd></div>
        </dl>
        <% if (processo.descricao_detalhada) { %>
          <div class="mt-5 pt-5 border-t border-gray-200 dark:border-slate-700">
            <dt class="text-gray-500 dark:text-gray-400 text-sm">Descrição</dt>
            <dd class="text-gray-900 dark:text-white text-sm mt-1 whitespace-pre-line"><%= processo.descricao_detalhada %></dd>
          </div>
        <% } %>
      </div>

      <!-- ── Linha do tempo do fluxo ──────────────────────────────────── -->
      <% if (temFluxo && historicoFluxo && historicoFluxo.length > 0) { %>
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-6">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider mb-4">
          Percurso — <%= fluxo.fluxo_nome %>
        </h2>
        <ol class="relative border-l border-gray-200 dark:border-slate-600 ml-2">
          <% historicoFluxo.forEach(function(h) {
               var cor = h.status === 'concluida' ? 'bg-green-500'
                       : h.status === 'rejeitada' ? 'bg-red-500'
                       : h.status === 'pendente'  ? 'bg-cyan-500' : 'bg-gray-400';
          %>
          <li class="ml-6 pb-6 last:pb-0">
            <span class="absolute -left-1.5 w-3 h-3 rounded-full <%= cor %>"></span>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <h3 class="text-sm font-medium text-gray-900 dark:text-white"><%= h.etapa_nome %></h3>
              <span class="text-xs text-gray-500 dark:text-gray-400"><%= h.grupo_nome || 'sem grupo' %></span>
              <% if (h.status === 'pendente') { %>
                <span class="text-xs px-1.5 py-0.5 rounded bg-cyan-100 dark:bg-cyan-900/30 text-cyan-800 dark:text-cyan-200">em aberto</span>
              <% } %>
              <% if (h.decisao) { %>
                <span class="text-xs px-1.5 py-0.5 rounded <%= h.decisao === 'aprovado' ? 'bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-200' : 'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-200' %>"><%= h.decisao %></span>
              <% } %>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
              Iniciada em <%= dataBR(h.iniciada_em) %>
              <% if (h.concluida_em) { %> · concluída em <%= dataBR(h.concluida_em) %> por <%= h.responsavel_nome || '—' %><% } %>
            </p>
            <% if (h.observacao) { %>
              <p class="text-sm text-gray-700 dark:text-gray-300 mt-1.5 bg-gray-50 dark:bg-slate-700/50 rounded p-2"><%= h.observacao %></p>
            <% } %>
          </li>
          <% }); %>
        </ol>
      </div>
      <% } %>

      <!-- ── Documentos ───────────────────────────────────────────────── -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-6">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider mb-4">Documentos</h2>
        <% if (!documentos || documentos.length === 0) { %>
          <p class="text-sm text-gray-500 dark:text-gray-400">Nenhum documento anexado.</p>
        <% } else { %>
          <ul class="divide-y divide-gray-200 dark:divide-slate-700 text-sm">
            <% documentos.forEach(function(d) { %>
              <li class="py-2 flex items-center justify-between">
                <span class="text-gray-900 dark:text-white"><%= d.nome_original || d.nome_arquivo %></span>
                <span class="text-xs text-gray-500 dark:text-gray-400"><%= d.status || '—' %></span>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>

    <!-- ── Painel lateral: etapa atual e ações ───────────────────────── -->
    <div class="space-y-6">
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-6">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider mb-4">Etapa atual</h2>

        <% if (!temFluxo) { %>
          <p class="text-sm text-gray-500 dark:text-gray-400">Este processo não segue nenhum fluxo.</p>

        <% } else if (!etapaAberta) { %>
          <p class="text-sm text-gray-700 dark:text-gray-300">
            Fluxo <span class="font-medium"><%= fluxo.fluxo_nome %></span> concluído
            <% if (fluxo.fluxo_concluido_em) { %> em <%= dataBR(fluxo.fluxo_concluido_em) %><% } %>.
          </p>

        <% } else { %>
          <p class="text-base font-medium text-gray-900 dark:text-white"><%= fluxo.etapa_nome %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
            Responsável: <%= fluxo.grupo_nome || 'sem grupo definido' %>
          </p>

          <% if (fluxo.prazo) { %>
            <p class="text-sm mt-2 <%= atrasada ? 'text-red-600 dark:text-red-400 font-medium' : 'text-gray-500 dark:text-gray-400' %>">
              Prazo: <%= dataBR(fluxo.prazo) %><%= atrasada ? ' — atrasada' : '' %>
            </p>
          <% } %>

          <% if (fluxo.exige_assinatura) { %>
            <p class="text-xs mt-2 px-2 py-1 rounded bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-200">
              Exige documento assinado eletronicamente
            </p>
          <% } %>

          <div class="mt-5 pt-5 border-t border-gray-200 dark:border-slate-700">
            <% if (!podeAgirNaEtapa) { %>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                Você não faz parte do grupo responsável por esta etapa.
              </p>
            <% } else { %>
              <%
                var decide = fluxo.tipo_acao === 'aprovacao' || fluxo.tipo_acao === 'parecer_tecnico';
              %>
              <form method="POST" action="/processos/<%= processo.id %>/<%= decide ? 'aprovar' : 'concluir-etapa' %>" class="space-y-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label class="block">
                  <span class="text-sm text-gray-700 dark:text-gray-300">Observação</span>
                  <textarea name="observacao" rows="3" class="mt-1 w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500" placeholder="Opcional"></textarea>
                </label>
                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2.5 rounded-lg font-medium text-sm transition-colors">
                  <%= decide ? 'Aprovar e avançar' : 'Concluir etapa' %>
                </button>
              </form>

              <% if (decide) { %>
                <form method="POST" action="/processos/<%= processo.id %>/rejeitar" class="mt-2" onsubmit="return confirm('Reprovar esta etapa?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="observacao" value="">
                  <button type="submit" class="w-full inline-flex items-center justify-center gap-2 border border-red-300 dark:border-red-800 text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/20 px-4 py-2.5 rounded-lg font-medium text-sm transition-colors">
                    Reprovar
                  </button>
                </form>
              <% } %>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
