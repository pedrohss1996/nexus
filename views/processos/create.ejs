<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Novo Processo - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>
<% const numeroProcessoVal = typeof numeroProcesso !== 'undefined' ? numeroProcesso : ''; const contasContabeisList = typeof contasContabeis !== 'undefined' ? contasContabeis : []; const fornecedoresList = typeof fornecedores !== 'undefined' ? fornecedores : []; const fluxosList = typeof fluxos !== 'undefined' ? fluxos : []; %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-5">
  <nav class="flex text-sm text-gray-600 dark:text-gray-400 mb-4">
    <a href="/processos" class="hover:text-cyan-600 dark:hover:text-cyan-400">Processos</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900 dark:text-white">Novo processo</span>
  </nav>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="mb-4 p-3 rounded-lg text-sm <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200' %>">
      <%= flash.error || flash.success %>
    </div>
  <% } %>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between gap-4">
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">Novo Processo</h1>
      <span class="text-sm text-gray-500 dark:text-gray-400">Nº <strong class="text-gray-700 dark:text-gray-200"><%= numeroProcessoVal %></strong></span>
    </div>

    <form id="formProcesso" method="POST" action="/processos" enctype="multipart/form-data" class="p-6 space-y-5">
      <div>
        <label for="titulo" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Título <span class="text-red-500">*</span></label>
        <input type="text" id="titulo" name="titulo" required maxlength="255" placeholder="Ex: Aquisição de equipamentos"
          class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500">
      </div>

      <div>
        <label for="descricao_detalhada" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Descrição detalhada</label>
        <textarea id="descricao_detalhada" name="descricao_detalhada" rows="3" placeholder="Descreva o processo em detalhes"
          class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500 resize-none"></textarea>
      </div>

      <div>
        <label for="observacao" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Observações</label>
        <textarea id="observacao" name="observacao" rows="3" placeholder="Observações gerais"
          class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500 resize-none"></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="fornecedor_id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Fornecedor</label>
          <select id="fornecedor_id" name="fornecedor_id" class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500">
            <option value="">— Selecionar fornecedor —</option>
            <% fornecedoresList.forEach(function(f) { %>
              <option value="<%= f.id %>"><%= (f.nome_fantasia || f.razao_social || f.nome || '—').slice(0, 50) %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="conta_contabil_id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Centro de custo</label>
          <select id="conta_contabil_id" name="conta_contabil_id" class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500">
            <option value="">— Selecionar centro de custo —</option>
            <% contasContabeisList.forEach(function(cc) { const indent = (cc.depth || 0) > 0 ? '— '.repeat(cc.depth) : ''; %>
              <option value="<%= cc.id %>"><%= indent %><%= cc.nome %><% if (cc.codigo) { %> (<%= cc.codigo %>)<% } %></option>
            <% }); %>
          </select>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Contas e subcontas na ordem do plano de contas.</p>
        </div>
        <div>
          <label for="fluxo_id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Fluxo</label>
          <select id="fluxo_id" name="fluxo_id" class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500">
            <option value="">— Selecionar fluxo —</option>
            <% fluxosList.forEach(function(fl) { %>
              <option value="<%= fl.id %>"><%= fl.nome %><% if (fl.slug) { %> (<%= fl.slug %>)<% } %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Emergencial</label>
          <div class="flex gap-4 items-center py-2">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="radio" name="emergencial" value="0" checked class="text-cyan-600 focus:ring-cyan-500">
              <span class="text-sm text-gray-700 dark:text-gray-300">Não</span>
            </label>
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="radio" name="emergencial" value="1" class="text-cyan-600 focus:ring-cyan-500">
              <span class="text-sm text-gray-700 dark:text-gray-300">Sim</span>
            </label>
          </div>
        </div>
        <div>
          <label for="data_vencimento" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Data de vencimento</label>
          <input type="date" id="data_vencimento" name="data_vencimento"
            class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500">
        </div>
      </div>

      <div>
        <label for="anexos" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Anexar arquivos</label>
        <input type="file" id="anexos" name="anexos" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.webp,.zip,.txt"
          class="w-full border border-gray-300 dark:border-slate-600 rounded-lg px-3 py-2 text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-cyan-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-cyan-50 file:text-cyan-700 dark:file:bg-cyan-900/30 dark:file:text-cyan-300">
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">PDF, DOC, XLS, imagens ou ZIP. Até 10 arquivos.</p>
        <ul id="listaAnexos" class="mt-2 space-y-1.5 text-sm text-gray-600 dark:text-gray-400"></ul>
      </div>

      <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-200 dark:border-slate-700">
        <button type="submit" id="btnSubmit" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg font-medium text-sm transition-colors">
          Criar processo
        </button>
        <a href="/processos" class="inline-flex items-center gap-2 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-gray-300 px-5 py-2.5 rounded-lg font-medium text-sm hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">
          Cancelar
        </a>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  const MAX_ANEXOS = 10;
  const anexosInput = document.getElementById('anexos');
  const listaAnexos = document.getElementById('listaAnexos');
  const form = document.getElementById('formProcesso');
  const btnSubmit = document.getElementById('btnSubmit');
  let arquivosSelecionados = [];

  function formatarTamanho(bytes) {
    if (bytes == null || bytes === 0) return '';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function renderizarLista() {
    listaAnexos.innerHTML = '';
    arquivosSelecionados.forEach(function (arq, idx) {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between gap-2 py-1.5 px-2 rounded-lg bg-gray-50 dark:bg-slate-700/50 border border-gray-200 dark:border-slate-600 text-sm';
      li.innerHTML = '<span class="truncate flex-1 min-w-0" title="' + (arq.name || '').replace(/"/g, '&quot;') + '">' + (arq.name || 'Arquivo') + '</span>' +
        '<span class="text-gray-500 dark:text-gray-400 shrink-0 text-xs">' + formatarTamanho(arq.size) + '</span>' +
        '<button type="button" class="remover-anexo shrink-0 text-red-600 hover:text-red-700 dark:text-red-400 text-sm font-medium" data-idx="' + idx + '" title="Remover">Remover</button>';
      listaAnexos.appendChild(li);
    });
  }

  function atualizarInput() {
    anexosInput.value = '';
    if (arquivosSelecionados.length === 0) return;
    var dt = new DataTransfer();
    arquivosSelecionados.forEach(function (f) { dt.items.add(f); });
    anexosInput.files = dt.files;
  }

  if (anexosInput) {
    anexosInput.addEventListener('change', function () {
      var novos = Array.from(anexosInput.files || []);
      var total = arquivosSelecionados.length + novos.length;
      if (total > MAX_ANEXOS) {
        novos = novos.slice(0, MAX_ANEXOS - arquivosSelecionados.length);
      }
      arquivosSelecionados = arquivosSelecionados.concat(novos);
      atualizarInput();
      renderizarLista();
    });
  }

  listaAnexos.addEventListener('click', function (e) {
    var btn = e.target.closest('.remover-anexo');
    if (!btn) return;
    var idx = parseInt(btn.getAttribute('data-idx'), 10);
    if (isNaN(idx)) return;
    arquivosSelecionados.splice(idx, 1);
    atualizarInput();
    renderizarLista();
  });

  if (form) {
    form.addEventListener('submit', function (e) {
      if (arquivosSelecionados.length > 0) {
        var dt = new DataTransfer();
        arquivosSelecionados.forEach(function (f) { dt.items.add(f); });
        anexosInput.files = dt.files;
      }
    });
  }
})();
</script>

<%- include('../partials/footer') %>
