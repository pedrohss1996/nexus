<%- include('../partials/header', { title: title, user: user }) %>

<style>
  .doc-preview-wrap {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
  }
  .doc-preview-body {
    padding: 32px 40px;
    font-family: Arial, 'Helvetica Neue', sans-serif;
    font-size: 10pt;
    color: #1a1a1a;
    line-height: 1.6;
    max-height: 520px;
    overflow-y: auto;
  }
  @media (max-width: 640px) {
    .doc-preview-body { padding: 16px 18px; }
  }
</style>

<div class="w-full max-w-5xl mx-auto px-4 py-8">

  <div class="flex items-center gap-3 mb-6">
    <a href="/documentos-pdf" class="p-1.5 rounded-lg text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    </a>
    <div>
      <h1 class="text-lg font-bold text-gray-900 dark:text-white">Assinatura Eletrônica</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        <%= assin.titulo || assin.template_nome || 'Documento' %>
        &nbsp;·&nbsp; Grupo: <strong class="text-gray-700 dark:text-gray-300"><%= assin.grupo_nome %></strong>
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-5">

    <!-- Coluna esquerda: ação de assinar -->
    <div class="lg:col-span-2 space-y-4">

      <% if (!podeAssinar && assin.status === 'assinado') { %>
      <!-- Já assinado -->
      <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl p-5 text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-green-100 dark:bg-green-900/40 mx-auto mb-3">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <p class="font-semibold text-green-800 dark:text-green-200">Esta assinatura já foi realizada</p>
        <% if (assin.nome_assinante) { %>
          <p class="text-sm text-green-600 dark:text-green-400 mt-1">Por <%= assin.nome_assinante %></p>
        <% } %>
      </div>

      <% } else if (!podeAssinar) { %>
      <!-- Sem permissão -->
      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-xl p-5 text-center">
        <div class="text-3xl mb-2">🔒</div>
        <p class="font-semibold text-amber-800 dark:text-amber-200">Você não tem permissão para assinar</p>
        <p class="text-sm text-amber-600 dark:text-amber-400 mt-1">
          Apenas membros do grupo <strong><%= assin.grupo_nome %></strong> podem assinar aqui.
        </p>
      </div>

      <% } else { %>
      <!-- Card de assinatura -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden" id="card-assinar">
        <div class="px-5 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between">
          <div>
            <p class="font-semibold text-gray-800 dark:text-white text-sm">Assinatura requerida</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Grupo: <strong><%= assin.grupo_nome %></strong></p>
          </div>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Pendente
          </span>
        </div>
        <div class="p-5 space-y-3">
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-3">
              <p class="text-xs text-gray-400 dark:text-gray-500 mb-0.5">Assinante</p>
              <p class="font-semibold text-gray-800 dark:text-white"><%= user.nome %></p>
              <% if (user.cargo) { %>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= user.cargo %></p>
              <% } %>
            </div>
            <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-3">
              <p class="text-xs text-gray-400 dark:text-gray-500 mb-0.5">Data/Hora</p>
              <p class="font-semibold text-gray-800 dark:text-white js-hora-atual text-xs">—</p>
            </div>
          </div>

          <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-lg p-3 text-xs text-blue-700 dark:text-blue-300">
            Ao assinar, você confirma que leu e concorda com o conteúdo do documento.
            Serão registrados: <strong>nome, CPF, cargo, IP e data/hora</strong>.
          </div>

          <button type="button" id="btn-assinar"
            class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-semibold rounded-lg transition-colors text-sm flex items-center justify-center gap-2"
            data-token="<%= docToken %>"
            data-assinid="<%= assin.id %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
            Assinar eletronicamente
          </button>
        </div>
      </div>
      <% } %>

      <!-- Status de todas as assinaturas do documento -->
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm p-4">
        <h3 class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-3">Status das assinaturas</h3>
        <% todasAssinaturas.forEach(function(a) { %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 dark:border-slate-700 last:border-0">
          <div class="flex items-center gap-2">
            <% if (a.status === 'assinado') { %>
              <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
            <% } else { %>
              <div class="w-6 h-6 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
            <% } %>
            <div>
              <p class="text-xs font-medium text-gray-700 dark:text-gray-300"><%= a.grupo_nome %></p>
              <% if (a.status === 'assinado' && a.nome_assinante) { %>
                <p class="text-xs text-gray-400 dark:text-gray-500"><%= a.nome_assinante %></p>
              <% } %>
            </div>
          </div>
          <span class="text-xs font-semibold <%= a.status === 'assinado' ? 'text-green-600' : 'text-amber-600' %>">
            <%= a.status === 'assinado' ? 'Assinado' : 'Pendente' %>
          </span>
        </div>
        <% }); %>
      </div>

      <!-- Botão baixar PDF atual -->
      <a href="/assinaturas-doc/pdf-assinado/<%= docToken %>"
         class="flex items-center justify-center gap-2 w-full px-4 py-2.5 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-400 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
         id="btn-dl-pdf">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Baixar PDF (estado atual)
      </a>

      <!-- Resultado pós-assinatura -->
      <div id="resultado-assinatura" style="display:none"
        class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl p-5">
        <p class="font-bold text-green-800 dark:text-green-200 mb-2">Documento assinado com sucesso!</p>
        <p class="text-xs text-green-700 dark:text-green-300 mb-1">Código verificador:</p>
        <p id="hash-resultado" class="font-mono text-xs font-bold text-green-900 dark:text-green-100 bg-green-100 dark:bg-green-900/40 px-3 py-1.5 rounded-lg mb-3 break-all"></p>
        <div class="flex flex-col gap-2">
          <a id="link-verificar" href="#" target="_blank"
            class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
            Verificar autenticidade ↗
          </a>
          <a id="link-pdf-assinado" href="#"
            class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-medium transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Baixar PDF assinado
          </a>
        </div>
      </div>

    </div>

    <!-- Coluna direita: preview do documento no estado atual -->
    <div class="lg:col-span-3">
      <div class="doc-preview-wrap">
        <div class="px-5 py-3 bg-gray-50 dark:bg-slate-700/50 border-b border-gray-200 dark:border-slate-700 flex items-center gap-2">
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
            Documento — Estado atual
          </span>
          <% var assinadasCount = todasAssinaturas.filter(function(a){ return a.status === 'assinado'; }).length; %>
          <% if (assinadasCount > 0) { %>
          <span class="ml-auto text-xs text-green-600 dark:text-green-400 font-medium">
            <%= assinadasCount %> de <%= todasAssinaturas.length %> assinatura<%= todasAssinaturas.length > 1 ? 's' : '' %> realizada<%= assinadasCount > 1 ? 's' : '' %>
          </span>
          <% } %>
        </div>
        <div class="doc-preview-body" id="doc-preview">
          <%- htmlEstadoAtual %>
        </div>
      </div>
    </div>

  </div>

</div>

<!-- Toast de erro -->
<div id="toast-erro" style="display:none"
  class="fixed bottom-6 right-6 z-50 max-w-sm bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-red-200 dark:border-red-700 p-4 flex items-start gap-3">
  <div class="text-xl flex-shrink-0 text-red-500">✕</div>
  <div>
    <p class="font-semibold text-sm text-gray-800 dark:text-white">Erro ao assinar</p>
    <p id="toast-erro-msg" class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"></p>
  </div>
  <button onclick="document.getElementById('toast-erro').style.display='none'"
    class="ml-auto text-gray-400 hover:text-gray-700 text-lg leading-none flex-shrink-0">×</button>
</div>

<script>
(function () {
  'use strict';

  // Relógio ao vivo
  function tick() {
    var agora = new Date().toLocaleString('pt-BR');
    document.querySelectorAll('.js-hora-atual').forEach(function(el) { el.textContent = agora; });
  }
  tick();
  setInterval(tick, 1000);

  function mostrarErro(msg) {
    var t = document.getElementById('toast-erro');
    var m = document.getElementById('toast-erro-msg');
    if (!t || !m) { alert('Erro: ' + msg); return; }
    m.textContent = msg;
    t.style.display = 'flex';
    setTimeout(function() { t.style.display = 'none'; }, 8000);
  }

  var btn = document.getElementById('btn-assinar');
  if (!btn) return;

  btn.addEventListener('click', function () {
    var token   = btn.dataset.token;
    var assinId = parseInt(btn.dataset.assinid, 10);

    if (!token || !assinId) {
      mostrarErro('Dados de assinatura inválidos. Recarregue a página.');
      return;
    }

    btn.disabled = true;
    btn.innerHTML =
      '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">' +
        '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>' +
        '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>' +
      '</svg> Registrando...';

    fetch('/assinaturas-doc/assinar/' + token, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ assinatura_id: assinId })
    })
    .then(function(resp) {
      if (!resp.ok) {
        return resp.text().then(function(txt) {
          var msg;
          try { msg = JSON.parse(txt).message; } catch (_) { msg = 'HTTP ' + resp.status; }
          throw new Error(msg || 'Erro do servidor');
        });
      }
      return resp.json();
    })
    .then(function(data) {
      if (!data.success) throw new Error(data.message || 'Falha ao registrar assinatura');

      // Esconder card de assinatura
      var card = document.getElementById('card-assinar');
      if (card) {
        card.style.transition = 'opacity .4s';
        card.style.opacity = '0';
        setTimeout(function() { card.remove(); }, 450);
      }

      // Mostrar resultado
      var resultado  = document.getElementById('resultado-assinatura');
      var hashEl     = document.getElementById('hash-resultado');
      var linkVerif  = document.getElementById('link-verificar');
      var linkPDF    = document.getElementById('link-pdf-assinado');

      if (resultado && hashEl) {
        hashEl.textContent = data.hash_assinatura;
        if (linkVerif) linkVerif.href = data.link_verificacao;
        if (linkPDF)   linkPDF.href   = '/assinaturas-doc/pdf-assinado/' + token;
        resultado.style.display = 'block';
        resultado.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // Recarregar preview do documento após 1s para mostrar assinatura inserida
      setTimeout(function() {
        window.location.reload();
      }, 3000);

      // Download automático do PDF assinado
      setTimeout(function() {
        var a = document.createElement('a');
        a.href = '/assinaturas-doc/pdf-assinado/' + token;
        a.download = '';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }, 1000);
    })
    .catch(function(err) {
      mostrarErro(err.message || 'Erro desconhecido.');
      btn.disabled = false;
      btn.innerHTML =
        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
          '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>' +
        '</svg> Assinar eletronicamente';
    });
  });
})();
</script>

<%- include('../partials/footer') %>
