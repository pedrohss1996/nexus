<%- include('../partials/header', { title: title, user: user }) %>

<div class="w-full max-w-3xl mx-auto px-4 py-8">

  <!-- Cabeçalho -->
  <div class="flex items-center gap-3 mb-6">
    <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900 flex items-center justify-center">
      <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
    </div>
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">Assinatura Eletrônica</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= doc.titulo || doc.template_nome || 'Documento' %></p>
    </div>
  </div>

  <% if (pendentesParaUsuario.length === 0) { %>
  <!-- Sem pendências para este usuário -->
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700 rounded-xl p-6 text-center">
    <div class="text-4xl mb-3">🔒</div>
    <p class="font-semibold text-amber-800 dark:text-amber-200">Você não possui assinaturas pendentes neste documento</p>
    <p class="text-sm text-amber-600 dark:text-amber-400 mt-1">Apenas membros dos grupos responsáveis podem assinar.</p>
  </div>
  <% } else { %>

  <!-- Aviso importante -->
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-700 rounded-xl p-4 mb-6">
    <div class="flex gap-3">
      <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-sm text-blue-700 dark:text-blue-300">
        Ao assinar eletronicamente, você confirma que leu e concorda com o conteúdo do documento.
        Sua assinatura registra <strong>nome, CPF, cargo, IP, data e hora</strong> e gera um hash único de autenticidade.
        Após assinar, o PDF com assinatura será baixado automaticamente.
      </p>
    </div>
  </div>

  <!-- Assinaturas pendentes para o usuário -->
  <% pendentesParaUsuario.forEach(function(assin) { %>
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm mb-4 overflow-hidden" id="assin-card-<%= assin.id %>">
    <div class="px-5 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-lg">✍️</span>
        <div>
          <p class="font-semibold text-gray-800 dark:text-white text-sm">Assinatura requerida</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Grupo: <strong><%= assin.grupo_nome %></strong></p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Pendente
      </span>
    </div>

    <div class="px-5 py-4">
      <!-- Dados que serão registrados -->
      <div class="grid grid-cols-2 gap-3 mb-4 text-sm">
        <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-3">
          <p class="text-xs text-gray-400 dark:text-gray-500 mb-0.5">Assinante</p>
          <p class="font-semibold text-gray-800 dark:text-white"><%= user.nome %></p>
          <% if (user.cargo) { %><p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= user.cargo %></p><% } %>
        </div>
        <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-3">
          <p class="text-xs text-gray-400 dark:text-gray-500 mb-0.5">Data/Hora</p>
          <p class="font-semibold text-gray-800 dark:text-white js-hora-atual">—</p>
        </div>
      </div>

      <!-- Botão de assinatura com data attributes (sem onclick inline) -->
      <button type="button"
        class="btn-assinar w-full py-3 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-semibold rounded-lg transition-colors text-sm flex items-center justify-center gap-2"
        data-token="<%= doc.token_assinatura %>"
        data-assinid="<%= assin.id %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
        </svg>
        Assinar eletronicamente
      </button>
    </div>
  </div>
  <% }); %>
  <% } %>

  <!-- Histórico de assinaturas do documento -->
  <% var assinadas = todasAssinaturas.filter(function(a){ return a.status === 'assinado'; }); %>
  <% if (assinadas.length > 0) { %>
  <div class="mt-6" id="sec-historico">
    <h2 class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Assinaturas realizadas</h2>
    <% assinadas.forEach(function(a) { %>
    <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl p-4 mb-3">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/50 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <div class="flex-1 text-sm">
          <p class="font-semibold text-gray-800 dark:text-white"><%= a.nome_assinante %></p>
          <p class="text-gray-600 dark:text-gray-400">
            <%= a.cargo_assinante %> &nbsp;|&nbsp;
            <%= a.data_hora ? new Date(a.data_hora).toLocaleString('pt-BR', { timeZone:'America/Sao_Paulo', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false }).replace(',','') : '' %>
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-1 font-mono">
            Hash: <strong><%= a.hash_assinatura %></strong>
            &nbsp;&mdash;&nbsp;
            <a href="/verificar/<%= a.hash_assinatura %>" target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline">Verificar ↗</a>
          </p>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <div id="sec-historico"></div>
  <% } %>

  <!-- Botão para baixar PDF com assinaturas -->
  <div class="mt-6 flex gap-3">
    <a id="btn-dl-pdf" href="/assinaturas-doc/pdf-assinado/<%= doc.token_assinatura %>"
       class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      Baixar PDF com assinaturas
    </a>
    <a href="/documentos-pdf" class="inline-flex items-center gap-2 px-4 py-2.5 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-400 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">
      Voltar
    </a>
  </div>

  <!-- Área de resultado pós-assinatura -->
  <div id="resultado-assinatura" style="display:none"
    class="mt-6 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl p-5">
    <div class="flex items-start gap-3">
      <div class="text-3xl">✅</div>
      <div class="flex-1">
        <p class="font-bold text-green-800 dark:text-green-200 text-base">Documento assinado com sucesso!</p>
        <p class="text-sm text-green-700 dark:text-green-300 mt-1">Código verificador gerado:</p>
        <p id="hash-resultado" class="font-mono text-sm font-bold text-green-900 dark:text-green-100 mt-1 bg-green-100 dark:bg-green-900/40 px-3 py-1.5 rounded-lg"></p>
        <div class="flex gap-3 mt-3">
          <a id="link-verificar" href="#" target="_blank"
            class="inline-flex items-center gap-1.5 text-sm text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
            Verificar assinatura ↗
          </a>
          <a id="link-pdf-assinado" href="#"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Baixar PDF assinado
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast de erro -->
  <div id="toast-erro" style="display:none"
    class="fixed bottom-6 right-6 z-50 max-w-sm bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-red-200 dark:border-red-700 p-4 flex items-start gap-3">
    <div class="text-2xl flex-shrink-0">❌</div>
    <div>
      <p class="font-semibold text-sm text-gray-800 dark:text-white">Erro ao assinar</p>
      <p id="toast-erro-msg" class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"></p>
    </div>
    <button onclick="document.getElementById('toast-erro').style.display='none'"
      class="ml-auto text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 text-lg leading-none flex-shrink-0">×</button>
  </div>
</div>

<script>
(function() {
  'use strict';

  // ── Relógio ao vivo ───────────────────────────────────────────────────
  function atualizarHoras() {
    var agora = new Date().toLocaleString('pt-BR');
    document.querySelectorAll('.js-hora-atual').forEach(function(el) {
      el.textContent = agora;
    });
  }
  atualizarHoras();
  setInterval(atualizarHoras, 1000);

  // ── Mostra/esconde toast de erro ─────────────────────────────────────
  function mostrarErro(msg) {
    var t = document.getElementById('toast-erro');
    var m = document.getElementById('toast-erro-msg');
    if (!t || !m) { alert('Erro: ' + msg); return; }
    m.textContent = msg;
    t.style.display = 'flex';
    setTimeout(function() { t.style.display = 'none'; }, 8000);
  }

  // ── Handler do botão de assinatura ───────────────────────────────────
  document.querySelectorAll('.btn-assinar').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();

      var token    = btn.dataset.token;
      var assinId  = parseInt(btn.dataset.assinid, 10);
      var card     = document.getElementById('assin-card-' + assinId);

      if (!token || !assinId) {
        mostrarErro('Dados de assinatura inválidos. Recarregue a página.');
        return;
      }

      // Feedback imediato no botão
      btn.disabled = true;
      btn.innerHTML =
        '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">' +
          '<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>' +
          '<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>' +
        '</svg> Registrando assinatura...';

      // Chamar API
      fetch('/assinaturas-doc/assinar/' + token, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ assinatura_id: assinId })
      })
      .then(function(resp) {
        // Clonar para poder ler como texto em caso de erro
        if (!resp.ok) {
          return resp.text().then(function(txt) {
            var msg;
            try { msg = JSON.parse(txt).message; } catch (_) { msg = 'HTTP ' + resp.status; }
            throw new Error(msg || 'Erro do servidor');
          });
        }
        return resp.json();
      })
      .then(function(data) {
        if (!data.success) {
          throw new Error(data.message || 'Falha ao registrar assinatura');
        }

        // Esconder card de pendência
        if (card) {
          card.style.transition = 'opacity .4s';
          card.style.opacity = '0';
          setTimeout(function() { card.remove(); }, 450);
        }

        // Mostrar área de resultado
        var resultado = document.getElementById('resultado-assinatura');
        var hashEl    = document.getElementById('hash-resultado');
        var linkVerif = document.getElementById('link-verificar');
        var linkPDF   = document.getElementById('link-pdf-assinado');

        if (resultado && hashEl) {
          hashEl.textContent = data.hash_assinatura;
          if (linkVerif) {
            linkVerif.href = data.link_verificacao;
          }
          if (linkPDF) {
            linkPDF.href = '/assinaturas-doc/pdf-assinado/' + token;
          }
          resultado.style.display = 'block';
          resultado.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Download automático do PDF assinado
        var dlBtn = document.getElementById('btn-dl-pdf');
        if (dlBtn) {
          dlBtn.style.background = '#4f46e5';
          dlBtn.style.color = '#fff';
        }

        // Iniciar download automático após 800ms
        setTimeout(function() {
          var a = document.createElement('a');
          a.href = '/assinaturas-doc/pdf-assinado/' + token;
          a.download = '';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }, 800);
      })
      .catch(function(err) {
        console.error('[Assinatura] Erro:', err);
        mostrarErro(err.message || 'Erro desconhecido. Tente novamente.');
        btn.disabled = false;
        btn.innerHTML =
          '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>' +
          '</svg> Assinar eletronicamente';
      });
    });
  });

})();
</script>

<%- include('../partials/footer') %>
