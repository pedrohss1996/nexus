<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Dashboard - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="space-y-6">
  <!-- Orçamento Geral -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-blue-50 rounded-lg">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Orçamento Geral</h2>
          <p class="text-sm text-gray-500">R$ <%= new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(orcamento.utilizado / 1000) %> mil / R$ <%= new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(orcamento.total / 1000) %> mil</p>
        </div>
      </div>
      <div class="flex items-center space-x-2 text-blue-600 font-semibold text-sm">
        <span><%= orcamento.percentual %>%</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
    
    <!-- Barra de Progresso -->
    <div class="w-full bg-gray-200 rounded-full h-3 mb-4">
      <div class="bg-gradient-to-r from-blue-500 via-teal-400 to-teal-500 h-3 rounded-full transition-all duration-500" style="width: <%= orcamento.percentual %>%;"></div>
    </div>
    
    <!-- Categorias -->
    <div class="flex items-center justify-start space-x-4 text-xs font-medium">
      <% orcamento.categorias.forEach(cat => { %>
        <div class="inline-flex items-center px-3 py-1.5 rounded-full <%= cat.cor === 'blue' ? 'bg-blue-50 text-blue-700' : cat.cor === 'amber' ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700' %>">
          <%= cat.nome %> <%= cat.percentual %>%
          <% if (cat.percentual > 90) { %>
            <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          <% } %>
        </div>
      <% }); %>
    </div>
    
    <p class="text-xs text-gray-400 mt-4 text-center">Clique para ver detalhes por conta contábil</p>
  </div>

  <!-- Solicitações Recentes -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-6">Solicitações Recentes</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID Solicitação</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo de Documento</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Solicitante</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Data</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Valor</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% solicitacoesRecentes.forEach(solicitacao => { %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= solicitacao.id %></td>
              <td class="px-4 py-4 text-sm text-gray-700"><%= solicitacao.tipoDocumento %></td>
              <td class="px-4 py-4 text-sm text-gray-600"><%= solicitacao.solicitante %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600"><%= solicitacao.data %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">R$ <%= new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(solicitacao.valor) %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm">
                <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= solicitacao.status === 'Aprovado' ? 'bg-green-100 text-green-800' : solicitacao.status === 'Pendente' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= solicitacao.status %>
                </span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-center text-sm font-medium">
                <div class="flex items-center justify-center space-x-2">
                  <button class="text-gray-400 hover:text-gray-600 transition-colors" title="Visualizar">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </button>
                  <% if (solicitacao.status !== 'Aprovado') { %>
                    <button class="text-green-500 hover:text-green-700 transition-colors" title="Aprovar">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </button>
                    <button class="text-red-500 hover:text-red-700 transition-colors" title="Rejeitar">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </button>
                  <% } else { %>
                    <span class="text-gray-400 text-xs ml-2">Concluído</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="flex justify-between items-center mt-5 pt-4 border-t border-gray-100">
      <span class="text-sm text-gray-500">Mostrando 5 de 5 registros</span>
      <a href="/solicitacoes" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">Ver todas as solicitações</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
