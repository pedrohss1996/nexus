<%- include('../partials/header', { title: 'DataFlow - Sistema de Gestão Eletrônica de Documentos', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full min-h-screen">
  <!-- Hero / Boas-vindas -->
  <div class="relative overflow-hidden bg-gradient-to-br from-primary-600 via-primary-500 to-primary-700 rounded-2xl mx-4 mt-4 mb-6 p-6 md:p-8 text-white shadow-xl">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-secondary-400 rounded-full -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-white rounded-full translate-y-1/2 -translate-x-1/2"></div>
    </div>
    <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <p class="text-primary-100 text-sm font-medium uppercase tracking-wider mb-1">Sistema de Gestão Eletrônica de Documentos</p>
        <h1 class="text-2xl md:text-3xl font-bold mb-2">Olá, <%= user.nome.split(' ')[0] %>!</h1>
        <p class="text-primary-100 text-sm md:text-base max-w-xl">Acompanhe protocolos, tramitações e documentos em um só lugar.</p>
      </div>
      <div class="flex-shrink-0 bg-white/15 backdrop-blur-sm rounded-xl px-5 py-4 border border-white/20">
        <p class="text-primary-100 text-xs font-semibold uppercase tracking-wider">Hoje</p>
        <p class="text-2xl font-bold"><%= new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' }) %></p>
        <p class="text-primary-200 text-sm"><%= new Date().getFullYear() %></p>
      </div>
    </div>
  </div>

  <!-- Cards de indicadores -->
  <div class="px-4 mb-6">
    <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">Indicadores</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/protocolo" class="group bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 p-4 hover:shadow-md hover:border-primary-200 dark:hover:border-primary-700 transition-all block">
        <div class="flex items-start justify-between mb-2">
          <div class="w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-900/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
          </div>
          <span class="text-xs font-semibold text-primary-600 dark:text-primary-400">Ativos</span>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm font-medium">Protocolos Ativos</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-0.5"><%= stats.protocolosAtivos %></p>
      </a>

      <a href="/tramitacao" class="group bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 p-4 hover:shadow-md hover:border-secondary-200 dark:hover:border-secondary-700 transition-all block">
        <div class="flex items-start justify-between mb-2">
          <div class="w-10 h-10 rounded-lg bg-secondary-100 dark:bg-secondary-900/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
          </div>
          <% if (stats.tramitacoesPendentes > 0) { %>
            <span class="text-xs font-semibold text-amber-600 dark:text-amber-400">Atenção</span>
          <% } else { %>
            <span class="text-xs font-semibold text-secondary-600 dark:text-secondary-400">Em dia</span>
          <% } %>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm font-medium">Tramitações Pendentes</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-0.5"><%= stats.tramitacoesPendentes %></p>
      </a>

      <a href="/documentos-pdf" class="group bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 p-4 hover:shadow-md hover:border-secondary-200 dark:hover:border-secondary-700 transition-all block">
        <div class="flex items-start justify-between mb-2">
          <div class="w-10 h-10 rounded-lg bg-secondary-100 dark:bg-secondary-900/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <span class="text-xs font-semibold text-secondary-600 dark:text-secondary-400">Este mês</span>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm font-medium">Documentos Gerados</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-0.5"><%= stats.documentosGeradosMes %></p>
      </a>

      <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 p-4">
        <div class="flex items-start justify-between mb-2">
          <div class="w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-900/40 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <% if (stats.assinaturasPendentes > 0) { %>
            <span class="text-xs font-semibold text-primary-600 dark:text-primary-400">Aguardando</span>
          <% } else { %>
            <span class="text-xs font-semibold text-secondary-600 dark:text-secondary-400">Nenhuma</span>
          <% } %>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm font-medium">Assinaturas Pendentes</p>
        <p class="text-2xl font-bold text-gray-900 dark:text-white mt-0.5"><%= stats.assinaturasPendentes %></p>
      </div>
    </div>
  </div>

  <!-- Ações rápidas -->
  <div class="px-4 mb-6">
    <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">Ações Rápidas</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <a href="/protocolo/novo" class="flex flex-col items-center justify-center p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-white text-center">Novo Protocolo</span>
      </a>
      <a href="/documentos-pdf/novo" class="flex flex-col items-center justify-center p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-secondary-300 dark:hover:border-secondary-600 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-secondary-500 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-white text-center">Criar Documento</span>
      </a>
      <a href="/tramitacao" class="flex flex-col items-center justify-center p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-white text-center">Ver Tramitações</span>
      </a>
      <a href="/contratos" class="flex flex-col items-center justify-center p-5 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 hover:border-secondary-300 dark:hover:border-secondary-600 hover:shadow-md transition-all group">
        <div class="w-12 h-12 rounded-xl bg-secondary-500 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 2v5a1 1 0 001 1h5"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-gray-900 dark:text-white text-center">Contratos</span>
      </a>
    </div>
  </div>

  <!-- Detalhamento de Orçamento -->
  <div class="px-4 mb-6">
    <%- include('../partials/detalhamento-orcamento', { planoTree: typeof planoTree !== 'undefined' ? planoTree : [], unidade: typeof unidade !== 'undefined' ? unidade : null, showLink: typeof showLink !== 'undefined' ? showLink : false }) %>
  </div>

  <!-- Protocolos recentes e Tramitações pendentes -->
  <div class="px-4 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-slate-700">
          <h2 class="text-base font-bold text-gray-900 dark:text-white">Protocolos Recentes</h2>
          <a href="/protocolo" class="text-sm font-semibold text-primary-600 dark:text-primary-400 hover:underline">Ver todos</a>
        </div>
        <div class="p-4 space-y-2 max-h-64 overflow-y-auto">
          <% if (protocolosRecentes && protocolosRecentes.length > 0) { %>
            <% protocolosRecentes.forEach(function(p) { %>
              <a href="/protocolo/<%= p.id %>" class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-slate-700/50 hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors block">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/40 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-gray-900 dark:text-white text-sm"><%= p.numero_protocolo || '—' %></p>
                    <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= p.tipo_documento %> — <%= p.data %></p>
                  </div>
                </div>
                <%
                  var statusClass = {
                    'em_tramite': 'bg-primary-100 text-primary-800 dark:bg-primary-900/50 dark:text-primary-200',
                    'pendente': 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200',
                    'arquivado': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
                    'encerrado': 'bg-secondary-100 text-secondary-800 dark:bg-secondary-900/50 dark:text-secondary-200',
                  }[p.status] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
                  var statusLabel = {
                    'em_tramite': 'Em Trâmite',
                    'pendente': 'Pendente',
                    'arquivado': 'Arquivado',
                    'encerrado': 'Encerrado',
                  }[p.status] || p.status;
                %>
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full flex-shrink-0 <%= statusClass %>"><%= statusLabel %></span>
              </a>
            <% }); %>
          <% } else { %>
            <p class="text-gray-500 dark:text-gray-400 text-sm text-center py-8">Nenhum protocolo encontrado.</p>
          <% } %>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-slate-700">
          <h2 class="text-base font-bold text-gray-900 dark:text-white">Tramitações Pendentes</h2>
          <a href="/tramitacao" class="text-sm font-semibold text-primary-600 dark:text-primary-400 hover:underline">Ver todas</a>
        </div>
        <div class="p-4 space-y-2 max-h-64 overflow-y-auto">
          <% if (tramitacoesPendentes && tramitacoesPendentes.length > 0) { %>
            <% tramitacoesPendentes.forEach(function(t) { %>
              <div class="flex items-center justify-between p-3 rounded-lg bg-gray-50 dark:bg-slate-700/50 hover:bg-secondary-50 dark:hover:bg-secondary-900/20 transition-colors">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-9 h-9 rounded-lg bg-secondary-100 dark:bg-secondary-900/40 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-gray-900 dark:text-white text-sm"><%= t.numero_protocolo || '—' %></p>
                    <p class="text-xs text-gray-500 dark:text-gray-400 truncate">Para: <%= t.destino_nome || 'Não definido' %> · <%= t.data_envio %></p>
                  </div>
                </div>
                <a href="/tramitacao" class="bg-secondary-500 hover:bg-secondary-600 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex-shrink-0">
                  Receber
                </a>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-gray-500 dark:text-gray-400 text-sm text-center py-8">Nenhuma tramitação pendente.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
