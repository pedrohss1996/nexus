<%- include('../partials/header', { title: 'Início - Nexus', user: typeof user !== 'undefined' ? user : null }) %>
<%
  // ── Dados da tela ───────────────────────────────────────────────────────
  var fila = (typeof tarefas !== 'undefined' && tarefas) ? tarefas : { itens: [], total: 0, atrasadasVisiveis: 0 };
  var nomeUnidade = (typeof unidade !== 'undefined' && unidade && unidade.nome) ? unidade.nome : '';
  var tz = 'America/Sao_Paulo';
  var hoje = new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: tz });

  // Prazo em palavras, contado em dias de calendário no fuso de Brasília
  function diaBR(d) { return new Date(new Date(d).toLocaleString('en-US', { timeZone: tz })).setHours(0, 0, 0, 0); }
  function prazoTexto(prazo) {
    if (!prazo) return { texto: 'Sem prazo', atrasado: false };
    var dias = Math.round((diaBR(prazo) - diaBR(new Date())) / 86400000);
    if (dias < 0) return { texto: 'Atrasada há ' + (-dias) + (dias === -1 ? ' dia' : ' dias'), atrasado: true };
    if (dias === 0) return { texto: 'Vence hoje', atrasado: false, hoje: true };
    if (dias === 1) return { texto: 'Vence amanhã', atrasado: false };
    return { texto: 'Vence em ' + dias + ' dias', atrasado: false };
  }
  function dataCurta(d) { return d ? new Date(d).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', timeZone: tz }) : '—'; }

  var acoes = { aprovacao: 'Aprovar', parecer_tecnico: 'Dar parecer', questionario: 'Responder' };

  var statusProtocolo = {
    aguardando: { label: 'Aguardando', cls: 'pill-warn' },
    pendente:   { label: 'Pendente',   cls: 'pill-warn' },
    em_tramite: { label: 'Em trâmite', cls: 'pill-info' },
    arquivado:  { label: 'Arquivado',  cls: 'pill-neutral' },
    encerrado:  { label: 'Encerrado',  cls: 'pill-neutral' }
  };

  // Plano de contas: quanto do orçamento de cada conta raiz já foi distribuído
  var roots = (typeof planoTree !== 'undefined' && planoTree) ? planoTree : [];
  var totalOrcado = roots.reduce(function (s, r) { return s + (parseFloat(r.valor) || 0); }, 0);
  var totalDistribuido = roots.reduce(function (s, r) { return s + (parseFloat(r.valor) || 0) - (parseFloat(r.disponivel) || 0); }, 0);
  function brl(v) { return (parseFloat(v) || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
  function pct(a, b) { return b > 0 ? Math.round((a / b) * 100) : 0; }
%>

<div class="dash">
  <!-- Título: o nome da tela, a unidade e o que pede atenção -->
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold tracking-tight text-ink">Início</h1>
      <p class="mt-1 text-sm text-muted">
        <% if (nomeUnidade) { %><span class="text-ink"><%= nomeUnidade %></span> · <% } %><%= hoje %>
      </p>
    </div>
    <div class="flex gap-2">
      <a href="/protocolo/novo" class="btn-secondary">Novo protocolo</a>
      <a href="/documentos-pdf" class="btn-secondary">Gerar documento</a>
    </div>
  </div>

  <% if (fila.total > 0) { %>
    <p class="mt-4 text-[15px] text-ink">
      <strong class="font-semibold"><%= fila.total %> <%= fila.total === 1 ? 'tarefa espera' : 'tarefas esperam' %> por você</strong><% if (fila.atrasadasVisiveis > 0) { %>,
      <span class="font-semibold text-negative"><%= fila.atrasadasVisiveis %> <%= fila.atrasadasVisiveis === 1 ? 'atrasada' : 'atrasadas' %></span><% } %>.
    </p>
  <% } %>

  <!-- Indicadores: uma faixa, quatro números, cada um leva à sua lista -->
  <div class="dash-kpis mt-6">
    <a href="/processos/tarefas" class="dash-kpi">
      <span class="dash-kpi-label">Minhas tarefas</span>
      <span class="dash-kpi-value"><%= fila.total %></span>
    </a>
    <a href="/assinaturas-doc/pendentes" class="dash-kpi">
      <span class="dash-kpi-label">Assinaturas pendentes</span>
      <span class="dash-kpi-value"><%= stats.assinaturasPendentes %></span>
    </a>
    <a href="/tramitacao" class="dash-kpi">
      <span class="dash-kpi-label">Tramitações a receber</span>
      <span class="dash-kpi-value"><%= stats.tramitacoesPendentes %></span>
    </a>
    <a href="/protocolo" class="dash-kpi">
      <span class="dash-kpi-label">Protocolos em aberto</span>
      <span class="dash-kpi-value"><%= stats.protocolosAtivos %></span>
    </a>
  </div>

  <div class="dash-grid mt-6">
    <!-- Bloco principal: a fila do usuário -->
    <section class="panel lg:col-span-8" aria-labelledby="t-tarefas">
      <header class="panel-head">
        <h2 id="t-tarefas" class="panel-title">Minhas tarefas</h2>
        <a href="/processos/tarefas" class="panel-link">Ver todas<% if (fila.total > fila.itens.length) { %> (<%= fila.total %>)<% } %></a>
      </header>
      <% if (fila.itens.length === 0) { %>
        <p class="panel-empty">Nenhuma etapa de processo esperando por você nesta unidade.
          <a href="/processos" class="panel-link">Ver processos</a></p>
      <% } else { %>
        <ul class="divide-y divide-line">
          <% fila.itens.forEach(function (t) { var pz = prazoTexto(t.prazo); %>
            <li>
              <a href="/processos/<%= t.processo_id %>" class="row-link grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-0.5 px-5 py-3">
                <span class="min-w-0">
                  <span class="block truncate text-sm font-medium text-ink"><%= t.titulo %></span>
                  <span class="block truncate text-[13px] text-muted">
                    <span class="num"><%= t.numero_processo %></span> · <%= t.etapa_nome %><% if (t.grupo_nome) { %> · <%= t.grupo_nome %><% } %>
                  </span>
                </span>
                <span class="text-right">
                  <span class="block text-sm <%= pz.atrasado ? 'font-medium text-negative' : (pz.hoje ? 'font-medium text-ink' : 'text-muted') %>"><%= pz.texto %></span>
                  <span class="block text-[13px] text-muted"><%= acoes[t.tipo_acao] || 'Concluir etapa' %><% if (t.exige_assinatura) { %> · exige assinatura<% } %></span>
                </span>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <!-- Ao lado: o que chegou de outra unidade e precisa ser recebido -->
    <section class="panel lg:col-span-4" aria-labelledby="t-tram">
      <header class="panel-head">
        <h2 id="t-tram" class="panel-title">Tramitações a receber</h2>
        <a href="/tramitacao" class="panel-link">Ver todas</a>
      </header>
      <% if (!tramitacoesPendentes || tramitacoesPendentes.length === 0) { %>
        <p class="panel-empty">Nada aguardando recebimento.</p>
      <% } else { %>
        <ul class="divide-y divide-line">
          <% tramitacoesPendentes.forEach(function (t) { %>
            <li>
              <a href="/protocolo/<%= t.protocolo_id %>" class="row-link flex items-center justify-between gap-3 px-5 py-3">
                <span class="min-w-0">
                  <span class="block truncate text-sm font-medium text-ink num"><%= t.numero_protocolo || '—' %></span>
                  <span class="block truncate text-[13px] text-muted"><%= t.tipo_documento %> · para <%= t.destino_nome || 'destino não definido' %></span>
                </span>
                <span class="shrink-0 text-[13px] text-muted num"><%= t.data_envio %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <!-- Protocolos recentes -->
    <section class="panel lg:col-span-7" aria-labelledby="t-prot">
      <header class="panel-head">
        <h2 id="t-prot" class="panel-title">Protocolos recentes</h2>
        <a href="/protocolo" class="panel-link">Ver todos</a>
      </header>
      <% if (!protocolosRecentes || protocolosRecentes.length === 0) { %>
        <p class="panel-empty">Nenhum protocolo registrado nesta unidade. <a href="/protocolo/novo" class="panel-link">Registrar protocolo</a></p>
      <% } else { %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line">
              <th class="px-5 py-2 text-left">Número</th>
              <th class="px-3 py-2 text-left">Assunto</th>
              <th class="px-3 py-2 text-left">Situação</th>
              <th class="px-5 py-2 text-right">Data</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% protocolosRecentes.forEach(function (p) { var st = statusProtocolo[p.status] || { label: p.status, cls: 'pill-neutral' }; %>
              <tr class="row-link">
                <td class="px-5 py-2.5 whitespace-nowrap"><a href="/protocolo/<%= p.id %>" class="font-medium text-ink hover:underline num"><%= p.numero_protocolo || '—' %></a></td>
                <td class="max-w-[16rem] truncate px-3 py-2.5 text-muted"><%= p.assunto || p.tipo_documento %></td>
                <td class="px-3 py-2.5"><span class="pill <%= st.cls %>"><%= st.label %></span></td>
                <td class="px-5 py-2.5 text-right text-muted num"><%= p.data %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <!-- Plano de contas da unidade -->
    <section class="panel lg:col-span-5" aria-labelledby="t-orc">
      <header class="panel-head">
        <h2 id="t-orc" class="panel-title">Plano de contas</h2>
        <% if (typeof unidade !== 'undefined' && unidade) { %>
          <a href="/unidades/<%= unidade.id %>/plano-contas" class="panel-link">Abrir plano</a>
        <% } %>
      </header>
      <% if (roots.length === 0) { %>
        <p class="panel-empty">Esta unidade ainda não tem plano de contas.
          <% if (typeof unidade !== 'undefined' && unidade) { %><a href="/unidades/<%= unidade.id %>/plano-contas" class="panel-link">Cadastrar contas</a><% } %></p>
      <% } else { %>
        <div class="px-5 pb-2 pt-1">
          <p class="text-sm text-muted">Orçado <span class="num font-semibold text-ink"><%= brl(totalOrcado) %></span></p>
          <p class="text-[13px] text-muted"><span class="num"><%= brl(totalDistribuido) %></span> distribuídos em subcontas (<span class="num"><%= pct(totalDistribuido, totalOrcado) %>%</span>)</p>
        </div>
        <ul class="px-5 pb-4">
          <% roots.slice(0, 5).forEach(function (c) {
               var v = parseFloat(c.valor) || 0; var dist = v - (parseFloat(c.disponivel) || 0); var p = pct(dist, v); %>
            <li class="py-2">
              <div class="flex items-baseline justify-between gap-3 text-sm">
                <span class="min-w-0 truncate text-ink"><span class="num text-muted"><%= c.codigo %></span> <%= c.nome %></span>
                <span class="num shrink-0 text-ink"><%= brl(v) %></span>
              </div>
              <div class="mt-1.5 h-1.5 rounded-full bg-active" role="img" aria-label="<%= p %>% distribuído">
                <div class="h-full rounded-full bg-primary-500" style="width: <%= Math.min(p, 100) %>%"></div>
              </div>
            </li>
          <% }); %>
          <% if (roots.length > 5) { %><li class="pt-1 text-[13px] text-muted">e mais <%= roots.length - 5 %> contas</li><% } %>
        </ul>
      <% } %>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
