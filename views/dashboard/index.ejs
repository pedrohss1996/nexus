<%- include('../partials/header', { title: 'DataFlow - Sistema de Gestão Eletrônica de Documentos', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full px-6 py-4 space-y-3">
  <!-- Bem-vindo -->
  <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-lg shadow p-4 text-white">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold mb-0.5">Bem-vindo ao DataFlow, <%= user.nome.split(' ')[0] %>!</h1>
        <p class="text-blue-100 text-sm">Sistema de Gestão Eletrônica de Documentos</p>
      </div>
      <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2">
        <div class="text-center">
          <p class="text-xs text-blue-100 mb-0">Data de Hoje</p>
          <p class="text-lg font-bold"><%= new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' }) %></p>
          <p class="text-xs text-blue-100"><%= new Date().getFullYear() %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Cards de Estatísticas -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <!-- Protocolos Ativos -->
    <a href="/protocolo" class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3 hover:shadow-md transition-shadow block">
      <div class="flex items-center justify-between mb-1">
        <div class="bg-blue-100 dark:bg-blue-900 p-2 rounded">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
        </div>
        <span class="text-xs text-blue-600 dark:text-blue-400 font-semibold">Ativos</span>
      </div>
      <h3 class="text-gray-500 dark:text-gray-400 text-xs font-medium mb-0">Protocolos Ativos</h3>
      <p class="text-xl font-bold text-gray-900 dark:text-white"><%= stats.protocolosAtivos %></p>
    </a>

    <!-- Tramitações Pendentes -->
    <a href="/tramitacao" class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3 hover:shadow-md transition-shadow block">
      <div class="flex items-center justify-between mb-1">
        <div class="bg-yellow-100 dark:bg-yellow-900 p-2 rounded">
          <svg class="w-5 h-5 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </div>
        <% if (stats.tramitacoesPendentes > 0) { %>
          <span class="text-xs text-red-600 dark:text-red-400 font-semibold">Atenção!</span>
        <% } else { %>
          <span class="text-xs text-green-600 dark:text-green-400 font-semibold">Em dia</span>
        <% } %>
      </div>
      <h3 class="text-gray-500 dark:text-gray-400 text-xs font-medium mb-0">Tramitações Pendentes</h3>
      <p class="text-xl font-bold text-gray-900 dark:text-white"><%= stats.tramitacoesPendentes %></p>
    </a>

    <!-- Documentos Gerados (mês) -->
    <a href="/documentos-pdf" class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3 hover:shadow-md transition-shadow block">
      <div class="flex items-center justify-between mb-1">
        <div class="bg-green-100 dark:bg-green-900 p-2 rounded">
          <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <span class="text-xs text-green-600 dark:text-green-400 font-semibold">Este mês</span>
      </div>
      <h3 class="text-gray-500 dark:text-gray-400 text-xs font-medium mb-0">Documentos Gerados</h3>
      <p class="text-xl font-bold text-gray-900 dark:text-white"><%= stats.documentosGeradosMes %></p>
    </a>

    <!-- Assinaturas Pendentes -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-1">
        <div class="bg-purple-100 dark:bg-purple-900 p-2 rounded">
          <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <% if (stats.assinaturasPendentes > 0) { %>
          <span class="text-xs text-purple-600 dark:text-purple-400 font-semibold">Aguardando</span>
        <% } else { %>
          <span class="text-xs text-green-600 dark:text-green-400 font-semibold">Nenhuma</span>
        <% } %>
      </div>
      <h3 class="text-gray-500 dark:text-gray-400 text-xs font-medium mb-0">Assinaturas Pendentes</h3>
      <p class="text-xl font-bold text-gray-900 dark:text-white"><%= stats.assinaturasPendentes %></p>
    </div>
  </div>

  <!-- Ações Rápidas -->
  <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
    <h2 class="text-base font-bold text-gray-900 dark:text-white mb-3">Ações Rápidas</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
      <a href="/protocolo/novo" class="flex flex-col items-center justify-center p-3 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-lg hover:shadow-md transition-all group">
        <div class="bg-blue-600 dark:bg-blue-500 p-2 rounded-lg mb-2 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
        </div>
        <span class="text-xs font-semibold text-gray-900 dark:text-white text-center">Novo Protocolo</span>
      </a>

      <a href="/documentos-pdf/novo" class="flex flex-col items-center justify-center p-3 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg hover:shadow-md transition-all group">
        <div class="bg-green-600 dark:bg-green-500 p-2 rounded-lg mb-2 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <span class="text-xs font-semibold text-gray-900 dark:text-white text-center">Criar Documento</span>
      </a>

      <a href="/tramitacao" class="flex flex-col items-center justify-center p-3 bg-gradient-to-br from-yellow-50 to-amber-50 dark:from-yellow-900/20 dark:to-amber-900/20 rounded-lg hover:shadow-md transition-all group">
        <div class="bg-yellow-600 dark:bg-yellow-500 p-2 rounded-lg mb-2 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
        </div>
        <span class="text-xs font-semibold text-gray-900 dark:text-white text-center">Ver Tramitações</span>
      </a>

      <a href="/contratos" class="flex flex-col items-center justify-center p-3 bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-lg hover:shadow-md transition-all group">
        <div class="bg-purple-600 dark:bg-purple-500 p-2 rounded-lg mb-2 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 2v5a1 1 0 001 1h5"></path>
          </svg>
        </div>
        <span class="text-xs font-semibold text-gray-900 dark:text-white text-center">Contratos</span>
      </a>
    </div>
  </div>

  <!-- Detalhamento de Orçamento (Plano de Contas da unidade selecionada) -->
  <div>
    <%- include('../partials/detalhamento-orcamento', { planoTree: typeof planoTree !== 'undefined' ? planoTree : [], unidade: typeof unidade !== 'undefined' ? unidade : null, showLink: typeof showLink !== 'undefined' ? showLink : false }) %>
  </div>

  <!-- Protocolos Recentes & Tramitações Pendentes -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
    <!-- Protocolos Recentes -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-bold text-gray-900 dark:text-white">Protocolos Recentes</h2>
        <a href="/protocolo" class="text-blue-600 dark:text-blue-400 text-xs font-semibold hover:underline">Ver todos</a>
      </div>
      <div class="space-y-2">
        <% if (protocolosRecentes && protocolosRecentes.length > 0) { %>
          <% protocolosRecentes.forEach(function(p) { %>
            <a href="/protocolo/<%= p.id %>" class="flex items-center justify-between p-2 bg-gray-50 dark:bg-slate-700 rounded hover:bg-gray-100 dark:hover:bg-slate-600 transition-colors block">
              <div class="flex items-center space-x-2 min-w-0">
                <div class="bg-blue-100 dark:bg-blue-900 p-1.5 rounded flex-shrink-0">
                  <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-gray-900 dark:text-white text-xs"><%= p.numero_protocolo || '—' %></p>
                  <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= p.tipo_documento %> — <%= p.data %></p>
                </div>
              </div>
              <%
                var statusClass = {
                  'em_tramite': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
                  'pendente': 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
                  'arquivado': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
                  'encerrado': 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
                }[p.status] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
                var statusLabel = {
                  'em_tramite': 'Em Trâmite',
                  'pendente': 'Pendente',
                  'arquivado': 'Arquivado',
                  'encerrado': 'Encerrado',
                }[p.status] || p.status;
              %>
              <span class="px-2 py-0.5 text-xs font-semibold rounded-full flex-shrink-0 <%= statusClass %>"><%= statusLabel %></span>
            </a>
          <% }); %>
        <% } else { %>
          <p class="text-gray-500 dark:text-gray-400 text-sm text-center py-4">Nenhum protocolo encontrado.</p>
        <% } %>
      </div>
    </div>

    <!-- Tramitações Pendentes -->
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-bold text-gray-900 dark:text-white">Tramitações Pendentes</h2>
        <a href="/tramitacao" class="text-blue-600 dark:text-blue-400 text-xs font-semibold hover:underline">Ver todas</a>
      </div>
      <div class="space-y-2">
        <% if (tramitacoesPendentes && tramitacoesPendentes.length > 0) { %>
          <% tramitacoesPendentes.forEach(function(t) { %>
            <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-slate-700 rounded hover:bg-gray-100 dark:hover:bg-slate-600 transition-colors">
              <div class="flex items-center space-x-2 min-w-0">
                <div class="bg-yellow-100 dark:bg-yellow-900 p-1.5 rounded flex-shrink-0">
                  <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-gray-900 dark:text-white text-xs"><%= t.numero_protocolo || '—' %></p>
                  <p class="text-xs text-gray-500 dark:text-gray-400 truncate">Para: <%= t.destino_nome || 'Não definido' %> &bull; <%= t.data_envio %></p>
                </div>
              </div>
              <a href="/tramitacao" class="bg-green-600 hover:bg-green-700 text-white px-2 py-0.5 rounded text-xs font-semibold transition-colors flex-shrink-0">
                Receber
              </a>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-gray-500 dark:text-gray-400 text-sm text-center py-4">Nenhuma tramitação pendente.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
