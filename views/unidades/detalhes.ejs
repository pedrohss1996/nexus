<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Detalhes da Unidade - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-600">
    <a href="/unidades" class="hover:text-teal-600">Unidades</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900"><%= unidade.nome %></span>
  </nav>

  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-lg text-sm">
      <% if (erro === 'conta_duplicada') { %>Código de conta contábil já existe nesta unidade.<% } %>
      <% if (erro === 'grupo_nome_obrigatorio') { %>Nome do grupo é obrigatório.<% } %>
      <% if (erro === 'grupo_usuario_obrigatorio') { %>Selecione grupo e usuário.<% } %>
      <% if (erro === 'usuario_ja_no_grupo') { %>Este usuário já está neste grupo.<% } %>
    </div>
  <% } %>

  <!-- Cabeçalho -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex justify-between items-start">
      <div class="flex-1">
        <div class="flex items-center mb-2">
          <% if (unidade.cd_tipo == 1) { %>
            <svg class="w-8 h-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          <% } else if (unidade.cd_tipo == 2) { %>
            <svg class="w-8 h-8 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          <% } else { %>
            <svg class="w-8 h-8 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          <% } %>
          <span class="text-sm font-semibold text-gray-500 uppercase">
            <%= unidade.cd_tipo == 1 ? 'Hospital' : unidade.cd_tipo == 2 ? 'Clínica' : 'Departamento' %>
          </span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-4"><%= unidade.nome %></h1>
        
        <!-- Estatísticas -->
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-blue-50 rounded-lg p-4">
            <div class="text-2xl font-bold text-blue-600"><%= estatisticas.total_grupos %></div>
            <div class="text-sm text-gray-600">Grupos</div>
          </div>
          <div class="bg-green-50 rounded-lg p-4">
            <div class="text-2xl font-bold text-green-600"><%= estatisticas.total_usuarios %></div>
            <div class="text-sm text-gray-600">Usuários</div>
          </div>
          <div class="bg-purple-50 rounded-lg p-4">
            <div class="text-2xl font-bold text-purple-600"><%= estatisticas.total_processos %></div>
            <div class="text-sm text-gray-600">Processos</div>
          </div>
        </div>
      </div>
      <% if (user.perfil === 'admin') { %>
        <a href="/unidades/<%= unidade.id %>/editar" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors text-sm font-medium flex items-center">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Editar
        </a>
      <% } %>
    </div>
  </div>

  <!-- Detalhamento de Orçamento (card como na tela inicial) -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Plano de Contas</h2>
    <%- include('../partials/detalhamento-orcamento', { planoTree: typeof planoTree !== 'undefined' ? planoTree : [], unidade: typeof unidade !== 'undefined' ? unidade : null, showLink: true }) %>
  </div>

  <!-- Cadastro do Plano de Contas (na própria tela da unidade) -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Cadastro do Plano de Contas</h2>
      <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
        <a href="/unidades/<%= unidade.id %>/plano-contas" class="text-cyan-600 hover:text-cyan-700 text-sm font-medium">Abrir em tela cheia</a>
      <% } %>
    </div>
    <div id="plano-alerta-unidade" class="hidden rounded-lg p-3 text-xs border bg-amber-50 border-amber-200 text-amber-800 mb-3"></div>
    <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
      <div id="plano-add-raiz-wrap" class="mb-3"></div>
    <% } %>
    <div id="plano-contas-tree" class="space-y-2"></div>
  </div>
  <script>
    window.__PLANO_TREE__ = <%- JSON.stringify(typeof planoTree !== 'undefined' ? planoTree : []) %>;
    window.__UNIDADE_ID__ = '<%= unidade.id %>';
    window.__CAN_EDIT__ = <%= (user && (user.perfil === 'admin' || user.perfil === 'gestor')) ? 'true' : 'false' %>;
    window.__CONTAINER_ALERT_ID__ = 'plano-alerta-unidade';
  </script>
  <script src="/js/plano-contas.js"></script>

  <!-- Grupos da Unidade -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Grupos</h2>
      <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
        <a href="/grupos/novo?unidade_id=<%= unidade.id %>" class="text-teal-600 hover:text-teal-700 font-medium text-sm flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Novo Grupo (página completa)
        </a>
      <% } %>
    </div>
    <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
      <form method="POST" action="/unidades/<%= unidade.id %>/grupos" class="flex flex-wrap items-end gap-3 mb-6 p-4 bg-gray-50 rounded-lg">
        <div class="flex-1 min-w-[200px]">
          <label for="grupo_nome" class="block text-xs font-medium text-gray-600 mb-1">Nome do grupo</label>
          <input type="text" id="grupo_nome" name="nome" required placeholder="Ex: Farmácia, TI..." class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500">
        </div>
        <div class="flex-[2] min-w-[200px]">
          <label for="grupo_descricao" class="block text-xs font-medium text-gray-600 mb-1">Descrição (opcional)</label>
          <input type="text" id="grupo_descricao" name="descricao" placeholder="Breve descrição" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500">
        </div>
        <button type="submit" class="bg-teal-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-teal-700">Criar grupo</button>
      </form>
    <% } %>
    
    <% if (grupos.length === 0) { %>
      <div class="text-center py-8">
        <p class="text-gray-600">Nenhum grupo cadastrado nesta unidade.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% grupos.forEach(grupo => { %>
          <a href="/grupos/<%= grupo.id %>" class="border border-gray-200 rounded-lg p-4 hover:border-teal-500 hover:shadow-sm transition-all">
            <h3 class="font-semibold text-gray-900 mb-1"><%= grupo.nome %></h3>
            <p class="text-sm text-gray-600 mb-2 line-clamp-2"><%= grupo.descricao || 'Sem descrição' %></p>
            <div class="flex items-center text-sm text-gray-500">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <%= grupo.total_membros %> membro<%= grupo.total_membros != 1 ? 's' : '' %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Vincular usuário ao grupo -->
  <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Vincular usuário ao grupo</h2>
    <% if (grupos.length > 0 && typeof todosUsuarios !== 'undefined' && todosUsuarios.length > 0) { %>
      <form method="POST" action="/unidades/<%= unidade.id %>/usuarios-grupos" class="flex flex-wrap items-end gap-3 p-4 bg-gray-50 rounded-lg">
        <div class="flex-1 min-w-[180px]">
          <label for="vinculo_grupo_id" class="block text-xs font-medium text-gray-600 mb-1">Grupo</label>
          <select id="vinculo_grupo_id" name="grupo_id" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500">
            <option value="">Selecione o grupo</option>
            <% grupos.forEach(g => { %>
              <option value="<%= g.id %>"><%= g.nome %></option>
            <% }); %>
          </select>
        </div>
        <div class="flex-1 min-w-[180px]">
          <label for="vinculo_usuario_id" class="block text-xs font-medium text-gray-600 mb-1">Usuário</label>
          <select id="vinculo_usuario_id" name="usuario_id" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-teal-500">
            <option value="">Selecione o usuário</option>
            <% todosUsuarios.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.nome %> (<%= u.email %>)</option>
            <% }); %>
          </select>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="is_lider" name="is_lider" value="true" class="rounded border-gray-300 text-teal-600 focus:ring-teal-500">
          <label for="is_lider" class="text-sm text-gray-600">Líder do grupo</label>
        </div>
        <button type="submit" class="bg-teal-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-teal-700">Vincular</button>
      </form>
    <% } else { %>
      <p class="text-gray-500 text-sm">Crie pelo menos um grupo e certifique-se de que existem usuários no sistema para vincular.</p>
    <% } %>
  </div>
  <% } %>

  <!-- Usuários da Unidade -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-6">Usuários</h2>
    
    <% if (usuarios.length === 0) { %>
      <div class="text-center py-8">
        <p class="text-gray-600">Nenhum usuário vinculado a esta unidade.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% usuarios.forEach(usuario => { %>
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center mb-2">
              <div class="w-10 h-10 bg-gradient-to-br from-teal-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-semibold text-sm mr-3">
                <%= usuario.nome.charAt(0).toUpperCase() %>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-gray-900 truncate"><%= usuario.nome %></h3>
                <p class="text-xs text-gray-600 truncate"><%= usuario.email %></p>
              </div>
            </div>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= usuario.perfil === 'admin' ? 'bg-red-100 text-red-800' : usuario.perfil === 'gestor' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
              <%= usuario.perfil %>
            </span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
