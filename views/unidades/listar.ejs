<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Unidades - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<%
  function tipoLabel(cd) {
    if (cd == 1) return 'Hospital';
    if (cd == 2) return 'Clínica';
    if (cd == 3) return 'Departamento';
    if (cd == 4) return '★ Principal';
    return 'Unidade';
  }
  function tipoColor(cd) {
    if (cd == 1) return 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300';
    if (cd == 2) return 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300';
    if (cd == 4) return 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 font-bold';
    return 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300';
  }
%>

<div class="w-full px-6 py-6 space-y-5">
  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">Unidades</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Unidades, hospitais, clínicas e departamentos cadastrados</p>
    </div>
    <% if (user.perfil === 'admin') { %>
      <a href="/unidades/novo" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nova Unidade
      </a>
    <% } %>
  </div>

  <!-- Filtros -->
  <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
    <form method="GET" action="/unidades" class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[150px]">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Tipo</label>
        <select name="cd_tipo" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
          <option value="">Todos os tipos</option>
          <option value="4" <%= filtros.cd_tipo == 4 ? 'selected' : '' %>>★ Principal</option>
          <option value="1" <%= filtros.cd_tipo == 1 ? 'selected' : '' %>>Hospital</option>
          <option value="2" <%= filtros.cd_tipo == 2 ? 'selected' : '' %>>Clínica</option>
          <option value="3" <%= filtros.cd_tipo == 3 ? 'selected' : '' %>>Departamento</option>
        </select>
      </div>
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Buscar</label>
        <input type="text" name="busca" value="<%= filtros.busca || '' %>" placeholder="Nome da unidade..." class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
      </div>
      <div class="flex gap-2">
        <button type="submit" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg text-sm font-medium transition-colors">Filtrar</button>
        <a href="/unidades" class="px-4 py-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium transition-colors">Limpar</a>
      </div>
    </form>
  </div>

  <!-- Tabela de Unidades -->
  <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
    <% if (unidades.length === 0) { %>
      <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
        <div class="bg-gray-100 dark:bg-slate-700 rounded-full p-4 mb-4">
          <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Nenhuma unidade encontrada</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Não há unidades cadastradas com os filtros aplicados.</p>
        <% if (user.perfil === 'admin') { %>
          <a href="/unidades/novo" class="inline-flex items-center gap-1.5 text-sm text-cyan-600 dark:text-cyan-400 font-medium hover:underline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Cadastrar primeira unidade
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Unidade</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden sm:table-cell">Tipo</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
            <% unidades.forEach(unidade => { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/40 transition-colors<%= unidade.cd_tipo == 4 ? ' bg-amber-50/40 dark:bg-amber-900/10' : '' %>" id="row-unidade-<%= unidade.id %>">
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 <%= unidade.cd_tipo == 4 ? 'bg-amber-100 dark:bg-amber-900/40' : 'bg-indigo-100 dark:bg-indigo-900/40' %> rounded-lg flex items-center justify-center flex-shrink-0">
                      <% if (unidade.cd_tipo == 4) { %>
                        <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <% } else { %>
                        <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                      <% } %>
                    </div>
                    <div>
                      <p class="text-sm font-semibold <%= unidade.cd_tipo == 4 ? 'text-amber-700 dark:text-amber-300' : 'text-gray-900 dark:text-white' %>"><%= unidade.nome %></p>
                      <span class="text-xs sm:hidden <%= tipoColor(unidade.cd_tipo) %> px-1.5 py-0.5 rounded font-medium"><%= tipoLabel(unidade.cd_tipo) %></span>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3.5 hidden sm:table-cell">
                  <span class="px-2 py-0.5 text-xs font-semibold rounded-full <%= tipoColor(unidade.cd_tipo) %>">
                    <%= tipoLabel(unidade.cd_tipo) %>
                  </span>
                </td>
                <td class="px-5 py-3.5">
                  <div class="flex items-center justify-center gap-1">
                    <a href="/unidades/<%= unidade.id %>" title="Ver detalhes" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-cyan-50 dark:hover:bg-cyan-900/30 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </a>
                    <% if (user.perfil === 'admin') { %>
                      <a href="/unidades/<%= unidade.id %>/editar" title="Editar" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      </a>
                      <button type="button" title="Excluir" data-action="excluir-unidade" data-id="<%= unidade.id %>" data-nome="<%= unidade.nome %>" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-red-50 dark:hover:bg-red-900/30 hover:text-red-600 dark:hover:text-red-400 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="px-5 py-3 border-t border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/30">
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= unidades.length %> unidade<%= unidades.length !== 1 ? 's' : '' %> encontrada<%= unidades.length !== 1 ? 's' : '' %></p>
      </div>
    <% } %>
  </div>
</div>

<% if (user.perfil === 'admin') { %>
<script>
document.addEventListener('click', async function(e) {
  var btn = e.target.closest('[data-action="excluir-unidade"]');
  if (!btn) return;
  var id = btn.dataset.id;
  var nome = btn.dataset.nome;
  if (!confirm('Desativar a unidade "' + nome + '"?\n\nOs grupos e usuários vinculados serão preservados.')) return;
  btn.disabled = true;
  try {
    var r = await fetch('/unidades/' + id, {
      method: 'DELETE',
      credentials: 'include',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    });
    var data;
    try { data = await r.json(); } catch(e) { data = { success: false, message: 'Resposta inesperada do servidor (HTTP ' + r.status + ')' }; }
    if (data && data.success) {
      var row = document.getElementById('row-unidade-' + id);
      if (row) row.remove();
      if (window.showToast) showToast('Unidade "' + nome + '" desativada com sucesso.', 'success');
    } else {
      btn.disabled = false;
      if (window.showToast) showToast((data && data.message) || 'Erro ao desativar unidade.', 'error');
    }
  } catch (err) {
    btn.disabled = false;
    if (window.showToast) showToast('Erro de conexão: ' + err.message, 'error');
  }
});
</script>
<% } %>

<%- include('../partials/footer') %>
