<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Unidade - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full px-6 py-6">
  <div class="max-w-xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-5">
      <a href="/unidades" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Unidades</a>
      <svg class="w-4 h-4 mx-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-900 dark:text-white font-medium"><%= unidade ? 'Editar unidade' : 'Nova unidade' %></span>
    </nav>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700">
        <h1 class="text-lg font-bold text-gray-900 dark:text-white"><%= unidade ? 'Editar unidade' : 'Nova unidade' %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5"><%= unidade ? 'Altere os dados da unidade.' : 'Preencha as informações da nova unidade.' %></p>
      </div>

      <form method="POST" action="<%= unidade ? `/unidades/${unidade.id}` : '/unidades' %>" class="p-6 space-y-5">
        <div>
          <label for="nome" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
            Nome da Unidade <span class="text-red-500">*</span>
          </label>
          <input type="text" id="nome" name="nome" value="<%= unidade ? unidade.nome : '' %>" required maxlength="255"
            placeholder="Ex: Hospital São Lucas, Clínica Ortopédica..."
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
            Tipo <span class="text-red-500">*</span>
          </label>
          <!-- Tipo Principal em destaque -->
          <div class="mb-3">
            <label class="cursor-pointer block">
              <input type="radio" name="cd_tipo" value="4" <%= unidade && unidade.cd_tipo == 4 ? 'checked' : '' %> required class="sr-only peer">
              <div class="flex items-center gap-3 p-3 rounded-lg border-2 border-amber-200 dark:border-amber-700 peer-checked:border-amber-500 peer-checked:bg-amber-50 dark:peer-checked:bg-amber-900/20 hover:border-amber-400 dark:hover:border-amber-500 transition-colors">
                <svg class="w-6 h-6 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <div>
                  <span class="text-sm font-bold text-amber-700 dark:text-amber-300">Principal</span>
                  <p class="text-xs text-amber-600 dark:text-amber-400">Unidade raiz / matriz da organização</p>
                </div>
              </div>
            </label>
          </div>
          <!-- Outros tipos -->
          <div class="grid grid-cols-3 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="cd_tipo" value="1" <%= unidade && unidade.cd_tipo == 1 ? 'checked' : '' %> class="sr-only peer">
              <div class="flex flex-col items-center justify-center p-3 rounded-lg border-2 border-gray-200 dark:border-slate-600 peer-checked:border-cyan-500 peer-checked:bg-cyan-50 dark:peer-checked:bg-cyan-900/20 hover:border-cyan-300 dark:hover:border-cyan-700 transition-colors text-center">
                <svg class="w-6 h-6 text-blue-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300">Hospital</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="cd_tipo" value="2" <%= unidade && unidade.cd_tipo == 2 ? 'checked' : '' %> class="sr-only peer">
              <div class="flex flex-col items-center justify-center p-3 rounded-lg border-2 border-gray-200 dark:border-slate-600 peer-checked:border-cyan-500 peer-checked:bg-cyan-50 dark:peer-checked:bg-cyan-900/20 hover:border-cyan-300 dark:hover:border-cyan-700 transition-colors text-center">
                <svg class="w-6 h-6 text-green-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300">Clínica</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="cd_tipo" value="3" <%= unidade && unidade.cd_tipo == 3 ? 'checked' : '' %> class="sr-only peer">
              <div class="flex flex-col items-center justify-center p-3 rounded-lg border-2 border-gray-200 dark:border-slate-600 peer-checked:border-cyan-500 peer-checked:bg-cyan-50 dark:peer-checked:bg-cyan-900/20 hover:border-cyan-300 dark:hover:border-cyan-700 transition-colors text-center">
                <svg class="w-6 h-6 text-purple-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300">Departamento</span>
              </div>
            </label>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-slate-700">
          <a href="<%= unidade ? `/unidades/${unidade.id}` : '/unidades' %>" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white font-medium transition-colors">
            Cancelar
          </a>
          <button type="submit" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <%= unidade ? 'Salvar alterações' : 'Criar unidade' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
