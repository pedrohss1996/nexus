<!-- MODAL: Adicionar etapa                    -->
<!-- ══════════════════════════════════════════ -->
<div id="modalEtapa" style="display:none;position:fixed;inset:0;z-index:60;overflow-y:auto;">
  <div style="display:flex;min-height:100%;align-items:center;justify-content:center;padding:16px;">
    <div id="modalEtapaBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.5);"></div>
    <div style="position:relative;background:#fff;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:480px;overflow:hidden;" class="dark:bg-slate-800">
      <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;" class="dark:border-slate-700">
        <h3 style="font-size:16px;font-weight:700;color:#1e293b;margin:0;" class="dark:text-white">Adicionar etapa</h3>
      </div>
      <form method="POST" action="/fluxos/<%= f.id %>/etapas" style="padding:20px;display:flex;flex-direction:column;gap:14px;">
        <!-- Tipo visual — event delegation via #novoTipoGrid -->
        <div>
          <label class="fl-label">Tipo *</label>
          <div class="tipo-grid" id="novoTipoGrid">
            <div class="tipo-opt sel" data-novo-tipo="questionario" style="border-color:#6366f1;background:#eef2ff;">
              <div class="tipo-opt-icon">📋</div>
              <span class="tipo-opt-label">Questionário</span>
            </div>
            <div class="tipo-opt" data-novo-tipo="aprovacao">
              <div class="tipo-opt-icon">✅</div>
              <span class="tipo-opt-label">Aprovação</span>
            </div>
            <div class="tipo-opt" data-novo-tipo="parecer">
              <div class="tipo-opt-icon">💬</div>
              <span class="tipo-opt-label">Parecer</span>
            </div>
          </div>
          <!-- Campo hidden que vai para o form -->
          <input type="hidden" name="tipo_acao" id="novoTipoValor" value="questionario">
        </div>
        <div>
          <label class="fl-label">Grupo (setor) *</label>
          <select name="proprietario_id" required class="fl-select">
            <option value="">— Selecionar grupo —</option>
            <% gruposList.forEach(function(g) { %><option value="<%= g.id %>"><%= g.nome %></option><% }); %>
          </select>
        </div>
        <div>
          <label class="fl-label">Nome da etapa *</label>
          <input type="text" name="nome" required maxlength="255" placeholder="Ex: Validar documentação" class="fl-input" id="novaNome">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div>
            <label class="fl-label">Código (opcional)</label>
            <input type="text" name="codigo" maxlength="80" placeholder="Auto" class="fl-input" style="font-family:monospace;">
          </div>
          <div>
            <label class="fl-label">Prazo (dias)</label>
            <input type="number" name="prazo_em_dias" min="0" placeholder="Opcional" class="fl-input">
          </div>
        </div>
        <div style="display:flex;gap:8px;padding-top:4px;">
          <button type="submit" style="flex:1;padding:10px;background:#4f46e5;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">Criar etapa</button>
          <button type="button" id="btnFecharModalEtapa" style="padding:10px 16px;border:1px solid #e2e8f0;background:#fff;color:#475569;border-radius:8px;font-size:13px;cursor:pointer;" class="dark:bg-slate-900 dark:border-slate-700 dark:text-slate-400">Cancelar</button>
        </div>
      </form>
    </div>
  </div>
</div>

