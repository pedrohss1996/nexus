  (function initModalListeners() {
    var mq = document.getElementById('modalQ-perguntas');
    if (!mq) return;
    function mqHandle(e) {
      var el = e.target.closest('[data-mq]');
      if (!el) return;
      var a  = el.dataset.mq;
      var i  = parseInt(el.dataset.i, 10);
      var oi = parseInt(el.dataset.oi, 10);
      var tipos3 = ['radio','checkbox','selecao'];
      if (a==='lbl'     && e.type==='input')  { _perguntasTemp[i].label = el.value; return; }
      if (a==='req'     && e.type==='change') { _perguntasTemp[i].obrigatorio = el.checked; return; }
      if (a==='opt-val' && e.type==='input')  {
        if (!_perguntasTemp[i].opcoes) _perguntasTemp[i].opcoes = [];
        _perguntasTemp[i].opcoes[oi] = el.value; return;
      }
      if (a==='tipo' && e.type==='change') {
        _perguntasTemp[i].tipo = el.value;
        _perguntasTemp[i].opcoes = (tipos3.indexOf(el.value)>=0) ? (_perguntasTemp[i].opcoes||['']) : undefined;
        renderModalPerguntas(); return;
      }
      if (a==='rm-q'    && e.type==='click') { _perguntasTemp.splice(i,1); renderModalPerguntas(); return; }
      if (a==='add-opt' && e.type==='click') {
        if (!_perguntasTemp[i].opcoes) _perguntasTemp[i].opcoes = [];
        _perguntasTemp[i].opcoes.push(''); renderModalPerguntas(); return;
      }
      if (a==='rm-opt'  && e.type==='click') {
        _perguntasTemp[i].opcoes.splice(oi,1); renderModalPerguntas(); return;
      }
    }
    mq.addEventListener('input',  mqHandle);
    mq.addEventListener('change', mqHandle);
    mq.addEventListener('click',  mqHandle);
  })();

