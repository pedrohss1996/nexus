<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Configurar Fluxo - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>
<%
  const f = fluxo || {};
  const etapasList = typeof etapas !== 'undefined' ? etapas : [];
  const edgesList  = typeof edges  !== 'undefined' ? edges  : [];
  const gruposList = (typeof gruposUnidade !== 'undefined' && Array.isArray(gruposUnidade)) ? gruposUnidade : [];
  const unidadeNomeStr = typeof unidadeNome !== 'undefined' ? unidadeNome : '';
  const temUnidade = !!unidadeNomeStr && gruposList.length > 0;

  function tipoInfo(t) {
    if (t === 'questionario')    return { label:'Questionário',      icon:'📋', color:'#3b82f6' };
    if (t === 'aprovacao')       return { label:'Aprovação',         icon:'✅', color:'#22c55e' };
    if (t === 'parecer' || t === 'parecer_tecnico') return { label:'Parecer', icon:'💬', color:'#8b5cf6' };
    if (t === 'assinatura_digital') return { label:'Assinatura Digital', icon:'✍️', color:'#f59e0b' };
    return { label:'Formulário', icon:'📄', color:'#64748b' };
  }
%>

<style>
/* ── Layout builder ── */
.sf-builder-wrap {
  display: flex;
  height: calc(100vh - 124px);
  overflow: hidden;
}

/* ── Paleta esquerda ── */
.sf-palette {
  width: 164px;
  flex-shrink: 0;
  background: #fff;
  border-right: 1px solid #e2e8f0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  padding: 12px 10px;
  gap: 4px;
}
.dark .sf-palette {
  background: #1e293b;
  border-color: #334155;
}
.sf-palette-title {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: #94a3b8;
  padding: 2px 4px 8px;
}
.sf-palette-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 9px 10px;
  border: 1.5px solid #e2e8f0;
  border-radius: 9px;
  background: #f8fafc;
  cursor: pointer;
  text-align: left;
  transition: all .14s;
}
.dark .sf-palette-item {
  background: #0f172a;
  border-color: #334155;
}
.sf-palette-item:hover {
  border-color: #6366f1;
  background: #eef2ff;
  transform: translateX(2px);
}
.dark .sf-palette-item:hover {
  background: #1e1b4b;
  border-color: #6366f1;
}
.sf-palette-item-icon { font-size: 16px; flex-shrink: 0; }
.sf-palette-item-label {
  font-size: 11px;
  font-weight: 600;
  color: #374151;
  line-height: 1.2;
}
.dark .sf-palette-item-label { color: #e2e8f0; }
.sf-palette-divider {
  border: none;
  border-top: 1px solid #f1f5f9;
  margin: 8px 0;
}
.dark .sf-palette-divider { border-color: #334155; }
.sf-palette-tips {
  font-size: 10px;
  color: #94a3b8;
  line-height: 1.6;
  padding: 4px;
}

/* ── Área do canvas ── */
.sf-canvas-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ── Barra do topo ── */
.sf-topbar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-bottom: 1px solid #e2e8f0;
  background: #fff;
  flex-shrink: 0;
  flex-wrap: wrap;
}
.dark .sf-topbar {
  background: #1e293b;
  border-color: #334155;
}
.sf-topbar-flow-name {
  font-size: 14px;
  font-weight: 700;
  color: #1e293b;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dark .sf-topbar-flow-name { color: #f1f5f9; }
.sf-topbar-version {
  font-size: 11px;
  color: #6366f1;
  background: #eef2ff;
  border-radius: 20px;
  padding: 2px 8px;
  font-weight: 600;
}
.dark .sf-topbar-version {
  background: #1e1b4b;
  color: #a5b4fc;
}

/* ── Canvas ── */
.sf-canvas {
  position: relative;
  flex: 1;
  min-height: 0;
  background-color: #f8fafc;
  background-image:
    linear-gradient(rgba(148,163,184,.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148,163,184,.12) 1px, transparent 1px);
  background-size: 24px 24px;
  overflow: auto;
  cursor: default;
}
.dark .sf-canvas {
  background-color: #0f172a;
  background-image:
    linear-gradient(rgba(71,85,105,.2) 1px, transparent 1px),
    linear-gradient(90deg, rgba(71,85,105,.2) 1px, transparent 1px);
}

/* ── Nó SF-style ── */
.sf-node {
  position: absolute;
  width: 240px;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 12px;
  cursor: move;
  box-shadow: 0 2px 8px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  transition: box-shadow .15s, border-color .15s;
  user-select: none;
  display: flex;
  align-items: stretch;
  z-index: 10;
}
.dark .sf-node {
  background: #1e293b;
  border-color: #334155;
}
.sf-node:hover {
  box-shadow: 0 6px 20px rgba(0,0,0,.12);
  border-color: #a5b4fc;
}
.dark .sf-node:hover { border-color: #6366f1; }
.sf-node.dragging {
  opacity: .8;
  z-index: 999;
  box-shadow: 0 16px 40px rgba(0,0,0,.2);
  cursor: grabbing;
}
.sf-node.connecting-source {
  border-color: #06b6d4;
  box-shadow: 0 0 0 3px rgba(6,182,212,.25);
}
.sf-node.connect-target {
  border-color: #6366f1;
  cursor: crosshair;
}
.sf-node.sf-node-inicio { border-color: #10b981; }
.sf-node.sf-node-fim    { border-color: #ef4444; }

.sf-node-inner {
  flex: 1;
  min-width: 0;
  border-radius: 10px;
  overflow: hidden;
}

/* Type header */
.sf-node-type-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 10px 6px;
  border-radius: 10px 10px 0 0;
}
.sf-node-type-icon  { font-size: 13px; }
.sf-node-type-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #fff;
  opacity: .92;
  flex: 1;
}
.sf-node-state-badges {
  display: flex;
  gap: 4px;
}
.sf-state-badge {
  font-size: 9px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 10px;
  background: rgba(255,255,255,.25);
  color: #fff;
  white-space: nowrap;
}

/* Step name — destaque principal */
.sf-node-name {
  font-size: 13px;
  font-weight: 700;
  color: #1e293b;
  padding: 10px 12px 6px;
  line-height: 1.35;
  word-break: break-word;
}
.dark .sf-node-name { color: #f1f5f9; }

/* Indicators row */
.sf-node-indicators {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  padding: 0 12px 8px;
}
.sf-badge {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 5px;
  background: #f1f5f9;
  color: #475569;
  display: inline-flex;
  align-items: center;
  gap: 3px;
}
.dark .sf-badge { background: #334155; color: #94a3b8; }

/* Group footer */
.sf-node-group {
  font-size: 10px;
  color: #94a3b8;
  padding: 5px 12px 9px;
  border-top: 1px solid #f1f5f9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dark .sf-node-group { border-color: #334155; color: #475569; }

/* ── Ports de conexão ── */
.sf-port-col {
  display: flex;
  align-items: center;
  padding: 0 4px;
  flex-shrink: 0;
}
.sf-port {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 2px solid #cbd5e1;
  background: #fff;
  cursor: pointer;
  transition: all .15s;
  flex-shrink: 0;
  position: relative;
}
.dark .sf-port { background: #1e293b; border-color: #475569; }
.sf-port-out { cursor: crosshair; }
.sf-port:hover {
  background: #6366f1;
  border-color: #6366f1;
  transform: scale(1.3);
  box-shadow: 0 0 0 4px rgba(99,102,241,.2);
}
.sf-node.connecting-source .sf-port-out {
  background: #06b6d4;
  border-color: #06b6d4;
  box-shadow: 0 0 0 4px rgba(6,182,212,.3);
}

/* ── SVG conexões ── */
.connection-group { pointer-events: all; cursor: pointer; }
.conn-hit  { fill: none; stroke: transparent; stroke-width: 14; }
.conn-line { fill: none; stroke-width: 2.5; stroke-linejoin: round; }
.conn-del { display: none; }
.connection-group:hover .conn-del { display: block; }
.connection-group:hover .conn-label-bg { stroke-width: 2; }

/* ── Painel lateral ── */
#painelConfig {
  position: fixed; top: 0; right: 0; height: 100%;
  width: 100%; max-width: 420px;
  background: #fff;
  border-left: 1px solid #e2e8f0;
  box-shadow: -4px 0 24px rgba(0,0,0,.12);
  z-index: 50;
  transform: translateX(100%);
  transition: transform .22s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
  display: flex; flex-direction: column;
}
#painelConfig.open { transform: translateX(0); }
.dark #painelConfig { background: #1e293b; border-color: #334155; }

.painel-header {
  padding: 14px 16px; border-bottom: 1px solid #e2e8f0;
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0; background: inherit;
}
.dark .painel-header { border-color: #334155; }

#painelBody {
  flex: 1; min-height: 0;
  overflow-y: auto;
  padding: 16px;
}

#painelFooter {
  flex-shrink: 0;
  padding: 12px 16px;
  border-top: 1px solid #e2e8f0;
  display: flex; gap: 8px;
  background: inherit;
}
.dark #painelFooter { border-color: #334155; }

/* ── Tipo selector ── */
.tipo-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 6px; }
.tipo-opt {
  border: 2px solid #e2e8f0; border-radius: 8px; padding: 8px 4px;
  cursor: pointer; text-align: center; transition: all .12s;
  background: #f8fafc;
}
.dark .tipo-opt { background: #0f172a; border-color: #334155; }
.tipo-opt:hover { border-color: #a5b4fc; background: #eef2ff; }
.dark .tipo-opt:hover { background: #1e1b4b; }
.tipo-opt.sel { border-color: #6366f1; background: #eef2ff; }
.dark .tipo-opt.sel { background: #1e1b4b; border-color: #6366f1; }
.tipo-opt-icon  { font-size: 18px; }
.tipo-opt-label { font-size: 10px; font-weight: 700; color: #374151; display: block; margin-top: 2px; }
.dark .tipo-opt-label { color: #e2e8f0; }

/* ── Question builder ── */
.qb-item {
  background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;
  padding: 10px; margin-bottom: 6px;
}
.dark .qb-item { background: #0f172a; border-color: #334155; }
.qb-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.qb-drag { color: #94a3b8; cursor: grab; }
.qb-num  { font-size: 11px; font-weight: 700; color: #64748b; min-width: 14px; }
.qb-label { flex: 1; min-width: 0; font-size: 12px; border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px 8px; background: #fff; color: #1e293b; }
.dark .qb-label { background: #1e293b; border-color: #334155; color: #f1f5f9; }
.qb-tipo  { font-size: 11px; border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px; background: #fff; color: #1e293b; }
.dark .qb-tipo { background: #1e293b; border-color: #334155; color: #f1f5f9; }
.qb-req  { font-size: 10px; color: #64748b; display:flex; align-items:center; gap:3px; white-space:nowrap; }
.qb-del  { color: #ef4444; cursor: pointer; font-size: 14px; line-height:1; }
.qb-opts { margin-top: 6px; padding-left: 22px; }
.qb-opt-row { display: flex; gap: 5px; align-items: center; margin-bottom: 3px; }
.qb-opt-inp { flex: 1; font-size: 11px; border: 1px solid #e2e8f0; border-radius: 5px; padding: 3px 7px; background: #fff; color: #1e293b; }
.dark .qb-opt-inp { background: #1e293b; border-color: #334155; color: #f1f5f9; }

/* ── Form helpers ── */
.fl-label { display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; }
.dark .fl-label { color: #e2e8f0; }
.fl-input, .fl-select, .fl-textarea {
  width: 100%; border: 1px solid #e2e8f0; border-radius: 7px;
  padding: 7px 10px; font-size: 13px; color: #1e293b; background: #fff;
}
.fl-input:focus, .fl-select:focus, .fl-textarea:focus {
  outline: none; border-color: #6366f1; box-shadow: 0 0 0 2px rgba(99,102,241,.15);
}
.dark .fl-input, .dark .fl-select, .dark .fl-textarea {
  background: #0f172a; border-color: #334155; color: #f1f5f9;
}
.fl-textarea { resize: vertical; min-height: 70px; }
.fl-section { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
              color: #94a3b8; margin: 18px 0 8px; padding-top: 14px; border-top: 1px solid #f1f5f9; }
.dark .fl-section { color: #475569; border-color: #1e293b; }
</style>

<div class="sf-builder-wrap">

  <!-- ── Paleta esquerda ── -->
  <% if (temUnidade) { %>
  <div class="sf-palette">
    <div class="sf-palette-title">Elementos</div>

    <button class="sf-palette-item" data-palette-tipo="questionario">
      <span class="sf-palette-item-icon">📋</span>
      <span class="sf-palette-item-label">Questionário</span>
    </button>
    <button class="sf-palette-item" data-palette-tipo="aprovacao">
      <span class="sf-palette-item-icon">✅</span>
      <span class="sf-palette-item-label">Aprovação</span>
    </button>
    <button class="sf-palette-item" data-palette-tipo="parecer">
      <span class="sf-palette-item-icon">💬</span>
      <span class="sf-palette-item-label">Parecer Técnico</span>
    </button>
    <button class="sf-palette-item" data-palette-tipo="assinatura_digital">
      <span class="sf-palette-item-icon">✍️</span>
      <span class="sf-palette-item-label">Assinatura Digital</span>
    </button>

    <hr class="sf-palette-divider">

    <!-- Botão IA -->
    <button class="sf-palette-item" id="btnAiAssistant" style="border-color:#a855f7;background:linear-gradient(135deg,#f5f3ff 0%,#ede9fe 100%);">
      <span class="sf-palette-item-icon">✨</span>
      <span class="sf-palette-item-label" style="color:#7c3aed;">Gerar com IA</span>
    </button>

    <hr class="sf-palette-divider">

    <div class="sf-palette-tips">
      <strong style="display:block;margin-bottom:4px;color:#64748b;">Como usar</strong>
      Clique em um elemento para adicionar ao fluxo.<br><br>
      <strong>●</strong> Clique no ponto direito para conectar etapas.<br><br>
      Arraste os nós para reposicionar.
    </div>
  </div>
  <% } %>

  <!-- ── Área principal ── -->
  <div class="sf-canvas-area">

    <!-- Barra superior -->
    <div class="sf-topbar">
      <a href="/fluxos" class="text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 flex-shrink-0">
        <svg class="w-4 h-4 inline -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Fluxos
      </a>
      <svg class="w-4 h-4 opacity-30 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="sf-topbar-flow-name"><%= f.nome %></span>
      <span class="sf-topbar-version">v<%= f.versao || '1.0' %></span>
      <% if (f.descricao) { %>
        <span class="hidden sm:inline text-xs text-gray-400 truncate max-w-xs"><%= f.descricao %></span>
      <% } %>
      <div class="flex items-center gap-2 flex-shrink-0 ml-auto">
        <a href="/fluxos/<%= f.id %>/editar"
          class="inline-flex items-center gap-1.5 border border-gray-300 dark:border-slate-600 text-gray-600 dark:text-gray-300 px-3 py-1.5 rounded-lg text-xs font-medium hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">
          ✏️ Editar info
        </a>
      </div>
    </div>

    <!-- Diagnóstico do desenho: problemas que impediriam o fluxo de rodar -->
    <% if (typeof diagnostico !== 'undefined' && diagnostico.problemas.length > 0) { %>
      <div class="px-4 py-3 border-b border-gray-200 dark:border-slate-700 <%= diagnostico.valido ? 'bg-amber-50 dark:bg-amber-900/20' : 'bg-red-50 dark:bg-red-900/20' %>">
        <p class="text-xs font-semibold uppercase tracking-wider mb-1.5 <%= diagnostico.valido ? 'text-amber-800 dark:text-amber-300' : 'text-red-800 dark:text-red-300' %>">
          <%= diagnostico.valido ? 'Avisos no desenho' : 'O fluxo não pode ser executado' %>
        </p>
        <ul class="space-y-0.5">
          <% diagnostico.problemas.forEach(function(p) { %>
            <li class="text-xs flex items-start gap-1.5 <%= p.nivel === 'erro' ? 'text-red-700 dark:text-red-300' : 'text-amber-700 dark:text-amber-300' %>">
              <span class="flex-shrink-0"><%= p.nivel === 'erro' ? '⛔' : '⚠️' %></span>
              <span><%= p.mensagem %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <!-- Canvas -->
    <% if (!temUnidade) { %>
      <div class="flex-1 flex items-center justify-center p-8">
        <div class="rounded-xl border-2 border-amber-200 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 p-8 text-center max-w-md">
          <p class="text-amber-800 dark:text-amber-300 font-medium">⚠️ Selecione uma unidade no topo da página para configurar as etapas e grupos.</p>
        </div>
      </div>
    <% } else { %>

    <div id="fluxoCanvas" class="sf-canvas">
      <svg id="svgConexoes" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;"></svg>

      <% etapasList.forEach(function(e) {
        const px = e.pos_x != null ? e.pos_x : (etapasList.indexOf(e) * 280 + 40);
        const py = e.pos_y != null ? e.pos_y : 60;
        const ti = tipoInfo(e.tipo_acao);
        const grupoNome = e.proprietario_nome || '';
        const camposRaw = e.campos_requeridos;
        let campos = {};
        try { campos = typeof camposRaw === 'string' ? JSON.parse(camposRaw) : (camposRaw || {}); } catch(_) {}
        const nPerguntas = campos.perguntas ? campos.perguntas.length : 0;
        let dvArr = [];
        try { dvArr = typeof e.documentos_vinculados === 'string' ? JSON.parse(e.documentos_vinculados) : (e.documentos_vinculados || []); } catch(_) {}
        const nDocs = Array.isArray(dvArr) ? dvArr.length : 0;
        const nodeClass = e.eh_inicio ? 'sf-node sf-node-inicio' : (e.eh_fim ? 'sf-node sf-node-fim' : 'sf-node');
      %>
      <div class="<%= nodeClass %>"
        id="node-<%= e.id %>"
        data-etapa-id="<%= e.id %>"
        data-proprietario-id="<%= e.proprietario_id || '' %>"
        style="left:<%= px %>px;top:<%= py %>px;">

        <!-- Port de entrada (esquerda) -->
        <div class="sf-port-col">
          <div class="sf-port sf-port-in" title="Entrada" data-port="in" data-etapa-id="<%= e.id %>"></div>
        </div>

        <!-- Conteúdo do nó -->
        <div class="sf-node-inner">
          <!-- Barra de tipo -->
          <div class="sf-node-type-bar" style="background:<%= ti.color %>;">
            <span class="sf-node-type-icon"><%= ti.icon %></span>
            <span class="sf-node-type-label"><%= ti.label %></span>
            <div class="sf-node-state-badges">
              <% if (e.eh_inicio) { %><span class="sf-state-badge">▶ Início</span><% } %>
              <% if (e.eh_fim)    { %><span class="sf-state-badge">■ Fim</span><% } %>
            </div>
          </div>

          <!-- Nome da etapa (destaque principal) -->
          <div class="sf-node-name"><%= e.nome %></div>

          <!-- Indicadores -->
          <% if (nPerguntas > 0 || nDocs > 0 || e.exige_assinatura || e.prazo_em_dias || e.codigo) { %>
          <div class="sf-node-indicators">
            <% if (e.codigo) { %>
              <span class="sf-badge" style="font-family:monospace;"><%= e.codigo %></span>
            <% } %>
            <% if (nPerguntas > 0) { %>
              <span class="sf-badge" style="background:#eff6ff;color:#1d4ed8;" title="<%= nPerguntas %> pergunta(s)">📋 <%= nPerguntas %></span>
            <% } %>
            <% if (nDocs > 0) { %>
              <span class="sf-badge" style="background:#fef9c3;color:#854d0e;" title="<%= nDocs %> documento(s)">📄 <%= nDocs %></span>
            <% } %>
            <% if (e.exige_assinatura) { %>
              <span class="sf-badge" style="background:#fdf4ff;color:#7e22ce;" title="Exige assinatura digital">✍️ Assinatura</span>
            <% } %>
            <% if (e.prazo_em_dias) { %>
              <span class="sf-badge">⏱ <%= e.prazo_em_dias %>d</span>
            <% } %>
          </div>
          <% } %>

          <!-- Grupo responsável -->
          <% if (grupoNome) { %>
          <div class="sf-node-group">👥 <%= grupoNome %></div>
          <% } %>
        </div>

        <!-- Port de saída (direita) -->
        <div class="sf-port-col">
          <div class="sf-port sf-port-out" title="Clique para conectar" data-port="out" data-etapa-id="<%= e.id %>"></div>
        </div>

      </div>
      <% }); %>
    </div>

    <% } %>
  </div><!-- /sf-canvas-area -->
</div><!-- /sf-builder-wrap -->

<!-- ══════════════════════════════════════════ -->
<!-- PAINEL LATERAL: Configurar etapa          -->
<!-- ══════════════════════════════════════════ -->
<div id="painelConfig">
  <div class="painel-header">
    <h2 class="text-base font-bold text-gray-900 dark:text-white">Configurar etapa</h2>
    <button id="btnFecharPainel" class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <input type="hidden" id="configEtapaId">

  <div id="painelBody">
    <!-- Tipo -->
    <div style="margin-bottom:12px;">
      <label class="fl-label">Tipo de etapa</label>
      <div class="tipo-grid" id="tipoGrid">
        <div class="tipo-opt" data-tipo="questionario">
          <div class="tipo-opt-icon">📋</div>
          <span class="tipo-opt-label">Questionário</span>
        </div>
        <div class="tipo-opt" data-tipo="aprovacao">
          <div class="tipo-opt-icon">✅</div>
          <span class="tipo-opt-label">Aprovação</span>
        </div>
        <div class="tipo-opt" data-tipo="parecer">
          <div class="tipo-opt-icon">💬</div>
          <span class="tipo-opt-label">Parecer</span>
        </div>
        <div class="tipo-opt" data-tipo="assinatura_digital">
          <div class="tipo-opt-icon">✍️</div>
          <span class="tipo-opt-label">Assinatura</span>
        </div>
      </div>
    </div>

    <!-- Geral -->
    <div class="fl-section" style="margin-top:4px;">INFORMAÇÕES GERAIS</div>

    <div style="margin-bottom:10px;">
      <label class="fl-label">Nome da etapa *</label>
      <input type="text" id="configNome" class="fl-input" required maxlength="255" placeholder="Ex: Validar documentação">
    </div>
    <div style="margin-bottom:10px;">
      <label class="fl-label">Código (único no fluxo)</label>
      <input type="text" id="configCodigo" class="fl-input" maxlength="80" placeholder="Gerado automaticamente se vazio">
    </div>
    <div style="margin-bottom:10px;">
      <label class="fl-label">Responsável (grupo)</label>
      <select id="configGrupo" class="fl-select">
        <option value="">— Sem grupo —</option>
        <% gruposList.forEach(function(g) { %><option value="<%= g.id %>"><%= g.nome %></option><% }); %>
      </select>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:4px;">
      <div>
        <label class="fl-label">Prazo (dias)</label>
        <input type="number" id="configPrazo" class="fl-input" min="0" placeholder="Opcional">
      </div>
      <div style="display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding-bottom:2px;">
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;color:#475569;" class="dark:text-slate-400">
          <input type="checkbox" id="configExigeAssinatura" style="width:14px;height:14px;"> Exige assinatura
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;color:#22c55e;">
          <input type="checkbox" id="configEhInicio" style="width:14px;height:14px;"> Etapa de início
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12px;color:#ef4444;">
          <input type="checkbox" id="configEhFim" style="width:14px;height:14px;"> Etapa de fim
        </label>
      </div>
    </div>

    <!-- Configuração por tipo -->
    <div class="fl-section" id="tipoConfigTitle">CONFIGURAÇÃO DA ETAPA</div>
    <div id="tipoConfigArea"></div>

    <!-- Documentos -->
    <% if (typeof templatesPdf !== 'undefined' && templatesPdf.length > 0) { %>
    <div class="fl-section">DOCUMENTOS VINCULADOS</div>
    <div style="border:1px solid #e2e8f0;border-radius:8px;padding:8px;max-height:110px;overflow-y:auto;background:#fff;" class="dark:bg-slate-900 dark:border-slate-700">
      <% templatesPdf.forEach(function(t) { %>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:#374151;margin-bottom:4px;cursor:pointer;" class="dark:text-slate-300">
          <input type="checkbox" name="documento_templates" value="<%= t.id %>" class="config-doc-template" style="width:13px;height:13px;">
          <span><%= t.nome %></span>
          <span style="font-size:10px;color:#94a3b8;">(<%= t.tipo_documento %>)</span>
        </label>
      <% }); %>
    </div>
    <% } %>

    <!-- Anexos -->
    <div class="fl-section">ANEXOS</div>
    <ul id="configAnexosLista" style="list-style:none;padding:0;margin:0 0 8px;"></ul>
    <form id="formAnexoEtapa" style="display:flex;gap:6px;align-items:center;">
      <input type="file" id="inputAnexoEtapa" style="font-size:12px;color:#64748b;flex:1;min-width:0;" class="dark:text-slate-400">
      <button type="submit" style="padding:5px 12px;background:#6366f1;color:#fff;border:none;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;">Anexar</button>
    </form>
  </div><!-- /painelBody -->

  <div id="painelFooter">
    <button type="button" id="btnSalvarEtapa"
      style="flex:1;padding:9px;background:#4f46e5;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">
      Salvar
    </button>
    <button type="button" id="btnRemoverEtapa"
      style="padding:9px 14px;color:#ef4444;background:#fff;border:1px solid #fecaca;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;"
      class="dark:bg-slate-900 dark:border-red-900">
      Excluir
    </button>
  </div>
</div>
<div id="painelConfigBackdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.25);z-index:49;"></div>

<!-- ══════════════════════════════════════════ -->
<!-- MODAL: Adicionar etapa (SF-like)          -->
<!-- ══════════════════════════════════════════ -->
<div id="modalEtapa" style="display:none;position:fixed;inset:0;z-index:60;overflow-y:auto;">
  <div style="display:flex;min-height:100%;align-items:center;justify-content:center;padding:16px;">
    <div id="modalEtapaBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.5);"></div>
    <div style="position:relative;background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:460px;overflow:hidden;" class="dark:bg-slate-800">

      <!-- Header com pill de tipo -->
      <div style="padding:16px 20px 14px;border-bottom:1px solid #e2e8f0;" class="dark:border-slate-700">
        <div style="display:flex;align-items:center;gap:10px;">
          <div id="modalEtapaTipoPill" style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700;color:#fff;background:#6366f1;">
            <span id="modalEtapaTipoIcon">📋</span>
            <span id="modalEtapaTipoLabel">Questionário</span>
          </div>
          <div>
            <h3 style="font-size:15px;font-weight:700;color:#1e293b;margin:0;" class="dark:text-white">Nova etapa</h3>
            <p style="font-size:11px;color:#94a3b8;margin:2px 0 0;">Defina o nome e o responsável</p>
          </div>
        </div>
      </div>

      <form method="POST" action="/fluxos/<%= f.id %>/etapas" style="padding:20px;display:flex;flex-direction:column;gap:14px;">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="tipo_acao" id="novoTipoValor" value="questionario">

        <!-- Nome — campo principal e em destaque -->
        <div>
          <label class="fl-label" style="font-size:13px;">Nome da etapa <span style="color:#ef4444;">*</span></label>
          <input type="text" name="nome" id="novaNome" required maxlength="255"
            placeholder="Ex: Validar documentação"
            class="fl-input"
            style="font-size:15px;font-weight:600;padding:10px 12px;">
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div>
            <label class="fl-label">Grupo responsável <span style="color:#ef4444;">*</span></label>
            <select name="proprietario_id" required class="fl-select">
              <option value="">— Selecionar —</option>
              <% gruposList.forEach(function(g) { %><option value="<%= g.id %>"><%= g.nome %></option><% }); %>
            </select>
          </div>
          <div>
            <label class="fl-label">Prazo (dias)</label>
            <input type="number" name="prazo_em_dias" min="0" placeholder="Opcional" class="fl-input">
          </div>
        </div>

        <!-- Tipo selector — expandido (acessível caso o usuário queira trocar) -->
        <details style="border:1px solid #e2e8f0;border-radius:8px;padding:0;" class="dark:border-slate-700">
          <summary style="padding:8px 12px;font-size:12px;font-weight:600;color:#64748b;cursor:pointer;list-style:none;display:flex;align-items:center;gap:6px;">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
            Trocar tipo de elemento
          </summary>
          <div style="padding:10px 12px;border-top:1px solid #f1f5f9;" class="dark:border-slate-700">
            <div class="tipo-grid" id="novoTipoGrid">
              <div class="tipo-opt sel" data-novo-tipo="questionario" style="border-color:#6366f1;background:#eef2ff;">
                <div class="tipo-opt-icon">📋</div>
                <span class="tipo-opt-label">Questionário</span>
              </div>
              <div class="tipo-opt" data-novo-tipo="aprovacao">
                <div class="tipo-opt-icon">✅</div>
                <span class="tipo-opt-label">Aprovação</span>
              </div>
              <div class="tipo-opt" data-novo-tipo="parecer">
                <div class="tipo-opt-icon">💬</div>
                <span class="tipo-opt-label">Parecer</span>
              </div>
              <div class="tipo-opt" data-novo-tipo="assinatura_digital">
                <div class="tipo-opt-icon">✍️</div>
                <span class="tipo-opt-label">Assinatura</span>
              </div>
            </div>
          </div>
        </details>

        <div>
          <label class="fl-label">Código (opcional)</label>
          <input type="text" name="codigo" maxlength="80" placeholder="Gerado automaticamente" class="fl-input" style="font-family:monospace;">
        </div>

        <div style="display:flex;gap:8px;padding-top:4px;">
          <button type="submit" style="flex:1;padding:11px;background:#4f46e5;color:#fff;border:none;border-radius:9px;font-size:14px;font-weight:700;cursor:pointer;">
            Adicionar ao fluxo
          </button>
          <button type="button" id="btnFecharModalEtapa" style="padding:11px 18px;border:1px solid #e2e8f0;background:#fff;color:#475569;border-radius:9px;font-size:13px;cursor:pointer;" class="dark:bg-slate-900 dark:border-slate-700 dark:text-slate-400">Cancelar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════ -->
<!-- MODAL: Editor de Perguntas              -->
<!-- ══════════════════════════════════════════ -->
<div id="modalPerguntas" style="display:none;position:fixed;inset:0;z-index:80;align-items:center;justify-content:center;padding:16px;">
  <div id="mqBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:0;"></div>
  <div style="position:relative;z-index:1;width:100%;max-width:640px;max-height:90vh;background:#fff;border-radius:16px;box-shadow:0 24px 64px rgba(0,0,0,.25);display:flex;flex-direction:column;" class="dark:bg-slate-800">

    <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;" class="dark:border-slate-700">
      <div>
        <h3 style="font-size:16px;font-weight:700;color:#1e293b;margin:0;" class="dark:text-white">📋 Editor de Questionário</h3>
        <p style="font-size:12px;color:#94a3b8;margin:3px 0 0;">Crie as perguntas que os usuários devem responder nesta etapa</p>
      </div>
      <button id="btnFecharPerguntas" style="color:#94a3b8;background:none;border:none;cursor:pointer;padding:4px;">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="mq-content" style="flex:1;min-height:0;overflow-y:auto;padding:16px;">
      <div id="modalQ-perguntas"></div>
    </div>

    <div class="mq-add-footer" style="padding:12px 16px;border-top:1px solid #f1f5f9;border-bottom:1px solid #f1f5f9;flex-shrink:0;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;margin:0 0 8px;">Adicionar pergunta</p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;">
        <button type="button" data-tipo-add="texto_curto" style="padding:5px 10px;font-size:11px;font-weight:600;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer;">📝 Texto curto</button>
        <button type="button" data-tipo-add="texto_longo" style="padding:5px 10px;font-size:11px;font-weight:600;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer;">📄 Texto longo</button>
        <button type="button" data-tipo-add="numero"      style="padding:5px 10px;font-size:11px;font-weight:600;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer;">🔢 Número</button>
        <button type="button" data-tipo-add="data"        style="padding:5px 10px;font-size:11px;font-weight:600;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer;">📅 Data</button>
        <button type="button" data-tipo-add="hora"        style="padding:5px 10px;font-size:11px;font-weight:600;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer;">🕐 Hora</button>
        <button type="button" data-tipo-add="radio"       style="padding:5px 10px;font-size:11px;font-weight:600;background:#eef2ff;border:1px solid #c7d2fe;border-radius:6px;cursor:pointer;color:#4338ca;">⊙ Seleção única</button>
        <button type="button" data-tipo-add="checkbox"    style="padding:5px 10px;font-size:11px;font-weight:600;background:#eef2ff;border:1px solid #c7d2fe;border-radius:6px;cursor:pointer;color:#4338ca;">☑ Múltipla escolha</button>
        <button type="button" data-tipo-add="selecao"     style="padding:5px 10px;font-size:11px;font-weight:600;background:#eef2ff;border:1px solid #c7d2fe;border-radius:6px;cursor:pointer;color:#4338ca;">≡ Lista suspensa</button>
        <button type="button" data-tipo-add="arquivo"     style="padding:5px 10px;font-size:11px;font-weight:600;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;cursor:pointer;color:#15803d;">📎 Arquivo</button>
        <button type="button" data-tipo-add="sim_nao"     style="padding:5px 10px;font-size:11px;font-weight:600;background:#fef3c7;border:1px solid #fde68a;border-radius:6px;cursor:pointer;color:#92400e;">↕ Sim / Não</button>
      </div>
    </div>

    <div style="padding:12px 16px;display:flex;justify-content:flex-end;gap:8px;flex-shrink:0;">
      <button type="button" id="btnCancelarPerguntas" style="padding:8px 18px;background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;cursor:pointer;">Cancelar</button>
      <button type="button" id="btnSalvarPerguntas"   style="padding:8px 20px;background:#4f46e5;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">✓ Salvar perguntas</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════ -->
<!-- MODAL: Assistente de IA                   -->
<!-- ══════════════════════════════════════════ -->
<div id="modalAi" style="display:none;position:fixed;inset:0;z-index:70;overflow-y:auto;">
  <div style="display:flex;min-height:100%;align-items:center;justify-content:center;padding:16px;">
    <div id="modalAiBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.55);"></div>
    <div style="position:relative;background:#fff;border-radius:18px;box-shadow:0 24px 80px rgba(0,0,0,.25);width:100%;max-width:640px;overflow:hidden;" class="dark:bg-slate-800">

      <!-- Header -->
      <div style="padding:20px 24px 18px;background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <div>
            <h3 style="font-size:18px;font-weight:800;color:#fff;margin:0;">✨ Assistente de IA</h3>
            <p style="font-size:12px;color:rgba(255,255,255,.75);margin:4px 0 0;">Descreva o processo e a IA monta o fluxo automaticamente</p>
          </div>
          <button id="btnFecharModalAi" style="color:rgba(255,255,255,.8);background:rgba(255,255,255,.15);border:none;border-radius:8px;cursor:pointer;padding:6px 10px;font-size:18px;line-height:1;">×</button>
        </div>
      </div>

      <!-- Step 1: input -->
      <div id="aiStep1" style="padding:24px;">
        <label style="display:block;font-size:13px;font-weight:700;color:#374151;margin-bottom:8px;" class="dark:text-slate-300">
          Descreva o processo em linguagem natural
        </label>
        <textarea id="aiDescricao" rows="5" placeholder="Ex: Processo de compra de materiais que começa com uma solicitação do setor, passa por aprovação do gestor, cotação de fornecedores, aprovação financeira e finaliza com o pedido de compra assinado..."
          style="width:100%;border:1.5px solid #e2e8f0;border-radius:10px;padding:12px;font-size:13px;color:#1e293b;background:#f8fafc;resize:vertical;outline:none;box-sizing:border-box;font-family:inherit;line-height:1.5;"
          class="dark:bg-slate-700 dark:border-slate-600 dark:text-white"></textarea>
        <p style="font-size:11px;color:#94a3b8;margin:6px 0 16px;">Seja específico sobre as etapas, aprovações e quem é responsável por cada parte.</p>

        <div style="display:flex;gap:10px;align-items:center;">
          <button id="btnAiGerar" style="flex:1;padding:12px;background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;">
            <span id="aiGerarIcon">✨</span>
            <span id="aiGerarLabel">Gerar fluxo com IA</span>
          </button>
          <button id="btnAiCancelar1" style="padding:12px 20px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;border-radius:10px;font-size:13px;cursor:pointer;" class="dark:bg-slate-700 dark:border-slate-600 dark:text-slate-300">Cancelar</button>
        </div>
        <div id="aiError" style="display:none;margin-top:12px;padding:10px 14px;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;font-size:12px;color:#dc2626;"></div>
      </div>

      <!-- Step 2: preview da sugestão -->
      <div id="aiStep2" style="display:none;">
        <!-- Subheader com título sugerido -->
        <div style="padding:14px 24px;background:#f8fafc;border-bottom:1px solid #e2e8f0;" class="dark:bg-slate-700 dark:border-slate-700">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;margin:0 0 4px;">Fluxo sugerido pela IA</p>
          <p id="aiTituloSugerido" style="font-size:15px;font-weight:700;color:#1e293b;margin:0;" class="dark:text-white"></p>
          <p id="aiDescSugerida" style="font-size:12px;color:#64748b;margin:3px 0 0;" class="dark:text-slate-400"></p>
        </div>

        <!-- Lista de etapas sugeridas (scrollável) -->
        <div id="aiEtapasPreview" style="max-height:340px;overflow-y:auto;padding:16px 24px;display:flex;flex-direction:column;gap:10px;"></div>

        <!-- Footer de ação -->
        <div style="padding:16px 24px;border-top:1px solid #e2e8f0;display:flex;gap:10px;" class="dark:border-slate-700">
          <button id="btnAiCriar" style="flex:1;padding:12px;background:#22c55e;color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;">
            <span id="aiCriarIcon">🚀</span>
            <span id="aiCriarLabel">Criar no fluxo</span>
          </button>
          <button id="btnAiVoltar" style="padding:12px 16px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;border-radius:10px;font-size:13px;cursor:pointer;" class="dark:bg-slate-700 dark:border-slate-600 dark:text-slate-300">← Voltar</button>
          <button id="btnAiFechar2" style="padding:12px 16px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;border-radius:10px;font-size:13px;cursor:pointer;" class="dark:bg-slate-700 dark:border-slate-600 dark:text-slate-300">Cancelar</button>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════ -->
<!-- MODAL: Nova conexão                       -->
<!-- ══════════════════════════════════════════ -->
<div id="modalConexao" style="display:none;position:fixed;inset:0;z-index:60;overflow-y:auto;">
  <div style="display:flex;min-height:100%;align-items:center;justify-content:center;padding:16px;">
    <div id="modalConexaoBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.5);"></div>
    <div style="position:relative;background:#fff;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.2);width:100%;max-width:400px;padding:24px;" class="dark:bg-slate-800">
      <h3 style="font-size:16px;font-weight:700;color:#1e293b;margin:0 0 16px;" class="dark:text-white">Nova conexão</h3>
      <form id="formConexao" style="display:flex;flex-direction:column;gap:14px;">
        <input type="hidden" id="conexaoOrigem">
        <input type="hidden" id="conexaoDestino">
        <div>
          <label class="fl-label">Ação / Condição</label>
          <select id="conexaoLabel" class="fl-select">
            <option value="Sim">✅ Sim / Aprovado</option>
            <option value="Não">❌ Não / Reprovado</option>
            <option value="Pendente">⏳ Pendente</option>
            <option value="sempre">→ Sempre (seguir)</option>
          </select>
        </div>
        <div style="display:flex;gap:8px;">
          <button type="submit" style="flex:1;padding:9px;background:#22c55e;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">Criar conexão</button>
          <button type="button" id="btnFecharModalConexao" style="padding:9px 16px;border:1px solid #e2e8f0;background:#fff;color:#475569;border-radius:8px;font-size:13px;cursor:pointer;" class="dark:bg-slate-900 dark:border-slate-700 dark:text-slate-400">Cancelar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════ -->
<!-- SCRIPT                                    -->
<!-- ══════════════════════════════════════════ -->
<script>
(function () {
  var fluxoId    = '<%= f.id %>';
  var etapasData = <%- jsonSeguro(etapasList.map(function(e){
    var cr={};try{cr=typeof e.campos_requeridos==='string'?JSON.parse(e.campos_requeridos):(e.campos_requeridos||{});}catch(_){}
    var dv=[];try{dv=typeof e.documentos_vinculados==='string'?JSON.parse(e.documentos_vinculados):(e.documentos_vinculados||[]);}catch(_){}
    return {id:e.id,nome:e.nome,codigo:e.codigo,ordem:e.ordem,eh_inicio:e.eh_inicio,eh_fim:e.eh_fim,
            proprietario_id:e.proprietario_id,proprietario_nome:e.proprietario_nome,
            tipo_acao:(e.tipo_acao==='parecer_tecnico'?'parecer':e.tipo_acao||'questionario'),
            prazo_em_dias:e.prazo_em_dias,exige_assinatura:e.exige_assinatura,
            campos_requeridos:cr,documentos_vinculados:dv,pos_x:e.pos_x,pos_y:e.pos_y};
  })) %>;
  var edgesData  = <%- jsonSeguro(edgesList.map(function(e){
    return {id:e.id,etapa_origem_id:e.etapa_origem_id,etapa_destino_id:e.etapa_destino_id,label:e.label||'sempre'};
  })) %>;
  var anexosPorEtapa = <%- jsonSeguro(typeof anexosPorEtapa!=='undefined'?anexosPorEtapa:{}) %>;
  var gruposData = <%- jsonSeguro(gruposList.map(function(g){return {id:g.id,nome:g.nome};})) %>;

  var TIPO_INFO = {
    questionario:      { label:'Questionário',       icon:'📋', color:'#3b82f6' },
    aprovacao:         { label:'Aprovação',          icon:'✅', color:'#22c55e' },
    parecer:           { label:'Parecer',            icon:'💬', color:'#8b5cf6' },
    parecer_tecnico:   { label:'Parecer',            icon:'💬', color:'#8b5cf6' },
    assinatura_digital:{ label:'Assinatura Digital', icon:'✍️', color:'#f59e0b' }
  };
  function getTipoInfo(t) { return TIPO_INFO[t] || { label:'Formulário', icon:'📄', color:'#64748b' }; }

  // ── Drag ─────────────────────────────────────────────────────
  var dragging   = null;
  var dragOffset = {x:0,y:0};
  var didDrag    = false;

  function getEtapa(id) { return etapasData.find(function(e){return e.id===+id;}); }

  // ── Conexão via ports ─────────────────────────────────────────
  var connectingFrom = null; // card element

  function cancelConnect() {
    if (connectingFrom) {
      connectingFrom.classList.remove('connecting-source');
      connectingFrom = null;
    }
    document.querySelectorAll('.sf-node.connect-target').forEach(function(n){
      n.classList.remove('connect-target');
    });
  }

  function initNodeEvents(card) {
    var etapaId = +card.dataset.etapaId;

    // Port de saída → iniciar conexão
    var portOut = card.querySelector('.sf-port-out');
    if (portOut) {
      portOut.addEventListener('click', function(e) {
        e.stopPropagation();
        if (connectingFrom === card) { cancelConnect(); return; }
        cancelConnect();
        connectingFrom = card;
        card.classList.add('connecting-source');
        // Destacar outros nós como destino possível
        document.querySelectorAll('.sf-node').forEach(function(n){
          if (n !== card) n.classList.add('connect-target');
        });
      });
    }

    // Port de entrada OU clique no nó → destino da conexão
    card.addEventListener('click', function(e) {
      if (e.target.closest('.sf-port-out')) return;
      if (dragging || didDrag) return;

      if (connectingFrom && connectingFrom !== card) {
        document.getElementById('conexaoOrigem').value = connectingFrom.dataset.etapaId;
        document.getElementById('conexaoDestino').value = etapaId;
        cancelConnect();
        document.getElementById('modalConexao').style.display = 'block';
        return;
      }
      if (connectingFrom === card) { cancelConnect(); return; }
    });

    // Duplo clique → abrir painel de config
    card.addEventListener('dblclick', function(e) {
      if (e.target.closest('.sf-port')) return;
      if (dragging) return;
      var etapa = getEtapa(etapaId);
      if (etapa) openPainel(etapa);
    });

    // Drag
    card.addEventListener('mousedown', function(e) {
      if (e.target.closest('.sf-port,button,a')) return;
      dragging = card;
      didDrag  = false;
      var r = card.getBoundingClientRect();
      dragOffset = {x: e.clientX - r.left, y: e.clientY - r.top};
      card.classList.add('dragging');
      e.preventDefault();
    });
  }

  document.querySelectorAll('.sf-node').forEach(initNodeEvents);

  document.addEventListener('mousemove', function(e){
    if (!dragging) return;
    didDrag = true;
    var canvas = document.getElementById('fluxoCanvas');
    var cr = canvas.getBoundingClientRect();
    var x = e.clientX - cr.left - dragOffset.x + canvas.scrollLeft;
    var y = e.clientY - cr.top  - dragOffset.y + canvas.scrollTop;
    dragging.style.left = Math.max(0,x) + 'px';
    dragging.style.top  = Math.max(0,y) + 'px';
    drawConnections();
  });

  document.addEventListener('mouseup', function(){
    if (!dragging) return;
    var id = +dragging.dataset.etapaId;
    var x  = parseInt(dragging.style.left,10);
    var y  = parseInt(dragging.style.top ,10);
    fetch('/fluxos/'+fluxoId+'/etapas/'+id+'/posicao',{
      method:'PATCH',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      body:JSON.stringify({pos_x:x,pos_y:y})
    }).catch(function(){});
    dragging.classList.remove('dragging');
    dragging = null;
    setTimeout(function(){ didDrag = false; }, 50);
  });

  document.addEventListener('keydown', function(e){
    if (e.key==='Escape') cancelConnect();
  });

  // ── Desenhar conexões SVG ────────────────────────────────────
  function svgEl(tag){ return document.createElementNS('http://www.w3.org/2000/svg',tag); }

  function cardEdges(card){
    var canvas = document.getElementById('fluxoCanvas');
    var cr = canvas.getBoundingClientRect();
    var r  = card.getBoundingClientRect();
    var l = r.left - cr.left + canvas.scrollLeft;
    var t = r.top  - cr.top  + canvas.scrollTop;
    var w = r.width, h = r.height;
    return {
      cx: l + w/2, cy: t + h/2, w: w, h: h,
      right:  { x: l + w,   y: t + h/2, dir: 'right'  },
      left:   { x: l,       y: t + h/2, dir: 'left'   },
      bottom: { x: l + w/2, y: t + h,   dir: 'bottom' },
      top:    { x: l + w/2, y: t,       dir: 'top'    }
    };
  }

  function bezierPath(p1, p2) {
    var dx = p2.x - p1.x;
    var dy = p2.y - p1.y;
    var dist = Math.sqrt(dx*dx + dy*dy);
    var offset = Math.max(60, dist * 0.42);

    var c1x = p1.x + (p1.dir==='right'?offset : p1.dir==='left'?-offset : 0);
    var c1y = p1.y + (p1.dir==='bottom'?offset : p1.dir==='top'?-offset : 0);
    var c2x = p2.x + (p2.dir==='left'?-offset : p2.dir==='right'?offset : 0);
    var c2y = p2.y + (p2.dir==='top'?-offset : p2.dir==='bottom'?offset : 0);

    return 'M '+p1.x+','+p1.y+' C '+c1x+','+c1y+' '+c2x+','+c2y+' '+p2.x+','+p2.y;
  }

  function bezierMidPoint(p1, p2) {
    var dx = p2.x - p1.x;
    var dy = p2.y - p1.y;
    var dist = Math.sqrt(dx*dx + dy*dy);
    var offset = Math.max(60, dist * 0.42);
    var c1x = p1.x + (p1.dir==='right'?offset : p1.dir==='left'?-offset : 0);
    var c1y = p1.y + (p1.dir==='bottom'?offset : p1.dir==='top'?-offset : 0);
    var c2x = p2.x + (p2.dir==='left'?-offset : p2.dir==='right'?offset : 0);
    var c2y = p2.y + (p2.dir==='top'?-offset : p2.dir==='bottom'?offset : 0);
    // Ponto t=0.5 da curva cúbica de Bézier
    var mx = 0.125*p1.x + 0.375*c1x + 0.375*c2x + 0.125*p2.x;
    var my = 0.125*p1.y + 0.375*c1y + 0.375*c2y + 0.125*p2.y;
    return { x: mx, y: my };
  }

  function drawConnections(){
    var svg    = document.getElementById('svgConexoes');
    var canvas = document.getElementById('fluxoCanvas');
    if (!svg || !canvas) return;
    svg.setAttribute('width',  canvas.scrollWidth  + 'px');
    svg.setAttribute('height', canvas.scrollHeight + 'px');
    svg.innerHTML = '';

    var defs = svgEl('defs');
    [['ag','#22c55e'],['ar','#ef4444'],['agy','#6366f1']].forEach(function(pair){
      var m = svgEl('marker');
      m.setAttribute('id', pair[0]);
      m.setAttribute('markerWidth','10'); m.setAttribute('markerHeight','10');
      m.setAttribute('refX','9'); m.setAttribute('refY','3');
      m.setAttribute('orient','auto');
      var p = svgEl('polygon');
      p.setAttribute('points','0 0,10 3,0 6');
      p.setAttribute('fill', pair[1]);
      m.appendChild(p); defs.appendChild(m);
    });
    svg.appendChild(defs);

    edgesData.forEach(function(edge){
      var orig = document.getElementById('node-'+edge.etapa_origem_id);
      var dest = document.getElementById('node-'+edge.etapa_destino_id);
      if (!orig||!dest) return;

      var e1 = cardEdges(orig);
      var e2 = cardEdges(dest);
      var p1, p2;
      var dx = e2.cx - e1.cx, dy = e2.cy - e1.cy;
      if (Math.abs(dx) >= Math.abs(dy)) {
        p1 = dx >= 0 ? e1.right  : e1.left;
        p2 = dx >= 0 ? e2.left   : e2.right;
      } else {
        p1 = dy >= 0 ? e1.bottom : e1.top;
        p2 = dy >= 0 ? e2.top    : e2.bottom;
      }

      var lbl    = edge.label || 'sempre';
      var lLow   = lbl.toLowerCase();
      var color  = lLow.indexOf('não')>=0 || lLow.indexOf('reprov')>=0 ? '#ef4444' :
                   lLow==='sempre' ? '#6366f1' : '#22c55e';
      var arrow  = color==='#ef4444'?'ar': color==='#6366f1'?'agy':'ag';
      var d      = bezierPath(p1, p2);
      var mid    = bezierMidPoint(p1, p2);
      var lx = mid.x, ly = mid.y;

      var g = svgEl('g');
      g.setAttribute('class','connection-group');
      g.setAttribute('data-edge-id', edge.id);
      g.addEventListener('click', function(){
        if (!confirm('Remover esta conexão?')) return;
        var eid = this.getAttribute('data-edge-id');
        fetch('/fluxos/'+fluxoId+'/edges/'+eid, {
          method:'DELETE', headers:{'X-Requested-With':'XMLHttpRequest'}
        }).then(function(r){return r.json();})
          .then(function(d){
            if(d.success){ edgesData=edgesData.filter(function(e){return String(e.id)!==String(eid);}); drawConnections(); if(window.showToast)showToast('Conexão removida.','success'); }
            else if(window.showToast) showToast(d.message||'Erro.','error');
          }).catch(function(){ if(window.showToast)showToast('Erro.','error'); });
      });

      // Sombra suave (filtro SVG inline)
      var filterId = 'shadow-'+edge.id;
      var filterEl = svgEl('filter');
      filterEl.setAttribute('id', filterId);
      filterEl.setAttribute('x','-20%'); filterEl.setAttribute('y','-20%');
      filterEl.setAttribute('width','140%'); filterEl.setAttribute('height','140%');
      var feFlood = svgEl('feDropShadow');
      feFlood.setAttribute('dx','0'); feFlood.setAttribute('dy','1');
      feFlood.setAttribute('stdDeviation','1.5');
      feFlood.setAttribute('flood-color', color);
      feFlood.setAttribute('flood-opacity','0.18');
      filterEl.appendChild(feFlood);
      // Adicionar ao defs do SVG
      svg.querySelector('defs').appendChild(filterEl);

      // Área de hit transparente
      var hit = svgEl('path');
      hit.setAttribute('d',d); hit.setAttribute('fill','none');
      hit.setAttribute('stroke','transparent'); hit.setAttribute('stroke-width','16');
      g.appendChild(hit);

      // Linha principal
      var line = svgEl('path');
      line.setAttribute('d',d);
      line.setAttribute('fill','none');
      line.setAttribute('stroke',color);
      line.setAttribute('stroke-width','2');
      line.setAttribute('stroke-linecap','round');
      line.setAttribute('marker-end','url(#'+arrow+')');
      line.setAttribute('filter','url(#'+filterId+')');
      g.appendChild(line);

      // Pill de label (fundo com borda arredondada)
      var lblPad = 8;
      var lblH   = 18;
      var lblW   = Math.max(36, lbl.length * 6.5 + lblPad * 2);
      var rx     = lblH / 2;

      var bg = svgEl('rect');
      bg.setAttribute('x', lx - lblW/2); bg.setAttribute('y', ly - lblH/2);
      bg.setAttribute('width', lblW);    bg.setAttribute('height', lblH);
      bg.setAttribute('rx', rx);
      bg.setAttribute('fill', color);
      bg.setAttribute('opacity','0.92');
      g.appendChild(bg);

      // Ícone × ao hover
      var del = svgEl('text');
      del.setAttribute('x', lx + lblW/2 - 6); del.setAttribute('y', ly + 4.5);
      del.setAttribute('text-anchor','middle'); del.setAttribute('font-size','11');
      del.setAttribute('font-weight','900'); del.setAttribute('fill','#fff');
      del.setAttribute('class','conn-del'); del.textContent = '×';
      g.appendChild(del);

      // Texto do label (branco sobre pill colorida)
      var txt = svgEl('text');
      txt.setAttribute('x', lx); txt.setAttribute('y', ly + 4.5);
      txt.setAttribute('text-anchor','middle');
      txt.setAttribute('font-size','10'); txt.setAttribute('font-weight','700');
      txt.setAttribute('fill','#fff');
      txt.setAttribute('pointer-events','none');
      txt.textContent = lbl;
      g.appendChild(txt);

      svg.appendChild(g);
    });
  }

  // ── Estado central do painel ──────────────────────────────────
  var _currentCampos = {};

  function _applyTipo(tipo, campos) {
    try {
      document.querySelectorAll('#tipoGrid .tipo-opt').forEach(function(el){
        el.classList.toggle('sel', el.dataset.tipo === tipo);
      });
      var titles = {
        questionario: 'PERGUNTAS DO QUESTIONÁRIO',
        aprovacao:    'CONFIGURAÇÃO DA APROVAÇÃO',
        parecer:      'CONFIGURAÇÃO DO PARECER',
        assinatura_digital: 'CONFIGURAÇÃO DA ASSINATURA'
      };
      var titleEl = document.getElementById('tipoConfigTitle');
      if (titleEl) titleEl.textContent = titles[tipo] || 'CONFIGURAÇÃO';
      var areaEl = document.getElementById('tipoConfigArea');
      if (areaEl) areaEl.innerHTML = renderTipoConfig(tipo, campos || {});
    } catch(e) {
      console.error('[Fluxo] Erro ao aplicar tipo:', e);
    }
  }

  var tipoGrid = document.getElementById('tipoGrid');
  if (tipoGrid) {
    tipoGrid.addEventListener('click', function(e) {
      var opt = e.target.closest('.tipo-opt');
      if (!opt) return;
      var tipo = opt.dataset.tipo;
      if (!tipo) return;
      _currentCampos = {};
      _applyTipo(tipo, {});
    });
  }

  window.selecionarTipo = function(tipo) {
    _currentCampos = {};
    _applyTipo(tipo, {});
  };

  // ── Painel configurar ────────────────────────────────────────
  function openPainel(etapa){
    document.getElementById('configEtapaId').value = etapa.id;
    document.getElementById('configNome').value    = etapa.nome||'';
    document.getElementById('configCodigo').value  = etapa.codigo||'';
    document.getElementById('configGrupo').value   = etapa.proprietario_id||'';
    document.getElementById('configPrazo').value   = etapa.prazo_em_dias!=null?etapa.prazo_em_dias:'';
    document.getElementById('configExigeAssinatura').checked = !!etapa.exige_assinatura;
    document.getElementById('configEhInicio').checked = !!etapa.eh_inicio;
    document.getElementById('configEhFim').checked    = !!etapa.eh_fim;

    var tipo = etapa.tipo_acao||'questionario';
    _currentCampos = JSON.parse(JSON.stringify(etapa.campos_requeridos || {}));
    _applyTipo(tipo, _currentCampos);

    var vinculados = (etapa.documentos_vinculados||[]).map(function(d){return String(d.template_id||'');});
    document.querySelectorAll('.config-doc-template').forEach(function(cb){ cb.checked=vinculados.indexOf(cb.value)>=0; });

    var anexos = anexosPorEtapa[etapa.id]||[];
    var lista = document.getElementById('configAnexosLista');
    lista.innerHTML = '';
    if (!anexos.length) { lista.innerHTML='<li style="font-size:12px;color:#94a3b8;">Nenhum anexo.</li>'; }
    else anexos.forEach(function(a){
      var li=document.createElement('li');
      li.style='display:flex;align-items:center;justify-content:space-between;gap:6px;padding:4px 8px;background:#f8fafc;border-radius:6px;font-size:12px;';
      li.innerHTML='<a href="/fluxos/'+fluxoId+'/etapas/'+etapa.id+'/anexos/'+a.id+'/download" style="color:#6366f1;text-decoration:none;flex:1;" target="_blank">'+(a.nome_original||a.nome_arquivo)+'</a>'+
        '<button type="button" class="btnRemoverAnexo" data-anexo-id="'+a.id+'" style="color:#ef4444;background:none;border:none;cursor:pointer;font-size:15px;line-height:1;">×</button>';
      lista.appendChild(li);
    });

    document.getElementById('painelConfig').classList.add('open');
    document.getElementById('painelConfigBackdrop').style.display='block';
  }

  function closePainel(){
    document.getElementById('painelConfig').classList.remove('open');
    document.getElementById('painelConfigBackdrop').style.display='none';
  }

  document.getElementById('btnFecharPainel').addEventListener('click',closePainel);
  document.getElementById('painelConfigBackdrop').addEventListener('click',closePainel);

  function getSelectedTipo(){
    var el = document.querySelector('#tipoGrid .tipo-opt.sel');
    return el ? el.dataset.tipo : 'questionario';
  }

  // ── Render configuração por tipo ─────────────────────────────
  function renderTipoConfig(tipo, campos){
    if (tipo==='questionario')    return renderQuestionario(campos);
    if (tipo==='aprovacao')       return renderAprovacao(campos);
    if (tipo==='assinatura_digital') return renderAssinatura(campos);
    return renderParecer(campos);
  }

  function renderQuestionario(campos){
    var perguntas = campos.perguntas||[];
    var html = '';
    if (perguntas.length > 0) {
      html += '<div style="margin-bottom:8px;">';
      perguntas.forEach(function(p,i){
        var tipoIcons={texto_curto:'📝',texto_longo:'📄',numero:'🔢',data:'📅',hora:'🕐',radio:'⊙',checkbox:'☑',selecao:'≡',arquivo:'📎',sim_nao:'↕',texto:'📝',textarea:'📄'};
        var icon = tipoIcons[p.tipo]||'❓';
        html+='<div style="display:flex;align-items:center;gap:6px;padding:6px 8px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:4px;font-size:12px;" class="dark:bg-slate-900 dark:border-slate-700">'+
              '<span>'+icon+'</span>'+
              '<span style="flex:1;color:#374151;font-weight:500;" class="dark:text-slate-300">'+(p.label||'Sem título')+'</span>'+
              (p.obrigatorio?'<span style="font-size:9px;color:#ef4444;font-weight:700;">OBRIG.</span>':'')+
              '</div>';
      });
      html += '</div>';
    } else {
      html += '<p style="font-size:12px;color:#94a3b8;text-align:center;padding:10px 0;">Nenhuma pergunta adicionada ainda.</p>';
    }
    html+='<button type="button" data-a="open-q" style="width:100%;padding:9px;font-size:12px;font-weight:600;color:#6366f1;background:#eef2ff;border:2px solid #c7d2fe;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">'+
          '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>'+
          'Gerenciar perguntas ('+perguntas.length+')</button>';
    return html;
  }

  function renderAprovacao(campos){
    var instrucoes = campos.instrucoes||'';
    var rejeicoes  = campos.opcoes_rejeicao||['Documentação incompleta','Fora do prazo','Não atende requisitos'];
    var rejHtml = rejeicoes.map(function(r){
      return '<div style="display:flex;gap:6px;align-items:center;margin-bottom:5px;">'+
             '<input type="text" value="'+escHtml(r)+'" placeholder="Motivo..." '+
             'style="flex:1;font-size:12px;border:1px solid #e2e8f0;border-radius:6px;padding:5px 8px;outline:none;" class="rej-input">'+
