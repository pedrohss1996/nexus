  // ── Salvar etapa ──────────────────────────────────────────────
  function doSalvar(){
    var etapaId=document.getElementById('configEtapaId').value;
    if(!etapaId){if(window.showToast)showToast('Nenhuma etapa selecionada.','warning');return;}
    var nome=document.getElementById('configNome').value.trim();
    if(!nome){if(window.showToast)showToast('Informe o nome da etapa.','warning');document.getElementById('configNome').focus();return;}
    var tipo=getSelectedTipo();
    var docs=Array.from(document.querySelectorAll('.config-doc-template:checked')).map(function(cb){return cb.value;});
    var body={
      nome:nome,
      codigo:document.getElementById('configCodigo').value.trim()||undefined,
      proprietario_id:document.getElementById('configGrupo').value||'',
      tipo_acao:tipo,
      prazo_em_dias:document.getElementById('configPrazo').value||'',
      exige_assinatura:document.getElementById('configExigeAssinatura').checked?'1':'0',
      eh_inicio:document.getElementById('configEhInicio').checked?'1':'0',
      eh_fim:document.getElementById('configEhFim').checked?'1':'0',
      campos_requeridos:JSON.stringify(collectCampos(tipo)),
      documento_templates:docs
    };
    var btn=document.getElementById('btnSalvarEtapa');
    btn.disabled=true; btn.textContent='Salvando...';
    fetch('/fluxos/'+fluxoId+'/etapas/'+etapaId,{
      method:'POST',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest','Accept':'application/json'},
      body:JSON.stringify(body)
    }).then(function(r){return r.json();})
      .then(function(d){
        if(d.success){if(window.showToast)showToast('Etapa salva!','success');closePainel();setTimeout(function(){location.reload();},700);}
        else{if(window.showToast)showToast(d.message||'Erro ao salvar.','error');btn.disabled=false;btn.textContent='Salvar';}
      }).catch(function(err){if(window.showToast)showToast('Erro de conexão.','error');console.error(err);btn.disabled=false;btn.textContent='Salvar';});
  }

  document.getElementById('btnSalvarEtapa').addEventListener('click', doSalvar);

