    fetch('/fluxos/<%= f.id %>/ai-suggest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ descricao: desc, grupos: gruposData })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      btn.disabled = false;
      iconEl.textContent = '✨';
      labelEl.textContent = 'Gerar fluxo com IA';
      if (!data.success) {
        var errEl = document.getElementById('aiError');
        errEl.textContent = data.message || 'Erro desconhecido.';
        errEl.style.display = 'block';
        return;
      }
      _aiSugestao = data.suggestion;
      renderAiPreview(data.suggestion);
      document.getElementById('aiStep1').style.display = 'none';
      document.getElementById('aiStep2').style.display = 'block';
    })
    .catch(function(err) {
      btn.disabled = false;
      iconEl.textContent = '✨';
      labelEl.textContent = 'Gerar fluxo com IA';
      var errEl = document.getElementById('aiError');
      errEl.textContent = 'Erro de conexão. Verifique sua internet e tente novamente.';
      errEl.style.display = 'block';
      console.error(err);
    });
  });

  function renderAiPreview(sug) {
    document.getElementById('aiTituloSugerido').textContent = sug.titulo_sugerido || 'Fluxo sugerido';
    document.getElementById('aiDescSugerida').textContent   = sug.descricao_sugerida || '';

    var container = document.getElementById('aiEtapasPreview');
    container.innerHTML = '';

    (sug.etapas || []).forEach(function(e) {
      var ti = AI_TIPO_INFO[e.tipo_acao] || { label: e.tipo_acao, icon: '📄', color: '#64748b' };

      var card = document.createElement('div');
      card.style.cssText = 'background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;overflow:hidden;';
      card.setAttribute('data-ordem', e.ordem);

      var header = document.createElement('div');
      header.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px 12px;background:'+ti.color+';';
      header.innerHTML = '<span style="font-size:14px;">'+ti.icon+'</span>'+
        '<span style="font-size:10px;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:.05em;flex:1;">'+ti.label+'</span>'+
        (e.eh_inicio ? '<span style="font-size:9px;background:rgba(255,255,255,.25);color:#fff;padding:1px 6px;border-radius:10px;font-weight:700;">▶ Início</span>' : '')+
        (e.eh_fim    ? '<span style="font-size:9px;background:rgba(255,255,255,.25);color:#fff;padding:1px 6px;border-radius:10px;font-weight:700;">■ Fim</span>' : '');

      var body = document.createElement('div');
      body.style.cssText = 'padding:10px 12px;';

      // Nome editável
      var nomeInput = document.createElement('input');
      nomeInput.type = 'text';
      nomeInput.value = e.nome || '';
      nomeInput.setAttribute('data-field', 'nome');
      nomeInput.setAttribute('data-ordem', e.ordem);
      nomeInput.style.cssText = 'width:100%;font-size:13px;font-weight:700;color:#1e293b;border:none;border-bottom:2px solid #e2e8f0;padding:2px 0 5px;background:transparent;outline:none;margin-bottom:8px;';
      nomeInput.addEventListener('change', function() {
        var ord = parseInt(this.getAttribute('data-ordem'),10);
        var etapa = (_aiSugestao.etapas||[]).find(function(x){return x.ordem===ord;});
        if (etapa) etapa.nome = this.value;
      });

      // Grupo selector
      var grupoDiv = document.createElement('div');
      grupoDiv.style.cssText = 'display:flex;align-items:center;gap:6px;';
      var grupoLabel = document.createElement('span');
      grupoLabel.style.cssText = 'font-size:11px;color:#94a3b8;white-space:nowrap;';
      grupoLabel.textContent = '👥 Grupo:';
      var grupoSelect = document.createElement('select');
      grupoSelect.setAttribute('data-field','grupo');
      grupoSelect.setAttribute('data-ordem', e.ordem);
      grupoSelect.style.cssText = 'flex:1;font-size:11px;border:1px solid #e2e8f0;border-radius:6px;padding:3px 6px;background:#fff;color:#374151;';
      var optNone = document.createElement('option');
      optNone.value = '';
      optNone.textContent = '— Sem grupo —';
      grupoSelect.appendChild(optNone);
      gruposData.forEach(function(g) {
        var opt = document.createElement('option');
        opt.value = String(g.id);
        opt.textContent = g.nome;
        if (String(e.grupo_id_sugerido) === String(g.id)) opt.selected = true;
        grupoSelect.appendChild(opt);
      });
      grupoSelect.addEventListener('change', function() {
        var ord = parseInt(this.getAttribute('data-ordem'),10);
        var etapa = (_aiSugestao.etapas||[]).find(function(x){return x.ordem===ord;});
        if (etapa) etapa._grupo_id_escolhido = this.value;
      });

      grupoDiv.appendChild(grupoLabel);
      grupoDiv.appendChild(grupoSelect);
      body.appendChild(nomeInput);
      body.appendChild(grupoDiv);
      card.appendChild(header);
      card.appendChild(body);
      container.appendChild(card);
    });

    // Mostrar edges como texto
    if (sug.edges && sug.edges.length > 0) {
      var edgesDiv = document.createElement('div');
      edgesDiv.style.cssText = 'margin-top:8px;padding:10px 12px;background:#f1f5f9;border-radius:8px;';
      edgesDiv.innerHTML = '<p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;margin:0 0 6px;">Conexões sugeridas</p>';
      sug.edges.forEach(function(edge) {
        var row = document.createElement('div');
        row.style.cssText = 'font-size:11px;color:#475569;margin-bottom:3px;display:flex;align-items:center;gap:6px;';
        var etapaO = (sug.etapas||[]).find(function(x){return x.ordem===edge.origem_ordem;});
        var etapaD = (sug.etapas||[]).find(function(x){return x.ordem===edge.destino_ordem;});
        var labelColor = edge.label==='Não'||edge.label==='Reprovado' ? '#ef4444' :
                         edge.label==='sempre' ? '#6366f1' : '#22c55e';
        row.innerHTML = '<span style="font-size:12px;">→</span>'+
          '<span style="color:#1e293b;font-weight:600;">'+(etapaO?etapaO.nome:'?')+'</span>'+
          '<span style="background:'+labelColor+';color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:10px;">'+edge.label+'</span>'+
          '<span style="color:#1e293b;font-weight:600;">'+(etapaD?etapaD.nome:'?')+'</span>';
        edgesDiv.appendChild(row);
      });
      container.appendChild(edgesDiv);
    }
  }

  // Criar etapas e edges no fluxo
  document.getElementById('btnAiCriar').addEventListener('click', function() {
    if (!_aiSugestao) return;
    var btn = document.getElementById('btnAiCriar');
    var iconEl  = document.getElementById('aiCriarIcon');
    var labelEl = document.getElementById('aiCriarLabel');
    btn.disabled = true;
    iconEl.textContent = '⏳';
    labelEl.textContent = 'Criando...';

    var etapas = _aiSugestao.etapas || [];
    var edges   = _aiSugestao.edges  || [];

    // Mapa ordem → id criado
    var ordemParaId = {};
    var colsPerRow = 3;
    var colSpacing = 290;
    var rowSpacing = 200;

    // Criar etapas sequencialmente
    var promise = Promise.resolve();
    etapas.forEach(function(e, i) {
      promise = promise.then(function() {
        // Atualizar nome se foi editado na preview
        var nomeInput = document.querySelector('[data-field="nome"][data-ordem="'+e.ordem+'"]');
        if (nomeInput) e.nome = nomeInput.value || e.nome;
        var grupoSelect = document.querySelector('[data-field="grupo"][data-ordem="'+e.ordem+'"]');
        var grupoId = grupoSelect ? grupoSelect.value : (e._grupo_id_escolhido || '');

        var col = i % colsPerRow;
        var row = Math.floor(i / colsPerRow);
        var posX = 60 + col * colSpacing;
        var posY = 60 + row * rowSpacing;

        return fetch('/fluxos/'+fluxoId+'/etapas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
          body: JSON.stringify({
            nome: e.nome,
            tipo_acao: e.tipo_acao || 'questionario',
            eh_inicio: e.eh_inicio ? '1' : '0',
            eh_fim:    e.eh_fim    ? '1' : '0',
            proprietario_id: grupoId || '',
            prazo_em_dias: e.prazo_em_dias || '',
            pos_x: posX,
            pos_y: posY
          })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.success && d.etapa) {
            ordemParaId[e.ordem] = d.etapa.id;
          }
        });
      });
    });

    // Depois criar edges
    promise = promise.then(function() {
      var ep = Promise.resolve();
      edges.forEach(function(edge) {
        ep = ep.then(function() {
          var origemId  = ordemParaId[edge.origem_ordem];
          var destinoId = ordemParaId[edge.destino_ordem];
          if (!origemId || !destinoId) return;
          return fetch('/fluxos/'+fluxoId+'/edges', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ etapa_origem_id: origemId, etapa_destino_id: destinoId, label: edge.label || 'sempre' })
          }).then(function(r){ return r.json(); });
        });
      });
      return ep;
    });

    promise.then(function() {
      closeModalAi();
      if (window.showToast) showToast('Fluxo criado pela IA! Recarregando...', 'success');
      setTimeout(function(){ location.reload(); }, 1000);
    }).catch(function(err) {
      btn.disabled = false;
      iconEl.textContent = '🚀';
      labelEl.textContent = 'Criar no fluxo';
      if (window.showToast) showToast('Erro ao criar etapas. Tente novamente.', 'error');
      console.error(err);
    });
  });

  // ── Helpers ───────────────────────────────────────────────────
  function escHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

  window.addEventListener('resize', drawConnections);
  var canvas = document.getElementById('fluxoCanvas');
  if (canvas) canvas.addEventListener('scroll', drawConnections);

  drawConnections();
  setTimeout(drawConnections, 200);
  window.addEventListener('load', drawConnections);
})();
</script>

