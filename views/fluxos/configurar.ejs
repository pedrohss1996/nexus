<!-- ══════════════════════════════════════════ -->
<!-- SCRIPT                                    -->
<!-- ══════════════════════════════════════════ -->
<script>
(function () {
  var fluxoId    = '<%= f.id %>';
  var etapasData = <%- JSON.stringify(etapasList.map(function(e){
    var cr={};try{cr=typeof e.campos_requeridos==='string'?JSON.parse(e.campos_requeridos):(e.campos_requeridos||{});}catch(_){}
    var dv=[];try{dv=typeof e.documentos_vinculados==='string'?JSON.parse(e.documentos_vinculados):(e.documentos_vinculados||[]);}catch(_){}
    return {id:e.id,nome:e.nome,codigo:e.codigo,ordem:e.ordem,eh_inicio:e.eh_inicio,eh_fim:e.eh_fim,
            proprietario_id:e.proprietario_id,proprietario_nome:e.proprietario_nome,
            tipo_acao:(e.tipo_acao==='parecer_tecnico'?'parecer':e.tipo_acao||'questionario'),
            prazo_em_dias:e.prazo_em_dias,exige_assinatura:e.exige_assinatura,
            campos_requeridos:cr,documentos_vinculados:dv,pos_x:e.pos_x,pos_y:e.pos_y};
  })) %>;
  var edgesData  = <%- JSON.stringify(edgesList.map(function(e){
    return {id:e.id,etapa_origem_id:e.etapa_origem_id,etapa_destino_id:e.etapa_destino_id,label:e.label||'sempre'};
  })) %>;
  var anexosPorEtapa = <%- JSON.stringify(typeof anexosPorEtapa!=='undefined'?anexosPorEtapa:{}) %>;

  // ── Drag ────────────────────────────────────────────────────
  var dragging   = null;
  var dragOffset = {x:0,y:0};
  var connectingFrom = null;

  function getEtapa(id) { return etapasData.find(function(e){return e.id===+id;}); }

  document.querySelectorAll('.fluxo-card').forEach(function(card){
    var etapaId = +card.dataset.etapaId;

    card.addEventListener('mousedown', function(e){
      if (e.target.closest('button,a')) return;
      if (e.shiftKey) {
        e.preventDefault();
        if (!connectingFrom) {
          connectingFrom = card;
          card.classList.add('connecting-source');
        } else if (connectingFrom === card) {
          card.classList.remove('connecting-source');
          connectingFrom = null;
        } else {
          var fromId = connectingFrom.dataset.etapaId;
          document.getElementById('conexaoOrigem').value = fromId;
          document.getElementById('conexaoDestino').value = etapaId;
          connectingFrom.classList.remove('connecting-source');
          connectingFrom = null;
          document.getElementById('modalConexao').style.display = 'block';
        }
        return;
      }
      dragging = card;
      var r = card.getBoundingClientRect();
      dragOffset = {x: e.clientX - r.left, y: e.clientY - r.top};
      card.classList.add('dragging');
      e.preventDefault();
    });

    card.addEventListener('dblclick', function(e){
      if (e.target.closest('button,a') || dragging) return;
      var etapa = getEtapa(etapaId);
      if (etapa) openPainel(etapa);
    });
  });

  document.addEventListener('mousemove', function(e){
    if (!dragging) return;
    var canvas = document.getElementById('fluxoCanvas');
    var cr = canvas.getBoundingClientRect();
    var x = e.clientX - cr.left - dragOffset.x + canvas.scrollLeft;
    var y = e.clientY - cr.top  - dragOffset.y + canvas.scrollTop;
    dragging.style.left = Math.max(0,x) + 'px';
    dragging.style.top  = Math.max(0,y) + 'px';
    drawConnections();
  });

  document.addEventListener('mouseup', function(){
    if (!dragging) return;
    var id = +dragging.dataset.etapaId;
    var x  = parseInt(dragging.style.left,10);
    var y  = parseInt(dragging.style.top ,10);
    fetch('/fluxos/'+fluxoId+'/etapas/'+id+'/posicao',{
      method:'PATCH',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      body:JSON.stringify({pos_x:x,pos_y:y})
    }).catch(function(){});
    dragging.classList.remove('dragging');
    dragging = null;
  });

  document.addEventListener('keydown', function(e){
    if (e.key==='Escape' && connectingFrom){
      connectingFrom.classList.remove('connecting-source');
      connectingFrom=null;
    }
  });

  // ── Desenhar conexões SVG ────────────────────────────────────
  function svgEl(tag){ return document.createElementNS('http://www.w3.org/2000/svg',tag); }

  // Retorna os pontos de borda do card (com direção de saída)
  function cardEdges(card){
    var canvas = document.getElementById('fluxoCanvas');
    var cr = canvas.getBoundingClientRect();
    var r  = card.getBoundingClientRect();
    var l = r.left - cr.left + canvas.scrollLeft;
    var t = r.top  - cr.top  + canvas.scrollTop;
    var w = r.width, h = r.height;
    return {
      cx: l + w/2, cy: t + h/2, w: w, h: h,
      right:  { x: l + w,   y: t + h/2, dir: 'right'  },
      left:   { x: l,       y: t + h/2, dir: 'left'   },
      bottom: { x: l + w/2, y: t + h,   dir: 'bottom' },
      top:    { x: l + w/2, y: t,       dir: 'top'    }
    };
  }

  // Caminho ortogonal com GAP para sair pela borda sem cruzar o card
  function orthoPath(p1, p2) {
    var GAP = 22;  // afasta o traçado da borda do card
    // Calcular ponto de saída (fora do card)
    var ex1x = p1.x + (p1.dir==='right'?GAP : p1.dir==='left'?-GAP : 0);
    var ex1y = p1.y + (p1.dir==='bottom'?GAP : p1.dir==='top'?-GAP : 0);
    // Calcular ponto de entrada (fora do card destino)
    var ex2x = p2.x + (p2.dir==='left'?GAP : p2.dir==='right'?-GAP : 0);
    var ex2y = p2.y + (p2.dir==='top'?GAP : p2.dir==='bottom'?-GAP : 0);

    if (p1.dir==='right' || p1.dir==='left') {
      // Sai horizontal → dobra vertical → entra
      return 'M '+p1.x+' '+p1.y+
             ' H '+ex1x+
             ' V '+ex2y+
             ' H '+p2.x;
    } else {
      // Sai vertical → dobra horizontal → entra
      return 'M '+p1.x+' '+p1.y+
             ' V '+ex1y+
             ' H '+ex2x+
             ' V '+p2.y;
    }
  }

  // Ponto médio visual do path para posicionar o label
  function pathMidPoint(p1, p2) {
    var GAP = 22;
    var ex1x = p1.x + (p1.dir==='right'?GAP : p1.dir==='left'?-GAP : 0);
    var ex1y = p1.y + (p1.dir==='bottom'?GAP : p1.dir==='top'?-GAP : 0);
    var ex2x = p2.x + (p2.dir==='left'?GAP : p2.dir==='right'?-GAP : 0);
    var ex2y = p2.y + (p2.dir==='top'?GAP : p2.dir==='bottom'?-GAP : 0);
    if (p1.dir==='right' || p1.dir==='left') {
      return { x: ex1x, y: (ex1y + ex2y) / 2 };
    } else {
      return { x: (ex1x + ex2x) / 2, y: ex1y };
    }
  }

  function drawConnections(){
    var svg    = document.getElementById('svgConexoes');
    var canvas = document.getElementById('fluxoCanvas');
    if (!svg || !canvas) return;

    // Garantir que o SVG cobre toda a área scrollável
    svg.setAttribute('width',  canvas.scrollWidth  + 'px');
    svg.setAttribute('height', canvas.scrollHeight + 'px');
    svg.innerHTML = '';

    // Arrowheads (orient="auto" orienta conforme direção final do path)
    var defs = svgEl('defs');
    [['ag','#22c55e'],['ar','#ef4444'],['agy','#6366f1']].forEach(function(pair){
      var m = svgEl('marker');
      m.setAttribute('id', pair[0]);
      m.setAttribute('markerWidth','10'); m.setAttribute('markerHeight','10');
      m.setAttribute('refX','9'); m.setAttribute('refY','3');
      m.setAttribute('orient','auto');
      var p = svgEl('polygon');
      p.setAttribute('points','0 0,10 3,0 6');
      p.setAttribute('fill', pair[1]);
      m.appendChild(p); defs.appendChild(m);
    });
    svg.appendChild(defs);

    edgesData.forEach(function(edge){
      var orig = document.getElementById('node-'+edge.etapa_origem_id);
      var dest = document.getElementById('node-'+edge.etapa_destino_id);
      if (!orig||!dest) return;

      var e1 = cardEdges(orig);
      var e2 = cardEdges(dest);

      // Escolher pontos de saída/entrada conforme posição relativa
      var p1, p2;
      var dx = e2.cx - e1.cx, dy = e2.cy - e1.cy;
      if (Math.abs(dx) >= Math.abs(dy)) {
        // Mover predominantemente na horizontal
        p1 = dx >= 0 ? e1.right  : e1.left;
        p2 = dx >= 0 ? e2.left   : e2.right;
      } else {
        // Mover predominantemente na vertical
        p1 = dy >= 0 ? e1.bottom : e1.top;
        p2 = dy >= 0 ? e2.top    : e2.bottom;
      }

      var lbl    = edge.label || 'sempre';
      var lLow   = lbl.toLowerCase();
      var color  = lLow.indexOf('não')>=0 || lLow.indexOf('reprov')>=0 ? '#ef4444' :
                   lLow==='sempre' ? '#6366f1' : '#22c55e';
      var arrow  = color==='#ef4444'?'ar': color==='#6366f1'?'agy':'ag';

      var d = orthoPath(p1, p2);

      // Ponto médio visual do caminho para o label
      var mid = pathMidPoint(p1, p2);
      var lx = mid.x, ly = mid.y;

      var g = svgEl('g');
      g.setAttribute('class','connection-group');
      g.setAttribute('data-edge-id', edge.id);
      g.addEventListener('click', function(){
        if (!confirm('Remover esta conexão?')) return;
        var eid = this.getAttribute('data-edge-id');
        fetch('/fluxos/'+fluxoId+'/edges/'+eid, {
          method:'DELETE', headers:{'X-Requested-With':'XMLHttpRequest'}
        }).then(function(r){return r.json();})
          .then(function(d){
            if(d.success){ edgesData=edgesData.filter(function(e){return String(e.id)!==String(eid);}); drawConnections(); if(window.showToast)showToast('Conexão removida.','success'); }
            else if(window.showToast) showToast(d.message||'Erro.','error');
          }).catch(function(){ if(window.showToast)showToast('Erro.','error'); });
      });

      // Linha de hit transparente (facilita clicar)
      var hit = svgEl('path');
      hit.setAttribute('d',d); hit.setAttribute('fill','none');
      hit.setAttribute('stroke','transparent'); hit.setAttribute('stroke-width','14');
      g.appendChild(hit);

      // Linha visível
      var line = svgEl('path');
      line.setAttribute('d',d); line.setAttribute('fill','none');
      line.setAttribute('stroke',color); line.setAttribute('stroke-width','2.5');
      line.setAttribute('stroke-linejoin','round');
      line.setAttribute('marker-end','url(#'+arrow+')');
      g.appendChild(line);

      // Label background
      var lblW = Math.max(44, lbl.length*7+10);
      var bg = svgEl('rect');
      bg.setAttribute('x', lx-lblW/2); bg.setAttribute('y', ly-9);
      bg.setAttribute('width', lblW);  bg.setAttribute('height','18');
      bg.setAttribute('fill','white'); bg.setAttribute('rx','4');
      bg.setAttribute('stroke',color); bg.setAttribute('stroke-width','1');
      g.appendChild(bg);

      // Ícone × ao hover
      var del = svgEl('text');
      del.setAttribute('x', lx+lblW/2-5); del.setAttribute('y', ly+4);
      del.setAttribute('text-anchor','middle'); del.setAttribute('font-size','11');
      del.setAttribute('font-weight','700'); del.setAttribute('fill','#ef4444');
      del.setAttribute('class','conn-del'); del.textContent='×';
      g.appendChild(del);

      // Texto do label
      var txt = svgEl('text');
      txt.setAttribute('x', lx); txt.setAttribute('y', ly+4);
      txt.setAttribute('text-anchor','middle'); txt.setAttribute('font-size','10');
      txt.setAttribute('font-weight','700'); txt.setAttribute('fill',color);
      txt.textContent = lbl;
      g.appendChild(txt);

      svg.appendChild(g);
    });
  }

  // ── Estado central do painel ──────────────────────────────────
  var _currentCampos = {}; // campos da etapa atualmente aberta

  // ── Aplicar tipo — atualiza visuais + área de config ─────────
  function _applyTipo(tipo, campos) {
    try {
      document.querySelectorAll('#tipoGrid .tipo-opt').forEach(function(el){
        el.classList.toggle('sel', el.dataset.tipo === tipo);
      });
      var titles = {
        questionario: 'PERGUNTAS DO QUESTIONÁRIO',
        aprovacao:    'CONFIGURAÇÃO DA APROVAÇÃO',
        parecer:      'CONFIGURAÇÃO DO PARECER'
      };
      var titleEl = document.getElementById('tipoConfigTitle');
      if (titleEl) titleEl.textContent = titles[tipo] || 'CONFIGURAÇÃO';
      var areaEl = document.getElementById('tipoConfigArea');
      if (areaEl) areaEl.innerHTML = renderTipoConfig(tipo, campos || {});
    } catch(e) {
      console.error('[Fluxo] Erro ao aplicar tipo:', e);
    }
  }

  // ── Event delegation: clique nos tipo-opt do painel ──────────
  var tipoGrid = document.getElementById('tipoGrid');
  if (tipoGrid) {
    tipoGrid.addEventListener('click', function(e) {
      var opt = e.target.closest('.tipo-opt');
      if (!opt) return;
      var tipo = opt.dataset.tipo;
      if (!tipo) return;
      // Ao mudar tipo manualmente: campos vazios (novo start)
      _currentCampos = {};
      _applyTipo(tipo, {});
    });
  }

  // Expor para retrocompatibilidade (onclick no modal)
  window.selecionarTipo = function(tipo) {
    _currentCampos = {};
    _applyTipo(tipo, {});
  };

  // ── Painel configurar ────────────────────────────────────────
  function openPainel(etapa){
    document.getElementById('configEtapaId').value = etapa.id;
    document.getElementById('configNome').value    = etapa.nome||'';
    document.getElementById('configCodigo').value  = etapa.codigo||'';
    document.getElementById('configGrupo').value   = etapa.proprietario_id||'';
    document.getElementById('configPrazo').value   = etapa.prazo_em_dias!=null?etapa.prazo_em_dias:'';
    document.getElementById('configExigeAssinatura').checked = !!etapa.exige_assinatura;
    document.getElementById('configEhInicio').checked = !!etapa.eh_inicio;
    document.getElementById('configEhFim').checked    = !!etapa.eh_fim;

    // Tipo — carrega campos SALVOS ao abrir painel existente
    var tipo = etapa.tipo_acao||'questionario';
    _currentCampos = JSON.parse(JSON.stringify(etapa.campos_requeridos || {}));
    _applyTipo(tipo, _currentCampos);

    // Docs
    var vinculados = (etapa.documentos_vinculados||[]).map(function(d){return String(d.template_id||'');});
    document.querySelectorAll('.config-doc-template').forEach(function(cb){ cb.checked=vinculados.indexOf(cb.value)>=0; });

    // Anexos
    var anexos = anexosPorEtapa[etapa.id]||[];
    var lista = document.getElementById('configAnexosLista');
    lista.innerHTML = '';
    if (!anexos.length) { lista.innerHTML='<li style="font-size:12px;color:#94a3b8;">Nenhum anexo.</li>'; }
    else anexos.forEach(function(a){
      var li=document.createElement('li');
      li.style='display:flex;align-items:center;justify-content:space-between;gap:6px;padding:4px 8px;background:#f8fafc;border-radius:6px;font-size:12px;';
      li.innerHTML='<a href="/fluxos/'+fluxoId+'/etapas/'+etapa.id+'/anexos/'+a.id+'/download" style="color:#6366f1;text-decoration:none;flex:1;truncate;" target="_blank">'+(a.nome_original||a.nome_arquivo)+'</a>'+
        '<button type="button" class="btnRemoverAnexo" data-anexo-id="'+a.id+'" style="color:#ef4444;background:none;border:none;cursor:pointer;font-size:15px;line-height:1;">×</button>';
      lista.appendChild(li);
    });

    document.getElementById('painelConfig').classList.add('open');
    document.getElementById('painelConfigBackdrop').style.display='block';
  }

  function closePainel(){
    document.getElementById('painelConfig').classList.remove('open');
    document.getElementById('painelConfigBackdrop').style.display='none';
  }

  document.getElementById('btnFecharPainel').addEventListener('click',closePainel);
  document.getElementById('painelConfigBackdrop').addEventListener('click',closePainel);

  function getSelectedTipo(){
    var el = document.querySelector('#tipoGrid .tipo-opt.sel');
    return el ? el.dataset.tipo : 'questionario';
  }

  // ── Render configuração por tipo ─────────────────────────────
  function renderTipoConfig(tipo, campos){
    if (tipo==='questionario') return renderQuestionario(campos);
    if (tipo==='aprovacao')    return renderAprovacao(campos);
    return renderParecer(campos);
  }

  /* Questionário */
  function renderQuestionario(campos){
    var perguntas = campos.perguntas||[];
    var html = '';
    if (perguntas.length > 0) {
      html += '<div style="margin-bottom:8px;">';
      perguntas.forEach(function(p,i){
        var tipoIcons={texto_curto:'📝',texto_longo:'📄',numero:'🔢',data:'📅',hora:'🕐',radio:'⊙',checkbox:'☑',selecao:'≡',arquivo:'📎',sim_nao:'↕',texto:'📝',textarea:'📄'};
        var icon = tipoIcons[p.tipo]||'❓';
        html+='<div style="display:flex;align-items:center;gap:6px;padding:6px 8px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:4px;font-size:12px;" class="dark:bg-slate-900 dark:border-slate-700">'+
              '<span>'+icon+'</span>'+
              '<span style="flex:1;color:#374151;font-weight:500;" class="dark:text-slate-300">'+(p.label||'Sem título')+'</span>'+
              (p.obrigatorio?'<span style="font-size:9px;color:#ef4444;font-weight:700;">OBRIG.</span>':'')+
              '</div>';
      });
      html += '</div>';
    } else {
      html += '<p style="font-size:12px;color:#94a3b8;text-align:center;padding:10px 0;">Nenhuma pergunta adicionada ainda.</p>';
    }
    html+='<button type="button" data-a="open-q" style="width:100%;padding:9px;font-size:12px;font-weight:600;color:#6366f1;background:#eef2ff;border:2px solid #c7d2fe;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">'+
          '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>'+
          'Gerenciar perguntas ('+perguntas.length+')</button>';
    return html;
  }

  function renderPergunta(p,i){
    var tipos=['texto','textarea','numero','data','selecao','sim_nao','arquivo'];
    var tiposLabel={texto:'Texto curto',textarea:'Texto longo',numero:'Número',data:'Data',selecao:'Seleção',sim_nao:'Sim/Não',arquivo:'Arquivo'};
    var optsHtml='';
    if (p.tipo==='selecao'){
      optsHtml='<div class="qb-opts" id="qb-opts-'+i+'">';
      (p.opcoes||[]).forEach(function(o,oi){
        optsHtml+='<div class="qb-opt-row"><input class="qb-opt-inp" type="text" value="'+escHtml(o)+'" placeholder="Opção '+(oi+1)+'">'+
                  '<span onclick="removeOpt('+i+','+oi+')" style="color:#ef4444;cursor:pointer;font-size:14px;line-height:1;">×</span></div>';
      });
      optsHtml+='<button type="button" onclick="addOpt('+i+')" style="font-size:11px;color:#6366f1;background:none;border:none;cursor:pointer;padding:2px 0;">+ Opção</button></div>';
    }
    return '<div class="qb-item" id="qb-item-'+i+'" data-pi="'+i+'">'+
      '<div class="qb-row">'+
      '<span class="qb-drag">⠿</span>'+
      '<span class="qb-num">'+(i+1)+'.</span>'+
      '<input class="qb-label" type="text" value="'+escHtml(p.label||'')+'" placeholder="Texto da pergunta...">'+
      '<select class="qb-tipo" onchange="changeTipoPergunta('+i+',this.value)">'+
      tipos.map(function(t){return '<option value="'+t+'"'+(p.tipo===t?' selected':'')+'>'+tiposLabel[t]+'</option>';}).join('')+
      '</select>'+
      '<label class="qb-req"><input type="checkbox"'+(p.obrigatorio?' checked':'')+'> Obrig.</label>'+
      '<span class="qb-del" onclick="removePergunta('+i+')" title="Remover">×</span>'+
      '</div>'+optsHtml+'</div>';
  }

  window.addPergunta = function(){
    var list = collectPerguntas();
    list.push({label:'',tipo:'texto',obrigatorio:false});
    document.getElementById('qb-list').innerHTML = list.map(renderPergunta).join('');
  };
  window.removePergunta = function(i){
    var list=collectPerguntas(); list.splice(i,1);
    document.getElementById('qb-list').innerHTML=list.map(renderPergunta).join('');
  };
  window.changeTipoPergunta = function(i,tipo){
    var list=collectPerguntas(); list[i].tipo=tipo; list[i].opcoes=tipo==='selecao'?(list[i].opcoes||['']):undefined;
    document.getElementById('qb-list').innerHTML=list.map(renderPergunta).join('');
  };
  window.addOpt = function(pi){
    var list=collectPerguntas(); list[pi].opcoes=(list[pi].opcoes||[]); list[pi].opcoes.push('');
    document.getElementById('qb-list').innerHTML=list.map(renderPergunta).join('');
  };
  window.removeOpt = function(pi,oi){
    var list=collectPerguntas(); list[pi].opcoes.splice(oi,1);
    document.getElementById('qb-list').innerHTML=list.map(renderPergunta).join('');
  };

  function collectPerguntas(){
    var items=document.querySelectorAll('#qb-list .qb-item');
    return Array.from(items).map(function(item){
      var tipo=item.querySelector('.qb-tipo').value;
      var opcoes=null;
      if(tipo==='selecao'){ opcoes=Array.from(item.querySelectorAll('.qb-opt-inp')).map(function(i){return i.value.trim();}).filter(Boolean); }
      return {label:item.querySelector('.qb-label').value,tipo:tipo,obrigatorio:item.querySelector('input[type="checkbox"]').checked,opcoes:opcoes};
    });
  }

  /* Aprovação */
  function renderAprovacao(campos){
    var instrucoes = campos.instrucoes||'';
    var rejeicoes  = campos.opcoes_rejeicao||['Documentação incompleta','Fora do prazo','Não atende requisitos'];
    var rejHtml = rejeicoes.map(function(r){
      return '<div style="display:flex;gap:6px;align-items:center;margin-bottom:5px;">'+
             '<input type="text" value="'+escHtml(r)+'" placeholder="Motivo..." '+
             'style="flex:1;font-size:12px;border:1px solid #e2e8f0;border-radius:6px;padding:5px 8px;outline:none;" class="rej-input">'+
             '<button type="button" data-rej-rm style="color:#ef4444;background:none;border:none;cursor:pointer;font-size:20px;line-height:1;padding:0 2px;">×</button>'+
             '</div>';
    }).join('');
    var html = '<div style="margin-bottom:12px;">'+
               '<label class="fl-label">Instruções para o aprovador</label>'+
               '<textarea class="fl-textarea" id="ed-instrucoes" placeholder="Critérios de aprovação...">'+escHtml(instrucoes)+'</textarea>'+
               '</div>'+
               '<div>'+
               '<label class="fl-label">Motivos de rejeição</label>'+
               '<div id="rej-list">'+rejHtml+'</div>'+
               '<button type="button" id="btnAddRej" style="font-size:12px;color:#ef4444;background:none;border:2px dashed #fecaca;border-radius:7px;padding:6px 12px;cursor:pointer;width:100%;margin-top:4px;">+ Motivo</button>'+
               '</div>';
    return html;
  }

  // ── Listener único para tipoConfigArea (delegation de tudo) ──
  document.getElementById('tipoConfigArea').addEventListener('click', function(e) {
    // Abrir modal de perguntas
    if (e.target.closest('[data-a="open-q"]')) {
      abrirModalPerguntasInterno();
      return;
    }
    // Remover motivo de rejeição
    if (e.target.closest('[data-rej-rm]')) {
      e.target.closest('[data-rej-rm]').parentElement.remove();
      return;
    }
    // Adicionar motivo de rejeição
    if (e.target.closest('#btnAddRej')) {
      var div = document.createElement('div');
      div.style.cssText = 'display:flex;gap:6px;align-items:center;margin-bottom:5px;';
      div.innerHTML = '<input type="text" placeholder="Motivo..." '+
        'style="flex:1;font-size:12px;border:1px solid #e2e8f0;border-radius:6px;padding:5px 8px;outline:none;" class="rej-input">'+
        '<button type="button" data-rej-rm style="color:#ef4444;background:none;border:none;cursor:pointer;font-size:20px;line-height:1;padding:0 2px;">×</button>';
      var rejList = document.getElementById('rej-list');
      if (rejList) rejList.appendChild(div);
    }
  });

  function collectRejeicoes(){
    return Array.from(document.querySelectorAll('#rej-list .rej-input'))
      .map(function(i){ return i.value.trim(); }).filter(Boolean);
  }

  /* Parecer */
  function renderParecer(campos){
    return '<div style="margin-bottom:12px;"><label class="fl-label">Instruções para o parecerista</label>'+
           '<textarea class="fl-textarea" id="ed-instrucoes" placeholder="O que deve ser avaliado...">'+escHtml(campos.instrucoes||'')+'</textarea></div>'+
           '<div><label class="fl-label">Texto modelo (opcional)</label>'+
           '<textarea class="fl-textarea" id="ed-modelo" style="min-height:90px;" placeholder="Considerando os documentos...">'+escHtml(campos.modelo_texto||'')+'</textarea></div>';
  }

  /* Coletar campos_requeridos — questionario usa _currentCampos */
  function collectCampos(tipo){
    if(tipo==='questionario') {
      // Perguntas gerenciadas pelo modal; _currentCampos.perguntas é a fonte da verdade
      return { perguntas: _currentCampos.perguntas || [] };
    }
    if(tipo==='aprovacao'){
      var i=document.getElementById('ed-instrucoes');
      return {instrucoes:i?i.value:'',opcoes_rejeicao:collectRejeicoes()};
    }
    var i2=document.getElementById('ed-instrucoes'),m=document.getElementById('ed-modelo');
    return {instrucoes:i2?i2.value:'',modelo_texto:m?m.value:''};
  }

  // ── Salvar etapa (via click, não form submit) ─────────────────
  function doSalvar(){
    var etapaId=document.getElementById('configEtapaId').value;
    if(!etapaId){if(window.showToast)showToast('Nenhuma etapa selecionada.','warning');return;}
    var nome=document.getElementById('configNome').value.trim();
    if(!nome){if(window.showToast)showToast('Informe o nome da etapa.','warning');document.getElementById('configNome').focus();return;}
    var tipo=getSelectedTipo();
    var docs=Array.from(document.querySelectorAll('.config-doc-template:checked')).map(function(cb){return cb.value;});
    var body={
      nome:nome,
      codigo:document.getElementById('configCodigo').value.trim()||undefined,
      proprietario_id:document.getElementById('configGrupo').value||'',
      tipo_acao:tipo,
      prazo_em_dias:document.getElementById('configPrazo').value||'',
      exige_assinatura:document.getElementById('configExigeAssinatura').checked?'1':'0',
      eh_inicio:document.getElementById('configEhInicio').checked?'1':'0',
      eh_fim:document.getElementById('configEhFim').checked?'1':'0',
      campos_requeridos:JSON.stringify(collectCampos(tipo)),
      documento_templates:docs
    };
    var btn=document.getElementById('btnSalvarEtapa');
    btn.disabled=true; btn.textContent='Salvando...';
    fetch('/fluxos/'+fluxoId+'/etapas/'+etapaId,{
      method:'POST',
      headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest','Accept':'application/json'},
      body:JSON.stringify(body)
    }).then(function(r){return r.json();})
      .then(function(d){
        if(d.success){if(window.showToast)showToast('Etapa salva!','success');closePainel();setTimeout(function(){location.reload();},700);}
        else{if(window.showToast)showToast(d.message||'Erro ao salvar.','error');btn.disabled=false;btn.textContent='Salvar';}
      }).catch(function(err){if(window.showToast)showToast('Erro de conexão.','error');console.error(err);btn.disabled=false;btn.textContent='Salvar';});
  }

  document.getElementById('btnSalvarEtapa').addEventListener('click', doSalvar);

  // ── Remover etapa ─────────────────────────────────────────────
  document.getElementById('btnRemoverEtapa').addEventListener('click',function(){
    var id=document.getElementById('configEtapaId').value;
    if(!id||!confirm('Remover esta etapa? As conexões relacionadas também serão removidas.')) return;
    fetch('/fluxos/'+fluxoId+'/etapas/'+id,{method:'DELETE',headers:{'X-Requested-With':'XMLHttpRequest'}})
      .then(function(r){return r.json();})
      .then(function(d){
        if(d.success){if(window.showToast)showToast('Etapa removida.','success');closePainel();setTimeout(function(){location.reload();},700);}
        else if(window.showToast)showToast(d.message||'Erro.','error');
      }).catch(function(){if(window.showToast)showToast('Erro.','error');});
  });

  // ── Modal adicionar etapa ─────────────────────────────────────
  document.getElementById('btnAdicionarEtapa').addEventListener('click',function(){document.getElementById('modalEtapa').style.display='block';setTimeout(function(){document.getElementById('novaNome').focus();},80);});
  document.getElementById('btnFecharModalEtapa').addEventListener('click',function(){document.getElementById('modalEtapa').style.display='none';});
  document.getElementById('modalEtapaBackdrop').addEventListener('click',function(){document.getElementById('modalEtapa').style.display='none';});

  // ── Seletor de tipo do modal "nova etapa" (event delegation) ──
  var novoTipoGrid = document.getElementById('novoTipoGrid');
  if (novoTipoGrid) {
    novoTipoGrid.addEventListener('click', function(e) {
      var opt = e.target.closest('[data-novo-tipo]');
      if (!opt) return;
      var tipo = opt.dataset.novoTipo;
      // Destacar selecionado
      novoTipoGrid.querySelectorAll('.tipo-opt').forEach(function(el) {
        el.classList.toggle('sel', el.dataset.novoTipo === tipo);
        el.style.borderColor = el.dataset.novoTipo === tipo ? '#6366f1' : '';
        el.style.background  = el.dataset.novoTipo === tipo ? '#eef2ff' : '';
      });
      // Atualizar campo hidden
      var hidden = document.getElementById('novoTipoValor');
      if (hidden) hidden.value = tipo;
    });
  }

  // ── Modal conexão ─────────────────────────────────────────────
  document.getElementById('btnFecharModalConexao').addEventListener('click',function(){document.getElementById('modalConexao').style.display='none';});
  document.getElementById('modalConexaoBackdrop').addEventListener('click',function(){document.getElementById('modalConexao').style.display='none';});

  document.getElementById('formConexao').addEventListener('submit',function(e){
    e.preventDefault();
    var origem=document.getElementById('conexaoOrigem').value;
    var destino=document.getElementById('conexaoDestino').value;
    var label=document.getElementById('conexaoLabel').value;
    if(!origem||!destino) return;
    fetch('/fluxos/'+fluxoId+'/edges',{
      method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      body:JSON.stringify({etapa_origem_id:origem,etapa_destino_id:destino,label:label})
    }).then(function(r){return r.json();})
      .then(function(d){
        if(d.success){document.getElementById('modalConexao').style.display='none';if(window.showToast)showToast('Conexão criada!','success');edgesData.push(d.edge);drawConnections();}
        else if(window.showToast)showToast(d.message||'Erro.','error');
      }).catch(function(){if(window.showToast)showToast('Erro.','error');});
  });

  // ── Anexos ────────────────────────────────────────────────────
  document.getElementById('formAnexoEtapa').addEventListener('submit',function(e){
    e.preventDefault();
    var id=document.getElementById('configEtapaId').value;
    var input=document.getElementById('inputAnexoEtapa');
    if(!id||!input.files||!input.files[0]){if(window.showToast)showToast('Selecione um arquivo.','warning');return;}
    var fd=new FormData(); fd.append('arquivo',input.files[0]);
    fetch('/fluxos/'+fluxoId+'/etapas/'+id+'/anexos',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}})
      .then(function(r){return r.json();})
      .then(function(d){if(d.success){input.value='';if(window.showToast)showToast('Arquivo anexado!','success');location.reload();}else if(window.showToast)showToast(d.message||'Erro.','error');})
      .catch(function(){if(window.showToast)showToast('Erro.','error');});
  });

  document.getElementById('configAnexosLista').addEventListener('click',function(e){
    var btn=e.target.closest('.btnRemoverAnexo'); if(!btn) return;
    var anexoId=btn.dataset.anexoId, etapaId=document.getElementById('configEtapaId').value;
    if(!confirm('Remover este anexo?')) return;
    fetch('/fluxos/'+fluxoId+'/etapas/'+etapaId+'/anexos/'+anexoId,{method:'DELETE',headers:{'X-Requested-With':'XMLHttpRequest'}})
      .then(function(r){return r.json();})
      .then(function(d){if(d.success){if(window.showToast)showToast('Anexo removido.','success');location.reload();}else if(window.showToast)showToast(d.message||'Erro.','error');})
      .catch(function(){if(window.showToast)showToast('Erro.','error');});
  });

  // ── Modal de Perguntas ────────────────────────────────────────
  var _perguntasTemp = []; // cópia de trabalho no modal

  var TIPO_PERGUNTA_INFO = {
    texto_curto: { icon:'📝', label:'Texto curto' },
    texto_longo: { icon:'📄', label:'Texto longo' },
    numero:      { icon:'🔢', label:'Número' },
    data:        { icon:'📅', label:'Data' },
    hora:        { icon:'🕐', label:'Hora' },
    radio:       { icon:'⊙',  label:'Seleção única (radio)' },
    checkbox:    { icon:'☑',  label:'Múltipla escolha' },
    selecao:     { icon:'≡',  label:'Lista suspensa' },
    arquivo:     { icon:'📎', label:'Anexo/Arquivo' },
    sim_nao:     { icon:'↕',  label:'Sim ou Não' }
  };

  // ── Modal de Perguntas ────────────────────────────────────────
  // Função interna (não precisa ser global)
  function abrirModalPerguntasInterno() {
    _perguntasTemp = JSON.parse(JSON.stringify(_currentCampos.perguntas || []));
    renderModalPerguntas();
    var modal = document.getElementById('modalPerguntas');
    if (modal) modal.style.display = 'flex';
  }
  // Expor para retrocompatibilidade
  window.abrirModalPerguntas = abrirModalPerguntasInterno;

  window.fecharModalPerguntas = function() {
    var modal = document.getElementById('modalPerguntas');
    if (modal) modal.style.display = 'none';
  };

  function renderModalPerguntas() {
    var container = document.getElementById('modalQ-perguntas');
    if (!container) return;

    var html = '';
    if (_perguntasTemp.length === 0) {
      html = '<p style="text-align:center;padding:24px;color:#94a3b8;font-size:13px;">Nenhuma pergunta.<br>Use os botões abaixo para adicionar.</p>';
    } else {
      _perguntasTemp.forEach(function(p, i) {
        var info = TIPO_PERGUNTA_INFO[p.tipo] || { icon:'❓', label: p.tipo };
        var temOpts = p.tipo==='radio' || p.tipo==='checkbox' || p.tipo==='selecao';
        var optsHtml = '';
        if (temOpts) {
          optsHtml += '<div style="margin-top:8px;padding-left:12px;border-left:3px solid #c7d2fe;">';
          optsHtml += '<div style="font-size:10px;font-weight:700;color:#94a3b8;margin-bottom:4px;">OPÇÕES</div>';
          (p.opcoes || []).forEach(function(o, oi) {
            optsHtml += '<div style="display:flex;gap:5px;align-items:center;margin-bottom:4px;">'+
              '<input type="text" value="'+escHtml(o)+'" placeholder="Opção '+(oi+1)+'" '+
              'data-mq="opt-val" data-i="'+i+'" data-oi="'+oi+'" '+
              'style="flex:1;font-size:12px;border:1px solid #e2e8f0;border-radius:5px;padding:5px 8px;outline:none;">'+
              '<button type="button" data-mq="rm-opt" data-i="'+i+'" data-oi="'+oi+'" '+
              'style="color:#ef4444;background:none;border:none;cursor:pointer;font-size:18px;line-height:1;flex-shrink:0;">×</button>'+
              '</div>';
          });
          optsHtml += '<button type="button" data-mq="add-opt" data-i="'+i+'" '+
            'style="font-size:11px;color:#6366f1;background:#eef2ff;border:1px solid #c7d2fe;border-radius:5px;padding:3px 10px;cursor:pointer;margin-top:2px;">+ Opção</button>';
          optsHtml += '</div>';
        }

        html += '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px;margin-bottom:10px;">'+
          '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">'+
          '<span style="font-size:20px;flex-shrink:0;">'+info.icon+'</span>'+
          '<input type="text" value="'+escHtml(p.label||'')+'" placeholder="Texto da pergunta..." '+
          'data-mq="lbl" data-i="'+i+'" '+
          'style="flex:1;min-width:0;font-size:13px;font-weight:600;border:1px solid #e2e8f0;border-radius:7px;padding:6px 10px;outline:none;">'+
          '<button type="button" data-mq="rm-q" data-i="'+i+'" title="Remover pergunta" '+
          'style="color:#ef4444;background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:5px 9px;cursor:pointer;font-size:14px;font-weight:700;flex-shrink:0;">✕</button>'+
          '</div>'+
          '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">'+
          '<select data-mq="tipo" data-i="'+i+'" '+
          'style="font-size:12px;border:1px solid #e2e8f0;border-radius:6px;padding:5px 8px;background:#fff;outline:none;cursor:pointer;">'+
          Object.keys(TIPO_PERGUNTA_INFO).map(function(t){
            return '<option value="'+t+'"'+(p.tipo===t?' selected':'')+'>'+TIPO_PERGUNTA_INFO[t].icon+' '+TIPO_PERGUNTA_INFO[t].label+'</option>';
          }).join('')+
          '</select>'+
          '<label style="display:flex;align-items:center;gap:5px;font-size:12px;color:#475569;cursor:pointer;">'+
          '<input type="checkbox" data-mq="req" data-i="'+i+'"'+(p.obrigatorio?' checked':'')+' style="width:14px;height:14px;cursor:pointer;"> Obrigatório</label>'+
          '</div>'+
          optsHtml+'</div>';
      });
    }

    container.innerHTML = html;
    // NÃO adiciona listeners aqui (eles já estão no container, adicionados 1 vez abaixo)
  }

  // Listeners do modal — adicionados UMA ÚNICA VEZ após a página carregar
  (function initModalListeners() {
    var mq = document.getElementById('modalQ-perguntas');
    if (!mq) return;

    function mqHandle(e) {
      var el = e.target.closest('[data-mq]');
      if (!el) return;
      var a  = el.dataset.mq;
      var i  = parseInt(el.dataset.i, 10);
      var oi = parseInt(el.dataset.oi, 10);
      var tipos3 = ['radio','checkbox','selecao'];

      if (a==='lbl'     && e.type==='input')  { _perguntasTemp[i].label = el.value; return; }
      if (a==='req'     && e.type==='change') { _perguntasTemp[i].obrigatorio = el.checked; return; }
      if (a==='opt-val' && e.type==='input')  {
        if (!_perguntasTemp[i].opcoes) _perguntasTemp[i].opcoes = [];
        _perguntasTemp[i].opcoes[oi] = el.value;
        return;
      }
      if (a==='tipo' && e.type==='change') {
        _perguntasTemp[i].tipo = el.value;
        _perguntasTemp[i].opcoes = (tipos3.indexOf(el.value)>=0) ? (_perguntasTemp[i].opcoes||['']) : undefined;
        renderModalPerguntas(); return;
      }
      if (a==='rm-q'    && e.type==='click') { _perguntasTemp.splice(i,1); renderModalPerguntas(); return; }
      if (a==='add-opt' && e.type==='click') {
        if (!_perguntasTemp[i].opcoes) _perguntasTemp[i].opcoes = [];
        _perguntasTemp[i].opcoes.push('');
        renderModalPerguntas(); return;
      }
      if (a==='rm-opt'  && e.type==='click') {
        _perguntasTemp[i].opcoes.splice(oi,1);
        renderModalPerguntas(); return;
      }
    }

    mq.addEventListener('input',  mqHandle);
    mq.addEventListener('change', mqHandle);
    mq.addEventListener('click',  mqHandle);
  })();

  // Botões tipo de pergunta no footer do modal
  (function initAddBtns() {
    var footer = document.querySelector('#modalPerguntas .mq-add-footer');
    if (!footer) return;
    footer.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-tipo-add]');
      if (!btn) return;
      var tipo = btn.dataset.tipoAdd;
      var nova = { label: '', tipo: tipo, obrigatorio: false };
      if (tipo==='radio'||tipo==='checkbox'||tipo==='selecao') nova.opcoes = ['',''];
      _perguntasTemp.push(nova);
      renderModalPerguntas();
      var content = document.querySelector('#modalPerguntas .mq-content');
      if (content) setTimeout(function(){ content.scrollTop = content.scrollHeight; }, 50);
    });
  })();

  // Botões salvar/fechar do modal (todos por ID, sem inline onclick)
  (function initModalBtns() {
    var btnSalvar  = document.getElementById('btnSalvarPerguntas');
    var btnFechar  = document.getElementById('btnFecharPerguntas');
    var btnFechar2 = document.getElementById('btnCancelarPerguntas');
    var backdrop   = document.getElementById('mqBackdrop');

    function salvarQ() {
      _currentCampos.perguntas = JSON.parse(JSON.stringify(_perguntasTemp));
      _applyTipo('questionario', _currentCampos);
      fecharModalPerguntas();
      if (window.showToast) showToast(_perguntasTemp.length+' pergunta(s). Clique em Salvar para gravar.','success');
    }

    if (btnSalvar)  btnSalvar.addEventListener('click', salvarQ);
    if (btnFechar)  btnFechar.addEventListener('click',  fecharModalPerguntas);
    if (btnFechar2) btnFechar2.addEventListener('click', fecharModalPerguntas);
    if (backdrop)   backdrop.addEventListener('click',   fecharModalPerguntas);
  })();

  // ── Helpers ───────────────────────────────────────────────────
  function escHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

  window.addEventListener('resize', drawConnections);
  var canvas = document.getElementById('fluxoCanvas');
  if (canvas) canvas.addEventListener('scroll', drawConnections);

  // Desenhar imediatamente E depois do layout completo
  drawConnections();
  setTimeout(drawConnections, 200);
  window.addEventListener('load', drawConnections);
})();
</script>

