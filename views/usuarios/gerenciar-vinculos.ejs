<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Gerenciar Vínculos - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-600">
    <a href="/cadastros/usuarios" class="hover:text-teal-600">Usuários</a>
    <span class="mx-2">/</span>
    <a href="/cadastros/usuarios/<%= usuario.id %>" class="hover:text-teal-600"><%= usuario.nome %></a>
    <span class="mx-2">/</span>
    <span class="text-gray-900">Gerenciar Vínculos</span>
  </nav>

  <!-- Cabeçalho -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-center">
      <div class="w-16 h-16 bg-gradient-to-br from-teal-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-bold text-2xl mr-4">
        <%= usuario.nome.charAt(0).toUpperCase() %>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= usuario.nome %></h1>
        <p class="text-sm text-gray-600"><%= usuario.email %></p>
      </div>
    </div>
  </div>

  <!-- Adicionar Novo Vínculo -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Adicionar Novo Vínculo</h2>
    
    <form method="POST" action="/cadastros/usuarios/<%= usuario.id %>/vinculos" class="grid grid-cols-1 md:grid-cols-4 gap-4">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Unidade</label>
        <select name="unidade_id" required class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
          <option value="">Selecione...</option>
          <% unidades.forEach(unidade => { %>
            <option value="<%= unidade.id %>"><%= unidade.nome %></option>
          <% }); %>
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Grupo</label>
        <select name="grupo_id" required class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
          <option value="">Selecione...</option>
          <% grupos.forEach(grupo => { %>
            <option value="<%= grupo.id %>" data-unidade="<%= grupo.unidade_id %>">
              <%= grupo.nome %> (<%= grupo.unidade_nome %>)
            </option>
          <% }); %>
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Função</label>
        <select name="is_lider" required class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
          <option value="false">Membro</option>
          <option value="true">Líder</option>
        </select>
      </div>
      
      <div class="flex items-end">
        <button type="submit" class="w-full bg-gradient-to-r from-teal-500 to-emerald-500 text-white px-4 py-2 rounded-lg hover:from-teal-600 hover:to-emerald-600 transition-all text-sm font-medium">
          Adicionar
        </button>
      </div>
    </form>
  </div>

  <!-- Vínculos Atuais -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-6">Vínculos Atuais</h2>
    
    <% if (vinculos.length === 0) { %>
      <div class="text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Nenhum vínculo ainda</h3>
        <p class="text-gray-600">Adicione o primeiro vínculo usando o formulário acima.</p>
      </div>
    <% } else { %>
      <!-- Agrupar por Unidade -->
      <% 
        const vinculosPorUnidade = {};
        vinculos.forEach(v => {
          if (!vinculosPorUnidade[v.unidade_nome]) {
            vinculosPorUnidade[v.unidade_nome] = [];
          }
          vinculosPorUnidade[v.unidade_nome].push(v);
        });
      %>
      
      <div class="space-y-6">
        <% Object.keys(vinculosPorUnidade).forEach(unidadeNome => { %>
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center mb-4">
              <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <h3 class="text-lg font-semibold text-gray-900"><%= unidadeNome %></h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <% vinculosPorUnidade[unidadeNome].forEach(vinculo => { %>
                <div class="border border-gray-200 rounded-lg p-3 hover:border-teal-500 transition-colors">
                  <div class="flex items-start justify-between mb-2">
                    <h4 class="font-semibold text-gray-900 text-sm"><%= vinculo.grupo_nome %></h4>
                    <% if (vinculo.is_lider) { %>
                      <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-amber-100 text-amber-800">
                        Líder
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                        Membro
                      </span>
                    <% } %>
                  </div>
                  <p class="text-xs text-gray-600 mb-3">
                    Desde <%= new Date(vinculo.vinculo_criado_em).toLocaleDateString('pt-BR') %>
                  </p>
                  <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
                    <button 
                      onclick="removerVinculo(<%= vinculo.grupo_id %>, <%= vinculo.usuario_id %>)"
                      class="text-xs text-red-600 hover:text-red-900 font-medium"
                    >
                      Remover
                    </button>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
<script>
async function removerVinculo(grupoId, usuarioId) {
  if (!confirm('Deseja realmente remover este vínculo?')) return;
  
  try {
    const response = await fetch(`/grupos/${grupoId}/membros/${usuarioId}`, {
      method: 'DELETE'
    });
    
    if (response.ok) {
      location.reload();
    } else {
      alert('Erro ao remover vínculo');
    }
  } catch (error) {
    alert('Erro ao remover vínculo');
  }
}
</script>
<% } %>

<%- include('../partials/footer') %>
