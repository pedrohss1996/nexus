<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Acesso - Nexus', user: typeof user !== 'undefined' ? user : null }) %>
<%
  var totalUnidadesAtivas = acessos.filter(function (u) { return u.ativa; }).length;
  var podeLiderar = typeof user !== 'undefined' && (user.perfil === 'admin' || user.perfil === 'gestor');
%>

<div class="dash">
  <nav class="mb-3 text-sm text-muted" aria-label="Trilha">
    <a href="/cadastros/usuarios" class="hover:text-ink">Usuários</a>
    <span class="mx-1.5">/</span>
    <a href="/cadastros/usuarios/<%= usuario.id %>" class="hover:text-ink"><%= usuario.nome %></a>
  </nav>

  <h1 class="text-2xl font-semibold tracking-tight text-ink">Acesso às unidades</h1>
  <p class="mt-1 text-sm text-muted">
    <span class="text-ink"><%= usuario.nome %></span> · <%= usuario.email %>
    <% if (usuario.perfil === 'admin') { %> · administrador: enxerga todas as unidades, os grupos abaixo definem só as tarefas que recebe<% } %>
  </p>

  <% if (ok) { %>
    <p class="mt-4 rounded-md border border-green-200 bg-green-50 px-4 py-2.5 text-sm text-green-800 dark:border-green-900 dark:bg-green-950 dark:text-green-200" role="status"><%= ok %></p>
  <% } %>
  <% if (erro) { %>
    <p class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200" role="alert"><%= erro %></p>
  <% } %>

  <% if (totalUnidadesAtivas === 0 && usuario.perfil !== 'admin') { %>
    <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200">
      Este usuário não tem acesso a nenhuma unidade ativa: ele entra no sistema mas não vê nada. Dê acesso abaixo.
    </p>
  <% } %>

  <div class="mt-6 grid items-start gap-4 lg:grid-cols-2">
  <!-- Dar acesso: um único campo, unidade → grupo -->
  <section class="panel" aria-labelledby="t-dar">
    <header class="panel-head">
      <h2 id="t-dar" class="panel-title">Dar acesso</h2>
    </header>
    <% if (unidadesAcesso.length === 0) { %>
      <p class="panel-empty">Não há outra unidade ou grupo disponível para este usuário.
        <% if (typeof user !== 'undefined' && user.perfil === 'admin') { %><a href="/unidades/novo" class="panel-link">Cadastrar unidade</a><% } %></p>
    <% } else { %>
      <form method="POST" action="/cadastros/usuarios/<%= usuario.id %>/vinculos" class="flex flex-col gap-3 px-5 pb-5 sm:flex-row sm:items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="min-w-0 flex-1">
          <label for="grupo_id" class="mb-1.5 block text-sm font-medium text-ink">Unidade e grupo</label>
          <select id="grupo_id" name="grupo_id" required class="input-field">
            <% unidadesAcesso.forEach(function (un) { %>
              <optgroup label="<%= un.nome %>">
                <% un.grupos.forEach(function (g) { %>
                  <option value="<%= g.id %>"><%= un.nome %> — <%= g.nome %></option>
                <% }); %>
              </optgroup>
            <% }); %>
          </select>
        </div>
        <% if (podeLiderar) { %>
          <label class="flex h-10 items-center gap-2 text-sm text-ink">
            <input type="checkbox" name="is_lider" value="true" class="h-4 w-4 rounded border-gray-300">
            Líder do grupo
          </label>
        <% } %>
        <button type="submit" class="btn-primary h-10">Dar acesso</button>
      </form>
    <% } %>
  </section>

  <!-- Acessos atuais, por unidade -->
  <section class="panel" aria-labelledby="t-atuais">
    <header class="panel-head">
      <h2 id="t-atuais" class="panel-title">Acessos atuais</h2>
      <span class="text-sm text-muted"><%= totalUnidadesAtivas %> <%= totalUnidadesAtivas === 1 ? 'unidade ativa' : 'unidades ativas' %></span>
    </header>
    <% if (acessos.length === 0) { %>
      <p class="panel-empty">Nenhum acesso ainda.</p>
    <% } else { %>
      <ul class="divide-y divide-line">
        <% acessos.forEach(function (un) { %>
          <% un.grupos.forEach(function (g, i) { %>
            <li class="flex items-center justify-between gap-4 px-5 py-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium <%= un.ativa ? 'text-ink' : 'text-muted line-through' %>"><%= un.nome %></p>
                <p class="truncate text-[13px] text-muted">
                  Grupo <%= g.grupo_nome %><% if (g.is_lider) { %> · líder<% } %><% if (!un.ativa) { %> · unidade desativada<% } %>
                </p>
              </div>
              <form method="POST" action="/cadastros/usuarios/<%= usuario.id %>/vinculos/<%= g.grupo_id %>/remover"
                    onsubmit="return confirm('Remover o acesso de <%= usuario.nome.replace(/'/g, '') %> a <%= un.nome.replace(/'/g, '') %> (<%= g.grupo_nome.replace(/'/g, '') %>)?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="text-sm font-medium text-negative hover:underline">Remover</button>
              </form>
            </li>
          <% }); %>
        <% }); %>
      </ul>
    <% } %>
  </section>

  </div>

  <p class="mt-4 max-w-3xl text-[13px] text-muted">
    O acesso a uma unidade vem da participação em um grupo dela. Toda unidade tem o grupo <span class="text-ink">Geral</span>;
    grupos como Compras ou Farmácia servem para receber as etapas de fluxo daquela área.
  </p>
</div>

<%- include('../partials/footer') %>
