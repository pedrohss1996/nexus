<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Usuário - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-600">
    <a href="/cadastros/usuarios" class="hover:text-teal-600">Usuários</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900"><%= usuario ? 'Editar' : 'Novo' %></span>
  </nav>

  <!-- Formulário -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">
      <%= usuario ? 'Editar Usuário' : 'Novo Usuário' %>
    </h1>

    <% if (erro) { %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6 flex items-center">
        <svg class="w-5 h-5 text-red-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-red-800 font-medium"><%= erro %></p>
      </div>
    <% } %>

    <form method="POST" action="<%= usuario ? `/cadastros/usuarios/${usuario.id}` : '/cadastros/usuarios' %>" class="space-y-6">
      <!-- Nome -->
      <div>
        <label for="nome" class="block text-sm font-medium text-gray-700 mb-2">
          Nome Completo <span class="text-red-500">*</span>
        </label>
        <input 
          type="text" 
          id="nome" 
          name="nome" 
          value="<%= usuario ? usuario.nome : '' %>" 
          required
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
          placeholder="Ex: João Silva"
        >
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
          Email <span class="text-red-500">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          value="<%= usuario ? usuario.email : '' %>" 
          required
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
          placeholder="joao.silva@exemplo.com"
        >
      </div>

      <!-- Senha (apenas para novo usuário) -->
      <% if (!usuario) { %>
        <div>
          <label for="senha" class="block text-sm font-medium text-gray-700 mb-2">
            Senha <span class="text-red-500">*</span>
          </label>
          <input 
            type="password" 
            id="senha" 
            name="senha" 
            required
            minlength="6"
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
            placeholder="Mínimo 6 caracteres"
          >
          <p class="text-xs text-gray-500 mt-1">A senha deve ter no mínimo 6 caracteres</p>
        </div>

        <div>
          <label for="confirmar_senha" class="block text-sm font-medium text-gray-700 mb-2">
            Confirmar Senha <span class="text-red-500">*</span>
          </label>
          <input 
            type="password" 
            id="confirmar_senha" 
            name="confirmar_senha" 
            required
            minlength="6"
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
            placeholder="Repita a senha"
          >
        </div>
      <% } %>

      <!-- Perfil -->
      <div>
        <label for="perfil" class="block text-sm font-medium text-gray-700 mb-2">
          Perfil de Acesso <span class="text-red-500">*</span>
        </label>
        <select 
          id="perfil" 
          name="perfil" 
          required
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
        >
          <option value="">Selecione o perfil</option>
          <option value="usuario" <%= usuario && usuario.perfil === 'usuario' ? 'selected' : '' %>>Usuário</option>
          <option value="gestor" <%= usuario && usuario.perfil === 'gestor' ? 'selected' : '' %>>Gestor</option>
          <option value="admin" <%= usuario && usuario.perfil === 'admin' ? 'selected' : '' %>>Administrador</option>
        </select>
        <div class="mt-2 text-xs text-gray-500 space-y-1">
          <p><strong>Usuário:</strong> Acesso básico ao sistema</p>
          <p><strong>Gestor:</strong> Pode gerenciar grupos e processos</p>
          <p><strong>Administrador:</strong> Acesso total ao sistema</p>
        </div>
      </div>

      <!-- Botões -->
      <div class="flex items-center justify-between pt-6 border-t border-gray-200">
        <a href="<%= usuario ? `/cadastros/usuarios/${usuario.id}` : '/cadastros/usuarios' %>" class="text-gray-600 hover:text-gray-900 font-medium text-sm">
          Cancelar
        </a>
        <button 
          type="submit" 
          class="bg-gradient-to-r from-teal-500 to-emerald-500 text-white px-8 py-2.5 rounded-lg hover:from-teal-600 hover:to-emerald-600 transition-all shadow-sm hover:shadow-md font-medium text-sm"
        >
          <%= usuario ? 'Salvar Alterações' : 'Criar Usuário' %>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
