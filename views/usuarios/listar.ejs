<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Usuários - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full px-6 py-6 space-y-5">
  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-white">Usuários</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Gerencie os usuários do sistema</p>
    </div>
    <% if (user.perfil === 'admin') { %>
      <a href="/cadastros/usuarios/novo" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Novo Usuário
      </a>
    <% } %>
  </div>

  <!-- Cards de Estatísticas -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Total</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= estatisticas.total %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Ativos</p>
      <p class="text-2xl font-bold text-green-600 dark:text-green-400"><%= estatisticas.ativos %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Admins</p>
      <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= estatisticas.admins %></p>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Gestores</p>
      <p class="text-2xl font-bold text-blue-600 dark:text-blue-400"><%= estatisticas.gestores %></p>
    </div>
  </div>

  <!-- Filtros -->
  <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-4">
    <form method="GET" action="/cadastros/usuarios" class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[140px]">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Perfil</label>
        <select name="perfil" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
          <option value="">Todos</option>
          <option value="admin" <%= filtros.perfil === 'admin' ? 'selected' : '' %>>Admin</option>
          <option value="gestor" <%= filtros.perfil === 'gestor' ? 'selected' : '' %>>Gestor</option>
          <option value="usuario" <%= filtros.perfil === 'usuario' ? 'selected' : '' %>>Usuário</option>
        </select>
      </div>
      <div class="flex-1 min-w-[140px]">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Status</label>
        <select name="ativo" class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
          <option value="">Todos</option>
          <option value="true" <%= filtros.ativo === true ? 'selected' : '' %>>Ativos</option>
          <option value="false" <%= filtros.ativo === false ? 'selected' : '' %>>Inativos</option>
        </select>
      </div>
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Buscar</label>
        <input type="text" name="busca" value="<%= filtros.busca || '' %>" placeholder="Nome ou email..." class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2 text-sm focus:ring-2 focus:ring-cyan-500">
      </div>
      <div class="flex gap-2">
        <button type="submit" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg text-sm font-medium transition-colors">Filtrar</button>
        <a href="/cadastros/usuarios" class="px-4 py-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium transition-colors">Limpar</a>
      </div>
    </form>
  </div>

  <!-- Tabela de Usuários -->
  <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
    <% if (usuarios.length === 0) { %>
      <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
        <div class="bg-gray-100 dark:bg-slate-700 rounded-full p-4 mb-4">
          <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Nenhum usuário encontrado</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">Não há usuários com os filtros aplicados.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Usuário</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden md:table-cell">Email</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden sm:table-cell">Perfil</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden lg:table-cell">Status</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
            <% usuarios.forEach(u => { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/40 transition-colors <%= !u.ativo ? 'opacity-60' : '' %>" id="row-usuario-<%= u.id %>">
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0
                      <%= u.perfil === 'admin' ? 'bg-red-500' : u.perfil === 'gestor' ? 'bg-blue-500' : 'bg-teal-500' %>">
                      <%= u.nome.charAt(0).toUpperCase() %>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-gray-900 dark:text-white truncate"><%= u.nome %></p>
                      <p class="text-xs text-gray-500 dark:text-gray-400 md:hidden truncate"><%= u.email %></p>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3.5 hidden md:table-cell">
                  <span class="text-sm text-gray-600 dark:text-gray-300"><%= u.email %></span>
                </td>
                <td class="px-5 py-3.5 hidden sm:table-cell">
                  <span class="px-2 py-0.5 text-xs font-semibold rounded-full
                    <%= u.perfil === 'admin' ? 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300' :
                        u.perfil === 'gestor' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300' :
                        'bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-gray-300' %>">
                    <%= u.perfil === 'admin' ? 'Admin' : u.perfil === 'gestor' ? 'Gestor' : 'Usuário' %>
                  </span>
                </td>
                <td class="px-5 py-3.5 hidden lg:table-cell">
                  <% if (u.ativo) { %>
                    <span class="inline-flex items-center gap-1 text-xs font-medium text-green-700 dark:text-green-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-green-500 dark:bg-green-400"></span>Ativo
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 text-xs font-medium text-gray-500 dark:text-gray-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Inativo
                    </span>
                  <% } %>
                </td>
                <td class="px-5 py-3.5">
                  <div class="flex items-center justify-center gap-1">
                    <a href="/cadastros/usuarios/<%= u.id %>" title="Ver detalhes" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-cyan-50 dark:hover:bg-cyan-900/30 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </a>
                    <% if (user.perfil === 'admin' || user.id === u.id) { %>
                      <a href="/cadastros/usuarios/<%= u.id %>/editar" title="Editar" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      </a>
                    <% } %>
                    <% if (user.perfil === 'admin' && u.id !== user.id) { %>
                      <% if (u.ativo) { %>
                        <button type="button" title="Desativar" onclick="toggleUsuario(<%= u.id %>, '<%= u.nome.replace(/'/g, "\\'") %>', false)" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-red-50 dark:hover:bg-red-900/30 hover:text-red-600 dark:hover:text-red-400 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                        </button>
                      <% } else { %>
                        <button type="button" title="Reativar" onclick="toggleUsuario(<%= u.id %>, '<%= u.nome.replace(/'/g, "\\'") %>', true)" class="p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-green-50 dark:hover:bg-green-900/30 hover:text-green-600 dark:hover:text-green-400 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </button>
                      <% } %>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="px-5 py-3 border-t border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/30">
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= usuarios.length %> usuário<%= usuarios.length !== 1 ? 's' : '' %> encontrado<%= usuarios.length !== 1 ? 's' : '' %></p>
      </div>
    <% } %>
  </div>
</div>

<% if (user.perfil === 'admin') { %>
<script>
async function toggleUsuario(id, nome, ativar) {
  const acao = ativar ? 'reativar' : 'desativar';
  const msg = ativar ? 'Reativar o usuário "' + nome + '"?' : 'Desativar o usuário "' + nome + '"?';
  if (!confirm(msg)) return;
  try {
    const url = ativar ? '/cadastros/usuarios/' + id + '/reativar' : '/cadastros/usuarios/' + id;
    const method = ativar ? 'PATCH' : 'DELETE';
    const r = await fetch(url, { method, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    const data = await r.json();
    if (data.success) {
      if (window.showToast) showToast('Usuário "' + nome + '" ' + (ativar ? 'reativado' : 'desativado') + '.', ativar ? 'success' : 'warning');
      setTimeout(() => location.reload(), 900);
    } else {
      if (window.showToast) showToast(data.message || 'Erro ao ' + acao + ' usuário.', 'error');
    }
  } catch (_) {
    if (window.showToast) showToast('Erro ao ' + acao + ' usuário.', 'error');
  }
}
</script>
<% } %>

<%- include('../partials/footer') %>
