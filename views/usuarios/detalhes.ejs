<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Detalhes do Usuário - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-600">
    <a href="/cadastros/usuarios" class="hover:text-teal-600">Usuários</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900"><%= usuario.nome %></span>
  </nav>

  <!-- Alerta de sucesso (senha alterada) -->
  <% if (typeof query !== 'undefined' && query.senha_alterada) { %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-center">
      <svg class="w-5 h-5 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-green-800 font-medium">Senha alterada com sucesso!</p>
    </div>
  <% } %>

  <!-- Cabeçalho -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex justify-between items-start">
      <div class="flex items-center flex-1">
        <div class="w-20 h-20 rounded-full flex items-center justify-center font-bold text-3xl mr-6 bg-primary-50 text-primary-700 dark:bg-slate-700 dark:text-primary-200">
          <%= usuario.nome.charAt(0).toUpperCase() %>
        </div>
        <div class="flex-1">
          <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= usuario.nome %></h1>
          <p class="text-gray-600 mb-3"><%= usuario.email %></p>
          <div class="flex items-center space-x-3">
            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full <%= usuario.perfil === 'admin' ? 'bg-red-100 text-red-800' : usuario.perfil === 'gestor' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
              <%= usuario.perfil %>
            </span>
            <% if (usuario.ativo) { %>
              <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-green-100 text-green-800">
                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Ativo
              </span>
            <% } else { %>
              <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-gray-100 text-gray-800">
                Inativo
              </span>
            <% } %>
          </div>
        </div>
      </div>
      <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
        <div class="flex space-x-2">
          <% if (user.perfil === 'admin') { %>
            <a href="/cadastros/usuarios/<%= usuario.id %>/editar" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors text-sm font-medium flex items-center">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Editar
            </a>
            <a href="/cadastros/usuarios/<%= usuario.id %>/alterar-senha" class="bg-blue-100 text-blue-700 px-4 py-2 rounded-lg hover:bg-blue-200 transition-colors text-sm font-medium flex items-center">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
              </svg>
              Alterar Senha
            </a>
          <% } %>
          <a href="/cadastros/usuarios/<%= usuario.id %>/vinculos" class="bg-teal-100 text-teal-700 px-4 py-2 rounded-lg hover:bg-teal-200 transition-colors text-sm font-medium flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            Gerenciar Vínculos
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Informações -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Dados do Usuário -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Informações</h2>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Nome Completo</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= usuario.nome %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Email</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= usuario.email %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Perfil de Acesso</dt>
          <dd class="mt-1">
            <span class="px-2 py-1 inline-flex text-xs font-semibold rounded-full <%= usuario.perfil === 'admin' ? 'bg-red-100 text-red-800' : usuario.perfil === 'gestor' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
              <%= usuario.perfil %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1">
            <% if (usuario.ativo) { %>
              <span class="px-2 py-1 inline-flex text-xs font-semibold rounded-full bg-green-100 text-green-800">Ativo</span>
            <% } else { %>
              <span class="px-2 py-1 inline-flex text-xs font-semibold rounded-full bg-gray-100 text-gray-800">Inativo</span>
            <% } %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Cadastrado em</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= new Date(usuario.criado_em).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %></dd>
        </div>
        <% if (usuario.atualizado_em && usuario.atualizado_em !== usuario.criado_em) { %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Última atualização</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= new Date(usuario.atualizado_em).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %></dd>
          </div>
        <% } %>
      </dl>
    </div>

    <!-- Estatísticas -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Estatísticas</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between p-4 bg-blue-50 rounded-lg">
          <div class="flex items-center">
            <svg class="w-8 h-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <div>
              <p class="text-sm text-gray-600">Grupos</p>
              <p class="text-2xl font-bold text-gray-900"><%= grupos.length %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Grupos do Usuário -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-6">Grupos</h2>
    
    <% if (grupos.length === 0) { %>
      <div class="text-center py-8">
        <svg class="w-12 h-12 mx-auto text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <p class="text-gray-600">Este usuário não está vinculado a nenhum grupo.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% grupos.forEach(grupo => { %>
          <a href="/grupos/<%= grupo.id %>" class="border border-gray-200 rounded-lg p-4 hover:border-teal-500 hover:shadow-sm transition-all">
            <div class="flex items-start justify-between mb-2">
              <h3 class="font-semibold text-gray-900"><%= grupo.nome %></h3>
              <% if (grupo.is_lider) { %>
                <span class="px-2 py-1 inline-flex text-xs font-semibold rounded-full bg-amber-100 text-amber-800">
                  <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                  Líder
                </span>
              <% } %>
            </div>
            <p class="text-sm text-gray-600 mb-2 line-clamp-2"><%= grupo.descricao || 'Sem descrição' %></p>
            <div class="flex items-center text-xs text-gray-500">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <%= grupo.unidade_nome %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
