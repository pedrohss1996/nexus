<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Grupos - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full px-8 py-8 space-y-6" \>
  <!-- Cabeçalho -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Grupos</h1>
      <p class="text-sm text-gray-600 mt-1">Gerencie os grupos e equipes do sistema</p>
    </div>
    <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
      <a href="/grupos/novo" class="bg-gradient-to-r from-teal-500 to-emerald-500 text-white px-6 py-2.5 rounded-lg hover:from-teal-600 hover:to-emerald-600 transition-all shadow-sm hover:shadow-md text-sm font-medium flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Novo Grupo
      </a>
    <% } %>
  </div>

  <!-- Filtros -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <form method="GET" action="/grupos" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Unidade</label>
        <select name="unidade_id" class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
          <option value="">Todas as unidades</option>
          <% unidades.forEach(unidade => { %>
            <option value="<%= unidade.id %>" <%= (filtros.unidade_id && String(filtros.unidade_id) === String(unidade.id)) ? 'selected' : '' %>>
              <%= unidade.nome %>
            </option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Buscar</label>
        <input type="text" name="busca" value="<%= filtros.busca || '' %>" placeholder="Nome ou descrição..." class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
      </div>
      <div class="flex items-end space-x-2">
        <button type="submit" class="bg-teal-600 text-white px-6 py-2 rounded-lg hover:bg-teal-700 transition-colors text-sm font-medium">
          Filtrar
        </button>
        <a href="/grupos" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300 transition-colors text-sm font-medium">
          Limpar
        </a>
      </div>
    </form>
  </div>

  <!-- Lista de Grupos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (grupos.length === 0) { %>
      <div class="col-span-full bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Nenhum grupo encontrado</h3>
        <p class="text-gray-600 mb-4">Não há grupos cadastrados com os filtros selecionados.</p>
        <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
          <a href="/grupos/novo" class="inline-flex items-center text-teal-600 hover:text-teal-700 font-medium">
            Criar primeiro grupo
            <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        <% } %>
      </div>
    <% } else { %>
      <% grupos.forEach(grupo => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900 mb-1">
                  <a href="/grupos/<%= grupo.id %>" class="hover:text-teal-600 transition-colors">
                    <%= grupo.nome %>
                  </a>
                </h3>
                <p class="text-sm text-gray-600 line-clamp-2"><%= grupo.descricao || 'Sem descrição' %></p>
              </div>
            </div>
            
            <div class="flex items-center text-sm text-gray-600 mb-3">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <%= grupo.unidade_nome %>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
              <div class="flex items-center text-sm text-gray-600">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <span class="font-medium"><%= grupo.total_membros %></span>
                <span class="ml-1">membro<%= grupo.total_membros != 1 ? 's' : '' %></span>
              </div>
              <a href="/grupos/<%= grupo.id %>" class="text-teal-600 hover:text-teal-700 font-medium text-sm flex items-center">
                Ver detalhes
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>

