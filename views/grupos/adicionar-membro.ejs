<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Adicionar membros - Nexus', user: typeof user !== 'undefined' ? user : null }) %>
<%
  var disponiveis = usuarios.filter(function (u) { return !u.jaMembro; });
  var jaMembros = usuarios.length - disponiveis.length;
  var marcadosSet = (typeof marcados !== 'undefined' ? marcados : []);
%>

<div class="dash">
  <nav class="mb-3 text-sm text-muted" aria-label="Trilha">
    <a href="/grupos" class="hover:text-ink">Grupos</a>
    <span class="mx-1.5">/</span>
    <a href="/grupos/<%= grupo.id %>" class="hover:text-ink"><%= grupo.nome %></a>
  </nav>

  <h1 class="text-2xl font-semibold tracking-tight text-ink">Adicionar membros</h1>
  <p class="mt-1 text-sm text-muted">
    Grupo <span class="text-ink"><%= grupo.nome %></span>
    <% if (unidade) { %> · unidade <span class="text-ink"><%= unidade.nome %></span><% } %>
    · quem entrar no grupo passa a ter acesso a esta unidade
  </p>

  <% if (erro) { %>
    <p class="alerta alerta-erro mt-4" role="alert"><%= erro %></p>
  <% } %>

  <form method="POST" action="/grupos/<%= grupo.id %>/membros" class="mt-6 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Lista de usuários com seleção múltipla -->
    <section class="panel">
      <header class="flex flex-wrap items-center gap-3 border-b border-line px-5 py-3">
        <label class="flex items-center gap-2 text-sm font-medium text-ink">
          <input type="checkbox" id="marcarTodos" class="h-4 w-4 rounded border-gray-300 text-primary-600 dark:border-slate-500 dark:bg-slate-700">
          Selecionar todos
        </label>
        <div class="relative ml-auto w-full sm:w-72">
          <input type="search" id="buscaUsuario" placeholder="Buscar por nome, e-mail ou cargo" aria-label="Buscar usuário"
            class="input-field pl-9">
          <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
        </div>
      </header>

      <% if (usuarios.length === 0) { %>
        <p class="panel-empty mt-5">Nenhum usuário ativo cadastrado. <a href="/cadastros/usuarios/novo" class="panel-link">Cadastrar usuário</a></p>
      <% } else { %>
        <ul id="listaUsuarios" class="max-h-[60vh] divide-y divide-line overflow-y-auto">
          <% usuarios.forEach(function (u) { %>
            <li data-busca="<%= (u.nome + ' ' + (u.email || '') + ' ' + (u.cargo || '') + ' ' + (u.login || '')).toLowerCase() %>">
              <label class="flex items-center gap-3 px-5 py-2.5 <%= u.jaMembro ? 'opacity-60' : 'cursor-pointer hover:bg-raised' %>">
                <input type="checkbox" name="usuario_id" value="<%= u.id %>"
                  class="seletor-usuario h-4 w-4 rounded border-gray-300 text-primary-600 dark:border-slate-500 dark:bg-slate-700"
                  <%= u.jaMembro ? 'checked disabled' : '' %> <%= marcadosSet.indexOf(String(u.id)) >= 0 ? 'checked' : '' %>>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-50 text-sm font-semibold text-primary-700 dark:bg-slate-700 dark:text-primary-200"><%= u.nome.charAt(0).toUpperCase() %></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-medium text-ink"><%= u.nome %></span>
                  <span class="block truncate text-[13px] text-muted"><% if (u.login) { %><%= u.login %> · <% } %><%= u.email %><% if (u.cargo) { %> · <%= u.cargo %><% } %></span>
                </span>
                <span class="shrink-0 text-[13px] text-muted"><%= u.jaMembro ? 'já está no grupo' : u.perfil %></span>
              </label>
            </li>
          <% }); %>
        </ul>
        <p id="semResultado" class="hidden px-5 py-6 text-sm text-muted">Nenhum usuário encontrado para essa busca.</p>
      <% } %>
    </section>

    <!-- Resumo e ação -->
    <aside class="panel lg:sticky lg:top-20">
      <div class="space-y-4 p-5">
        <p class="text-sm text-muted">
          <span id="contador" class="text-2xl font-semibold text-ink num">0</span>
          <span id="contadorRotulo">selecionados</span>
        </p>
        <p class="text-[13px] text-muted"><%= disponiveis.length %> disponíveis · <%= jaMembros %> já no grupo</p>
        <label class="flex items-center gap-2 text-sm text-ink">
          <input type="checkbox" name="is_lider" value="true" class="h-4 w-4 rounded border-gray-300 text-primary-600 dark:border-slate-500 dark:bg-slate-700">
          Adicionar como líderes
        </label>
        <button type="submit" id="btnAdicionar" class="btn-primary w-full" disabled>Adicionar ao grupo</button>
        <a href="/grupos/<%= grupo.id %>" class="block text-center text-sm text-muted hover:text-ink">Cancelar</a>
      </div>
    </aside>
  </form>
</div>

<script>
  (function () {
    var lista = document.getElementById('listaUsuarios');
    if (!lista) return;
    var busca = document.getElementById('buscaUsuario');
    var todos = document.getElementById('marcarTodos');
    var contador = document.getElementById('contador');
    var rotulo = document.getElementById('contadorRotulo');
    var btn = document.getElementById('btnAdicionar');
    var vazio = document.getElementById('semResultado');
    var itens = Array.prototype.slice.call(lista.querySelectorAll('li'));
    function caixa(li) { return li.querySelector('.seletor-usuario'); }
    function livres() { return itens.filter(function (li) { return !li.hidden && !caixa(li).disabled; }); }

    function atualizar() {
      var n = itens.filter(function (li) { var c = caixa(li); return c.checked && !c.disabled; }).length;
      contador.textContent = n;
      rotulo.textContent = n === 1 ? 'selecionado' : 'selecionados';
      btn.disabled = n === 0;
      btn.textContent = n > 1 ? 'Adicionar ' + n + ' ao grupo' : 'Adicionar ao grupo';
      var vis = livres();
      todos.checked = vis.length > 0 && vis.every(function (li) { return caixa(li).checked; });
      todos.indeterminate = !todos.checked && vis.some(function (li) { return caixa(li).checked; });
    }

    busca.addEventListener('input', function () {
      var termo = busca.value.trim().toLowerCase();
      var visiveis = 0;
      itens.forEach(function (li) {
        li.hidden = !!termo && li.getAttribute('data-busca').indexOf(termo) < 0;
        if (!li.hidden) visiveis++;
      });
      vazio.classList.toggle('hidden', visiveis > 0);
      atualizar();
    });
    // "Selecionar todos" vale para os usuários visíveis (respeita a busca)
    todos.addEventListener('change', function () {
      livres().forEach(function (li) { caixa(li).checked = todos.checked; });
      atualizar();
    });
    lista.addEventListener('change', atualizar);
    atualizar();
  })();
</script>

<%- include('../partials/footer') %>
