<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Detalhes do Grupo - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-600">
    <a href="/grupos" class="hover:text-teal-600">Grupos</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900"><%= grupo.nome %></span>
  </nav>

  <!-- Cabeçalho -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex justify-between items-start">
      <div class="flex-1">
        <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= grupo.nome %></h1>
        <p class="text-gray-600 mb-4"><%= grupo.descricao || 'Sem descrição' %></p>
        <div class="flex items-center space-x-6 text-sm text-gray-600">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <span><%= grupo.unidade_nome %></span>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <span><%= grupo.total_membros %> membro<%= grupo.total_membros != 1 ? 's' : '' %></span>
          </div>
        </div>
      </div>
      <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
        <div class="flex space-x-2">
          <a href="/grupos/<%= grupo.id %>/editar" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors text-sm font-medium flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Editar
          </a>
          <a href="/grupos/<%= grupo.id %>/adicionar-membro" class="px-4 py-2 rounded-lg transition-all text-sm font-medium flex items-center bg-neutral-900 text-white hover:bg-black dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>
            Adicionar Membro
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Lista de Membros -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-6">Membros do Grupo</h2>
    
    <% if (membros.length === 0) { %>
      <div class="text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Nenhum membro ainda</h3>
        <p class="text-gray-600">Adicione membros a este grupo para começar.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Membro</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Perfil</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Unidade Vinculada</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Função</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Desde</th>
              <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
                <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
              <% } %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% membros.forEach(membro => { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center font-semibold text-sm mr-3 bg-primary-50 text-primary-700 dark:bg-neutral-800 dark:text-primary-300">
                      <%= membro.nome.charAt(0).toUpperCase() %>
                    </div>
                    <div class="text-sm font-medium text-gray-900"><%= membro.nome %></div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= membro.email %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= membro.perfil === 'admin' ? 'bg-red-100 text-red-800' : membro.perfil === 'gestor' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= membro.perfil %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center text-sm text-gray-600">
                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    <%= membro.unidade_nome %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (membro.is_lider) { %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-amber-100 text-amber-800">
                      <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                      </svg>
                      Líder
                    </span>
                  <% } else { %>
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                      Membro
                    </span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  <%= new Date(membro.vinculado_em).toLocaleDateString('pt-BR') %>
                </td>
                <% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
                  <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                    <div class="flex items-center justify-center space-x-2">
                      <button onclick="toggleLider(<%= membro.id %>, <%= !membro.is_lider %>)" class="text-amber-600 hover:text-amber-900" title="<%= membro.is_lider ? 'Remover liderança' : 'Tornar líder' %>">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                      </button>
                      <button onclick="removerMembro(<%= membro.id %>)" class="text-red-600 hover:text-red-900" title="Remover do grupo">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (user.perfil === 'admin' || user.perfil === 'gestor') { %>
<script>
async function toggleLider(usuarioId, isLider) {
  if (!confirm(`Deseja ${isLider ? 'tornar este usuário líder' : 'remover a liderança deste usuário'}?`)) return;
  
  try {
    const response = await fetch(`/grupos/<%= grupo.id %>/membros/${usuarioId}/lider`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ is_lider: isLider })
    });
    
    if (response.ok) {
      location.reload();
    } else {
      alert('Erro ao atualizar líder');
    }
  } catch (error) {
    alert('Erro ao atualizar líder');
  }
}

async function removerMembro(usuarioId) {
  if (!confirm('Deseja realmente remover este membro do grupo?')) return;
  
  try {
    const response = await fetch(`/grupos/<%= grupo.id %>/membros/${usuarioId}`, {
      method: 'DELETE'
    });
    
    if (response.ok) {
      location.reload();
    } else {
      alert('Erro ao remover membro');
    }
  } catch (error) {
    alert('Erro ao remover membro');
  }
}
</script>
<% } %>

<%- include('../partials/footer') %>
