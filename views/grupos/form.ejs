<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Grupo - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full px-6 py-6">
  <div class="max-w-xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-5">
      <a href="/grupos" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Grupos</a>
      <svg class="w-4 h-4 mx-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-900 dark:text-white font-medium"><%= grupo ? 'Editar grupo' : 'Novo grupo' %></span>
    </nav>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700">
        <h1 class="text-lg font-bold text-gray-900 dark:text-white"><%= grupo ? 'Editar grupo' : 'Novo grupo' %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5"><%= grupo ? 'Altere as informações do grupo abaixo.' : 'Preencha as informações para criar um novo grupo.' %></p>
      </div>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="mx-6 mt-4 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 flex items-center gap-3">
          <svg class="w-4 h-4 text-red-600 dark:text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <p class="text-sm text-red-700 dark:text-red-300"><%= erro %></p>
        </div>
      <% } %>

      <form method="POST" action="<%= grupo ? `/grupos/${grupo.id}` : '/grupos' %>" class="p-6 space-y-5">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label for="nome" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
            Nome do Grupo <span class="text-red-500">*</span>
          </label>
          <input type="text" id="nome" name="nome" value="<%= grupo ? grupo.nome : '' %>" required maxlength="255"
            placeholder="Ex: Administrativo, Farmácia, TI..."
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
        </div>

        <div>
          <label for="unidade_id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
            Unidade <span class="text-red-500">*</span>
          </label>
          <select id="unidade_id" name="unidade_id" required
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
            <option value="">— Selecione uma unidade —</option>
            <% unidades.forEach(u => { %>
              <option value="<%= u.id %>"
                <%= (grupo && grupo.unidade_id == u.id) || (!grupo && typeof unidadeSelecionada !== 'undefined' && unidadeSelecionada == u.id) ? 'selected' : '' %>>
                <%= u.nome %>
                <% if (u.cd_tipo == 1) { %>(Hospital)<% } else if (u.cd_tipo == 2) { %>(Clínica)<% } else if (u.cd_tipo == 3) { %>(Departamento)<% } %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label for="descricao" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Descrição</label>
          <textarea id="descricao" name="descricao" rows="3" maxlength="500"
            placeholder="Responsabilidades e propósito do grupo..."
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors resize-none"><%= grupo ? (grupo.descricao || '') : '' %></textarea>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-slate-700">
          <a href="<%= grupo ? `/grupos/${grupo.id}` : '/grupos' %>" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white font-medium transition-colors">
            Cancelar
          </a>
          <button type="submit" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <%= grupo ? 'Salvar alterações' : 'Criar grupo' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
