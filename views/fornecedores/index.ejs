<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Fornecedores - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Fornecedores</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Cadastro de fornecedores (CNPJ, endereço, contatos, dados bancários)</p>
    </div>
    <a href="/fornecedores/novo" class="inline-flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-medium text-sm transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Novo Fornecedor
    </a>
  </div>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="mb-4 p-4 rounded-lg <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200' %> text-sm">
      <%= flash.error || flash.success %>
    </div>
  <% } %>

  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
    <% if (!fornecedores || fornecedores.length === 0) { %>
      <div class="p-12 text-center text-gray-500 dark:text-gray-400">
        <p class="mb-4">Nenhum fornecedor cadastrado.</p>
        <a href="/fornecedores/novo" class="text-cyan-600 dark:text-cyan-400 hover:underline font-medium">Cadastrar primeiro fornecedor</a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-600">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">CNPJ</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Razão Social</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Nome Fantasia</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Cidade / UF</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Contato</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-600">
            <% fornecedores.forEach(function(f) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors">
                <td class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white"><%= f.cnpj || '—' %></td>
                <td class="px-4 py-3 text-sm text-gray-900 dark:text-white"><%= (f.razao_social || f.nome || '—').slice(0, 40) %><%= (f.razao_social || f.nome || '').length > 40 ? '…' : '' %></td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300"><%= (f.nome_fantasia || '—').slice(0, 30) %><%= (f.nome_fantasia || '').length > 30 ? '…' : '' %></td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300"><%= (f.cidade || '—') %> <%= f.uf ? '/' + f.uf : '' %></td>
                <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300"><%= (f.email || f.telefone || '—').slice(0, 25) %><%= (f.email || f.telefone || '').length > 25 ? '…' : '' %></td>
                <td class="px-4 py-3 text-right">
                  <a href="/fornecedores/<%= f.id %>" class="text-cyan-600 dark:text-cyan-400 hover:underline text-sm font-medium mr-3">Ver</a>
                  <a href="/fornecedores/<%= f.id %>/editar" class="text-gray-600 dark:text-gray-400 hover:underline text-sm font-medium">Editar</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/paginacao', { meta: meta }) %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
