<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Fornecedor - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>
<% const f = fornecedor || {}; %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-6">
  <nav class="flex text-sm text-gray-600 dark:text-gray-400 mb-6">
    <a href="/fornecedores" class="hover:text-cyan-600 dark:hover:text-cyan-400">Fornecedores</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900 dark:text-white truncate"><%= (f.nome_fantasia || f.razao_social || f.nome || 'Detalhes').slice(0, 40) %></span>
  </nav>

  <% if (typeof flash !== 'undefined' && (flash.success || flash.error)) { %>
    <div class="mb-4 p-4 rounded-lg <%= flash.error ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200' %> text-sm">
      <%= flash.error || flash.success %>
    </div>
  <% } %>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= f.nome_fantasia || f.razao_social || f.nome || 'Fornecedor' %></h1>
    <div class="flex items-center gap-2">
      <a href="/fornecedores/<%= f.id %>/editar" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        Editar
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Dados principais -->
    <div class="lg:col-span-2 space-y-4">
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Identificação</h2>
        </div>
        <div class="p-4 grid grid-cols-2 gap-3 text-sm">
          <div><span class="text-gray-500 dark:text-gray-400 block">CNPJ</span><span class="font-mono text-gray-900 dark:text-white"><%= f.cnpj || '—' %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400 block">Razão Social</span><span class="text-gray-900 dark:text-white"><%= f.razao_social || '—' %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400 block">Nome Fantasia</span><span class="text-gray-900 dark:text-white"><%= f.nome_fantasia || '—' %></span></div>
          <div><span class="text-gray-500 dark:text-gray-400 block">IE / IM</span><span class="text-gray-900 dark:text-white"><%= (f.inscricao_estadual || '—') %> / <%= (f.inscricao_municipal || '—') %></span></div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Endereço</h2>
        </div>
        <div class="p-4 text-sm text-gray-700 dark:text-gray-300">
          <%= [f.logradouro, f.numero, f.complemento, f.bairro, f.cidade, f.uf, f.cep].filter(Boolean).join(', ') || (f.endereco || '—') %>
          <% if (f.latitude != null || f.longitude != null) { %><br><span class="text-gray-500 text-xs">Lat/Long: <%= f.latitude %>, <%= f.longitude %></span><% } %>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Contatos</h2>
        </div>
        <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div><span class="text-gray-500 dark:text-gray-400 block">E-mail</span><a href="mailto:<%= f.email %>" class="text-cyan-600 dark:text-cyan-400 hover:underline"><%= f.email || '—' %></a></div>
          <div><span class="text-gray-500 dark:text-gray-400 block">Vendas / Pedidos</span><a href="mailto:<%= f.email_vendas %>" class="text-cyan-600 dark:text-cyan-400 hover:underline"><%= f.email_vendas || '—' %></a></div>
          <div><span class="text-gray-500 dark:text-gray-400 block">Financeiro</span><a href="mailto:<%= f.email_financeiro %>" class="text-cyan-600 dark:text-cyan-400 hover:underline"><%= f.email_financeiro || '—' %></a></div>
          <div><span class="text-gray-500 dark:text-gray-400 block">Telefone</span><span class="text-gray-900 dark:text-white"><%= f.telefone || '—' %></span></div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Dados bancários e pagamento</h2>
        </div>
        <div class="p-4 text-sm">
          <p class="text-gray-700 dark:text-gray-300">Banco: <%= f.banco || '—' %> | Ag: <%= f.agencia || '—' %> | Conta: <%= f.conta || '—' %></p>
          <p class="text-gray-600 dark:text-gray-400 mt-1">Condição padrão: <%= f.condicao_pagamento_padrao || '—' %></p>
        </div>
      </div>
    </div>

    <!-- Anexos -->
    <div class="lg:col-span-1">
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 shadow-sm overflow-hidden sticky top-24">
        <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Anexos</h2>
        </div>
        <div class="p-4">
          <form action="/fornecedores/<%= f.id %>/anexos?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="mb-4">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-2">Enviar arquivo (PDF, DOC, XLS, imagens, ZIP — máx. 15MB)</label>
            <div class="flex gap-2">
              <input type="file" name="anexo" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.webp,.zip" required
                class="block w-full text-sm text-gray-600 dark:text-gray-400 file:mr-2 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-cyan-50 file:text-cyan-700 dark:file:bg-cyan-900/30 dark:file:text-cyan-300 file:text-sm file:font-medium">
              <button type="submit" class="flex-shrink-0 bg-cyan-600 hover:bg-cyan-700 text-white px-3 py-2 rounded-lg text-sm font-medium transition-colors">Anexar</button>
            </div>
          </form>
          <ul class="space-y-2">
            <% if (!anexos || anexos.length === 0) { %>
              <li class="text-sm text-gray-500 dark:text-gray-400">Nenhum anexo.</li>
            <% } else { anexos.forEach(function(a) { %>
              <li class="flex items-center justify-between gap-2 p-2 rounded-lg bg-gray-50 dark:bg-slate-700/50 text-sm">
                <a href="/<%= a.caminho %>" target="_blank" rel="noopener" class="text-cyan-600 dark:text-cyan-400 hover:underline truncate flex-1 min-w-0" title="<%= a.nome_original %>"><%= (a.nome_original || a.nome_arquivo).slice(0, 28) %><%= (a.nome_original || a.nome_arquivo).length > 28 ? '…' : '' %></a>
                <form action="/fornecedores/<%= f.id %>/anexos/<%= a.id %>/excluir" method="POST" class="flex-shrink-0" onsubmit="return confirm('Excluir este anexo?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="p-1 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded" title="Excluir anexo">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  </button>
                </form>
              </li>
            <% }); } %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
