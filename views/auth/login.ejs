<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acesso ao Sistema - DataFlow</title>
  <link rel="icon" type="image/png" href="/imgs/favicon.png" sizes="192x192">
  <link rel="icon" type="image/png" href="/imgs/favicon.png" sizes="any">
  <link rel="apple-touch-icon" href="/imgs/favicon.png">
  <link href="/css/output.css" rel="stylesheet">
</head>
<body class="h-screen overflow-hidden">
  <div class="flex flex-col lg:flex-row h-full">
    <!-- Left Section - Gradiente Azul Escuro -->
    <div class="hidden lg:flex lg:w-2/3 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 items-center p-16 relative overflow-hidden">
      <div class="text-left z-10 max-w-2xl">
        <h1 class="text-7xl font-bold mb-6 leading-tight">
          <span class="bg-gradient-to-r from-cyan-400 via-teal-400 to-blue-400 bg-clip-text text-transparent">Documentação</span>
          <span class="text-white block mt-3">Inteligente.</span>
        </h1>
        <p class="text-white text-xl mt-10 font-light leading-relaxed max-w-lg">
          Acesso exclusivo para colaboradores. Gerencie processos hospitalares com segurança e agilidade.
        </p>
      </div>
      <!-- Decorative elements -->
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-blue-500 rounded-full blur-3xl"></div>
      </div>
      <!-- Overlay gradient para melhor contraste -->
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/80 via-transparent to-transparent"></div>
    </div>

    <!-- Right Section - Formulário de Login -->
    <div class="w-full lg:w-1/3 bg-gray-100 flex items-center justify-center p-4 sm:p-8 relative min-h-screen lg:min-h-0">
      <!-- Card de Login -->
      <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
        <!-- Logo -->
        <div class="flex items-center justify-center mb-8">
          <img src="/imgs/logo-dataflow.png" alt="DataFlow" class="h-24 w-auto max-w-[280px]" />
        </div>

        <!-- Título e Subtítulo -->
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Acesso ao Sistema</h2>
          <p class="text-sm text-gray-500">Entre com seu usuário corporativo.</p>
        </div>

        <!-- Formulário -->
        <form action="/auth/login" method="POST" class="space-y-6">
          <% if (error) { %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
              <%= error %>
            </div>
          <% } %>

          <!-- Campo Usuário -->
          <div>
            <label for="email" class="block text-sm font-medium text-blue-600 mb-2">Usuário</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <input 
                type="text" 
                id="email" 
                name="email" 
                required
                class="block w-full pl-10 pr-3 py-3 border border-blue-100 rounded-lg bg-blue-50 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 placeholder-gray-400 transition-all"
                placeholder="PEDRO"
                autocomplete="username"
              >
            </div>
          </div>

          <!-- Campo Senha -->
          <div>
            <label for="senha" class="block text-sm font-medium text-blue-600 mb-2">Senha</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
              </div>
              <input 
                type="password" 
                id="senha" 
                name="senha" 
                required
                class="block w-full pl-10 pr-12 py-3 border border-blue-100 rounded-lg bg-blue-50 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 placeholder-gray-400 transition-all"
                placeholder="••••••"
                autocomplete="current-password"
              >
              <button 
                type="button" 
                id="btnToggleSenha"
                class="absolute inset-y-0 right-0 pr-3 flex items-center justify-center w-12 cursor-pointer text-gray-400 hover:text-gray-600 focus:outline-none focus:text-blue-600"
                title="Mostrar/ocultar senha"
                aria-label="Alternar visibilidade da senha"
              >
                <svg id="eye-icon" class="h-5 w-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <svg id="eye-off-icon" class="h-5 w-5 pointer-events-none hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Botão Entrar -->
          <button 
            type="submit" 
            class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg font-semibold hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
          >
            Entrar
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const senhaInput = document.getElementById('senha');
      const btnToggle = document.getElementById('btnToggleSenha');
      const eyeIcon = document.getElementById('eye-icon');
      const eyeOffIcon = document.getElementById('eye-off-icon');

      if (!senhaInput || !btnToggle) return;

      function togglePassword() {
        if (senhaInput.type === 'password') {
          senhaInput.type = 'text';
          if (eyeIcon) eyeIcon.classList.add('hidden');
          if (eyeOffIcon) eyeOffIcon.classList.remove('hidden');
        } else {
          senhaInput.type = 'password';
          if (eyeIcon) eyeIcon.classList.remove('hidden');
          if (eyeOffIcon) eyeOffIcon.classList.add('hidden');
        }
      }

      btnToggle.addEventListener('click', function(e) {
        e.preventDefault();
        togglePassword();
      });
    })();
  </script>
</body>
</html>
