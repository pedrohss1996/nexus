<%- include('../partials/header', { title: title, user: user }) %>

<div class="w-full px-6 py-6 space-y-6 max-w-5xl mx-auto">

  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Documento</p>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-primary-600 dark:text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        Assinaturas Digitais
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 truncate max-w-lg"><%= documento.nome_arquivo || 'Documento #' + documento.id %></p>
    </div>
    <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Voltar
    </a>
  </div>

  <!-- Alertas -->
  <% if (success) { %>
  <div class="flex items-start gap-3 bg-secondary-50 dark:bg-secondary-900/20 border border-secondary-200 dark:border-secondary-700 text-secondary-800 dark:text-secondary-200 px-4 py-3 rounded-xl text-sm">
    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <%= success %>
  </div>
  <% } %>
  <% if (error) { %>
  <div class="flex items-start gap-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 text-red-700 dark:text-red-300 px-4 py-3 rounded-xl text-sm">
    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <%= error %>
    <% if (error && error.toString().toLowerCase().includes('bronze')) { %>
      <a href="https://confiabilidades.acesso.gov.br/" target="_blank" class="underline font-semibold">Fazer upgrade da conta gov.br</a>
    <% } %>
  </div>
  <% } %>

  <!-- Cards de ação -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

    <!-- gov.br -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5 flex flex-col gap-4">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl flex-shrink-0 flex items-center justify-center" style="background:#1351b4;">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 dark:text-white text-sm">Assinar via gov.br</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Assinatura Eletrônica Avançada com certificado gov.br (nível Prata ou Ouro).</p>
        </div>
      </div>

      <% if (credenciaisConfiguradas) { %>
        <a href="/assinaturas/documento/<%= documento.id %>/govbr/iniciar"
           class="w-full text-center text-sm font-semibold text-white py-2.5 rounded-lg transition-colors"
           style="background:#1351b4;"
           onmouseover="this.style.background='#0c3d8a'"
           onmouseout="this.style.background='#1351b4'">
          <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Assinar com gov.br
        </a>
      <% } else { %>
        <div class="rounded-lg bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 px-3 py-2 text-xs text-yellow-700 dark:text-yellow-300">
          <strong>Integração não configurada.</strong> Defina as variáveis de ambiente
          <code class="font-mono">GOVBR_ASSINATURA_CLIENT_ID</code>,
          <code class="font-mono">GOVBR_ASSINATURA_CLIENT_SECRET</code> e
          <code class="font-mono">GOVBR_ASSINATURA_REDIRECT_URI</code> no arquivo <code>.env</code>.
          <br/>
          Credenciais solicitadas em:
          <a href="https://www.gov.br/governodigital/pt-br/estrategias-e-governanca-digital/transformacao-digital/servico-de-integracao-aos-produtos-de-identidade-digital-gov.br"
             target="_blank" class="underline">Portal gov.br</a>.
        </div>
      <% } %>

      <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Certificado com validade jurídica (ITI)</li>
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Gera arquivo PKCS#7 (.p7s) para download</li>
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Verificável em validar.iti.gov.br</li>
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>Exige conta gov.br Prata ou Ouro</li>
      </ul>
    </div>

    <!-- Assinatura Simples -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5 flex flex-col gap-4">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-900/40 flex-shrink-0 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 dark:text-white text-sm">Assinatura Simples</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Registro interno de ciência/aprovação. Hash do documento calculado e armazenado.</p>
        </div>
      </div>

      <form action="/assinaturas/documento/<%= documento.id %>/simples" method="POST" class="flex flex-col gap-3">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <textarea name="observacoes" rows="2"
          class="w-full text-sm border border-gray-200 dark:border-slate-600 rounded-lg px-3 py-2 bg-gray-50 dark:bg-slate-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 resize-none"
          placeholder="Observações (opcional)"></textarea>
        <button type="submit"
          class="w-full bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold py-2.5 rounded-lg transition-colors">
          Registrar Assinatura Simples
        </button>
      </form>

      <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Registro interno com hash SHA-256</li>
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Rastreabilidade de quem assinou e quando</li>
        <li class="flex items-center gap-1.5"><svg class="w-3 h-3 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>Não tem validade jurídica externa</li>
      </ul>
    </div>
  </div>

  <!-- Histórico de assinaturas -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700">
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-slate-700">
      <h2 class="font-bold text-gray-900 dark:text-white text-sm flex items-center gap-2">
        <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Histórico de Assinaturas
      </h2>
      <span class="text-xs font-semibold px-2 py-1 rounded-full bg-primary-100 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300">
        <%= assinaturas.length %> registro<%= assinaturas.length !== 1 ? 's' : '' %>
      </span>
    </div>

    <% if (assinaturas.length === 0) { %>
      <div class="py-12 text-center">
        <svg class="w-10 h-10 mx-auto text-gray-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <p class="text-sm text-gray-500 dark:text-gray-400">Nenhuma assinatura registrada ainda.</p>
      </div>
    <% } else { %>
      <div class="divide-y divide-gray-100 dark:divide-slate-700">
        <% assinaturas.forEach(function(a) { %>
        <%
          var tipoCor = {
            'gov_br':             'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
            'simples':            'bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-slate-300',
            'certificado_digital':'bg-purple-100 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300',
            'biometria':          'bg-secondary-100 text-secondary-800 dark:bg-secondary-900/40 dark:text-secondary-300',
          }[a.tipo_assinatura] || 'bg-gray-100 text-gray-700';
          var tipoLabel = {
            'gov_br':             '🏛️ gov.br',
            'simples':            '✍️ Simples',
            'certificado_digital':'🔐 Certificado',
            'biometria':          '👆 Biometria',
          }[a.tipo_assinatura] || a.tipo_assinatura;
        %>
        <div class="px-5 py-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="flex items-center gap-3 flex-1 min-w-0">
            <div class="w-9 h-9 rounded-full bg-primary-100 dark:bg-primary-900/40 flex items-center justify-center flex-shrink-0 font-bold text-primary-700 dark:text-primary-300 text-sm uppercase">
              <%= (a.assinante_nome || '?').charAt(0) %>
            </div>
            <div class="min-w-0">
              <p class="font-semibold text-gray-900 dark:text-white text-sm"><%= a.assinante_nome || '—' %></p>
              <p class="text-xs text-gray-500 dark:text-gray-400"><%= a.assinante_email || '' %></p>
              <% if (a.observacoes) { %>
                <p class="text-xs text-gray-400 dark:text-gray-500 italic mt-0.5">"<%= a.observacoes %>"</p>
              <% } %>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 sm:flex-nowrap sm:justify-end">
            <span class="text-xs font-semibold px-2 py-1 rounded-full <%= tipoCor %>"><%= tipoLabel %></span>

            <% if (a.validado) { %>
              <span class="text-xs font-semibold px-2 py-1 rounded-full bg-secondary-100 text-secondary-800 dark:bg-secondary-900/40 dark:text-secondary-300">✓ Validada</span>
            <% } else { %>
              <span class="text-xs font-semibold px-2 py-1 rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">⏳ Pendente</span>
            <% } %>

            <span class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap">
              <%= a.assinado_em ? new Date(a.assinado_em).toLocaleString('pt-BR') : '—' %>
            </span>

            <% if (a.govbr_pkcs7_path) { %>
              <a href="/assinaturas/<%= a.id %>/download-p7s"
                 class="inline-flex items-center gap-1 text-xs font-semibold text-primary-600 dark:text-primary-400 hover:underline"
                 title="Baixar arquivo de assinatura PKCS#7">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                .p7s
              </a>
            <% } %>

            <% if (a.hash_documento) { %>
              <span class="text-xs text-gray-300 dark:text-slate-600 font-mono truncate max-w-[80px]" title="Hash: <%= a.hash_documento %>">
                <%= a.hash_documento.substring(0, 8) %>…
              </span>
            <% } %>

            <% if (['admin','gestor'].includes(user.perfil)) { %>
              <form action="/assinaturas/<%= a.id %>/remover" method="POST" onsubmit="return confirm('Remover esta assinatura?')">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="text-red-400 hover:text-red-600 dark:hover:text-red-400 transition-colors" title="Remover assinatura">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            <% } %>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Informações sobre validação -->
  <div class="bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-800 rounded-xl p-4 text-xs text-blue-700 dark:text-blue-300">
    <p class="font-semibold mb-1 flex items-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Como validar assinaturas gov.br
    </p>
    <p>Assinaturas realizadas via gov.br geram um arquivo <strong>.p7s</strong>. Para verificar a autenticidade, acesse o validador oficial do ITI:</p>
    <a href="https://validar.iti.gov.br" target="_blank" class="underline font-semibold">validar.iti.gov.br</a>
    <span class="text-blue-400"> (produção)</span>
    &nbsp;|&nbsp;
    <a href="https://h-validar.iti.gov.br" target="_blank" class="underline font-semibold">h-validar.iti.gov.br</a>
    <span class="text-blue-400"> (homologação)</span>
  </div>

</div>

<%- include('../partials/footer') %>
