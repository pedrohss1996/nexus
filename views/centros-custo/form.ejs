<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Centro de Custo - DataFlow', user: user }) %>

<div class="w-full px-6 py-6">
  <div class="max-w-2xl mx-auto">
    <nav class="flex items-center text-sm text-gray-500 dark:text-gray-400 mb-5">
      <a href="/centros-custo" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Centros de Custo</a>
      <svg class="w-4 h-4 mx-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-900 dark:text-white font-medium"><%= centro ? 'Editar' : 'Novo' %></span>
    </nav>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700">
        <h1 class="text-lg font-bold text-gray-900 dark:text-white"><%= centro ? 'Editar centro de custo' : 'Novo centro de custo' %></h1>
      </div>

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="mx-6 mt-4 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700">
          <p class="text-sm text-red-700 dark:text-red-300"><%= erro %></p>
        </div>
      <% } %>

      <form method="POST" action="<%= centro ? `/centros-custo/${centro.id}` : '/centros-custo' %>" class="p-6 space-y-5">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Nome <span class="text-red-500">*</span></label>
            <input type="text" name="nome" value="<%= centro ? centro.nome : '' %>" required maxlength="255"
              placeholder="Ex: Administração, TI, Cirurgia..."
              class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Código</label>
            <input type="text" name="codigo" value="<%= centro ? centro.codigo || '' : '' %>" maxlength="50"
              placeholder="CC-001"
              class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Tipo</label>
          <select name="tipo"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
            <% [['operacional','Operacional'],['investimento','Investimento'],['administrativo','Administrativo'],
                ['comercial','Comercial'],['producao','Produção'],['pesquisa','Pesquisa e Desenvolvimento']].forEach(function(t) { %>
              <option value="<%= t[0] %>" <%= centro && centro.tipo === t[0] ? 'selected' : (t[0]==='operacional'&&!centro?'selected':'') %>><%= t[1] %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Unidade</label>
          <select name="unidade_id"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
            <option value="">— Sem unidade vinculada —</option>
            <% unidades.forEach(function(u) { %>
              <option value="<%= u.id %>" <%= centro && centro.unidade_id == u.id ? 'selected' : '' %>><%= u.nome %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Responsável</label>
          <input type="text" name="responsavel" value="<%= centro ? centro.responsavel || '' : '' %>" maxlength="255"
            placeholder="Nome do responsável pelo centro de custo"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Orçamento total (R$)</label>
          <input type="number" name="valor_total" value="<%= centro ? centro.valor_total || 0 : 0 %>" min="0" step="0.01"
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Descrição</label>
          <textarea name="descricao" rows="3" maxlength="500"
            placeholder="Descreva a finalidade deste centro de custo..."
            class="w-full rounded-lg border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white px-3 py-2.5 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors resize-none"><%= centro ? centro.descricao || '' : '' %></textarea>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-slate-700">
          <a href="/centros-custo" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white font-medium transition-colors">Cancelar</a>
          <button type="submit" class="inline-flex items-center gap-2 bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <%= centro ? 'Salvar alterações' : 'Criar centro de custo' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
