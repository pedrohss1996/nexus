<%- include('../partials/header', { title: 'Histórico de Documentos - DataFlow', user: typeof user !== 'undefined' ? user : null }) %>

<div class="w-full px-6 py-6 space-y-5">

  <!-- Cabeçalho -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/documentos-pdf" class="p-1.5 rounded-lg text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      </a>
      <div>
        <h1 class="text-xl font-bold text-gray-900 dark:text-white">Histórico de Documentos</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5"><%= documentos.length %> documento<%= documentos.length !== 1 ? 's' : '' %> gerado<%= documentos.length !== 1 ? 's' : '' %></p>
      </div>
    </div>
    <a href="/documentos-pdf/novo" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Novo modelo
    </a>
  </div>

  <!-- Tabela -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden">
    <% if (documentos.length === 0) { %>
      <div class="flex flex-col items-center py-20 text-center px-4">
        <div class="bg-gray-100 dark:bg-slate-700 rounded-full p-4 mb-4">
          <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Nenhum documento gerado</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Gere seu primeiro documento a partir de um modelo.</p>
        <a href="/documentos-pdf" class="text-sm text-blue-600 dark:text-blue-400 hover:underline font-medium">Ver modelos disponíveis</a>
      </div>
    <% } else { %>
      <!-- Busca rápida -->
      <div class="px-5 py-3 border-b border-gray-200 dark:border-slate-700">
        <input type="text" id="buscaHistorico" placeholder="Filtrar por título ou modelo..."
          class="w-full sm:w-64 text-sm border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-gray-900 dark:text-white rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 placeholder-gray-400">
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
          <thead class="bg-gray-50 dark:bg-slate-700/50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Documento</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden md:table-cell">Modelo</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden sm:table-cell">Gerado por</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden lg:table-cell">Data</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider hidden xl:table-cell">Tamanho</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Baixar</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
            <% documentos.forEach(function(doc) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/40 transition-colors hist-row" data-titulo="<%= (doc.titulo || '').toLowerCase() %>" data-template="<%= (doc.template_nome || '').toLowerCase() %>">
                <td class="px-5 py-3.5">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-red-100 dark:bg-red-900/30 rounded-lg flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-gray-900 dark:text-white truncate max-w-[180px]"><%= doc.titulo || 'Sem título' %></p>
                      <p class="text-xs text-gray-400 dark:text-gray-500 truncate max-w-[180px]"><%= doc.nome_arquivo %></p>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3.5 hidden md:table-cell">
                  <span class="text-sm text-gray-700 dark:text-gray-300"><%= doc.template_nome || '-' %></span>
                </td>
                <td class="px-5 py-3.5 hidden sm:table-cell">
                  <span class="text-sm text-gray-500 dark:text-gray-400"><%= doc.gerador_nome || '-' %></span>
                </td>
                <td class="px-5 py-3.5 hidden lg:table-cell">
                  <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
                    <%= new Date(doc.gerado_em).toLocaleString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                  </span>
                </td>
                <td class="px-5 py-3.5 hidden xl:table-cell">
                  <span class="text-sm text-gray-500 dark:text-gray-400">
                    <%= doc.tamanho_bytes ? (doc.tamanho_bytes / 1024).toFixed(1) + ' KB' : '-' %>
                  </span>
                </td>
                <td class="px-5 py-3.5">
                  <div class="flex justify-center">
                    <a href="/documentos-pdf/download/<%= doc.nome_arquivo %>"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      Baixar
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
var busca = document.getElementById('buscaHistorico');
if (busca) {
  busca.addEventListener('input', function() {
    var termo = busca.value.toLowerCase();
    document.querySelectorAll('.hist-row').forEach(function(row) {
      var titulo = row.dataset.titulo || '';
      var tmpl = row.dataset.template || '';
      row.style.display = (!termo || titulo.includes(termo) || tmpl.includes(termo)) ? '' : 'none';
    });
  });
}
</script>

<%- include('../partials/paginacao', { meta: meta }) %>

<%- include('../partials/footer') %>
