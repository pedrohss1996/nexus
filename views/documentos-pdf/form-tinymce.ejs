<%- include('../partials/header') %>

<!-- Carregar TinyMCE -->
<script src="/libs/tinymce/tinymce.min.js"></script>

<style>
  /* Remover padding do main e usar tela inteira */
  main {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  
  body {
    overflow-x: hidden;
  }
</style>

<div class="w-full">
  <!-- Cabeçalho -->
  <div class="bg-white dark:bg-slate-800 border-b border-gray-200 dark:border-slate-700 px-8 py-4">
    <div class="flex items-center justify-between">
      <div>
        <a href="/documentos-pdf" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 flex items-center mb-2">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Voltar para Templates
        </a>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          <%= template ? 'Editar Template' : 'Novo Template' %>
        </h1>
      </div>
      <div class="flex gap-3">
        <a 
          href="/documentos-pdf"
          class="px-6 py-2.5 border-2 border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors font-medium"
        >
          Cancelar
        </a>
        <button 
          type="submit"
          form="formTemplate"
          class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-medium transition-colors flex items-center"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <%= template ? 'Atualizar' : 'Criar Template' %>
        </button>
      </div>
    </div>
  </div>

  <!-- Formulário -->
  <form action="<%= action %>" method="POST" id="formTemplate">
    <!-- Informações Básicas - Barra superior -->
    <div class="bg-gray-50 dark:bg-slate-900 border-b border-gray-200 dark:border-slate-700 px-8 py-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Nome -->
        <div>
          <label for="nome" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Nome do Template *
          </label>
          <input 
            type="text" 
            id="nome" 
            name="nome" 
            required
            value="<%= template ? template.nome : '' %>"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-slate-700 dark:text-white"
            placeholder="Ex: Comunicação de Abono"
          >
        </div>

        <!-- Tipo de Documento -->
        <div>
          <label for="tipo_documento" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Tipo de Documento *
          </label>
          <select 
            id="tipo_documento" 
            name="tipo_documento" 
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-slate-700 dark:text-white"
          >
            <option value="">Selecione...</option>
            <option value="termo" <%= template && template.tipo_documento === 'termo' ? 'selected' : '' %>>Termo</option>
            <option value="oficio" <%= template && template.tipo_documento === 'oficio' ? 'selected' : '' %>>Ofício</option>
            <option value="declaracao" <%= template && template.tipo_documento === 'declaracao' ? 'selected' : '' %>>Declaração</option>
            <option value="contrato" <%= template && template.tipo_documento === 'contrato' ? 'selected' : '' %>>Contrato</option>
            <option value="relatorio" <%= template && template.tipo_documento === 'relatorio' ? 'selected' : '' %>>Relatório</option>
            <option value="comunicacao" <%= template && template.tipo_documento === 'comunicacao' ? 'selected' : '' %>>Comunicação</option>
            <option value="atestado" <%= template && template.tipo_documento === 'atestado' ? 'selected' : '' %>>Atestado</option>
            <option value="solicitacao" <%= template && template.tipo_documento === 'solicitacao' ? 'selected' : '' %>>Solicitação</option>
            <option value="parecer" <%= template && template.tipo_documento === 'parecer' ? 'selected' : '' %>>Parecer</option>
            <option value="outro" <%= template && template.tipo_documento === 'outro' ? 'selected' : '' %>>Outro</option>
          </select>
        </div>

        <!-- Descrição -->
        <div>
          <label for="descricao" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Descrição
          </label>
          <input 
            type="text" 
            id="descricao" 
            name="descricao" 
            value="<%= template ? template.descricao : '' %>"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-slate-700 dark:text-white"
            placeholder="Breve descrição"
          >
        </div>
      </div>
    </div>

    <!-- Editor TinyMCE - Tela inteira -->
    <div class="bg-white dark:bg-slate-800 px-8 py-6" style="height: calc(100vh - 240px);">
      <textarea id="editor" name="conteudo_html"><%= template ? template.conteudo_html : '' %></textarea>
    </div>
  </form>
</div>

<script>
tinymce.init({
  selector: '#editor',
  height: '100%',
  menubar: true,
  language: 'pt_BR',
  
  // Plugins completos - MUITO mais poderoso que Quill
  plugins: [
    'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
    'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
    'insertdatetime', 'media', 'table', 'help', 'wordcount', 'emoticons',
    'codesample', 'pagebreak', 'nonbreaking', 'visualchars'
  ],
  
  // Barra de ferramentas COMPLETA
  toolbar1: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify',
  toolbar2: 'forecolor backcolor | bullist numlist outdent indent | table tabledelete | tableprops tablerowprops tablecellprops | tableinsertrowbefore tableinsertrowafter tabledeleterow | tableinsertcolbefore tableinsertcolafter tabledeletecol',
  toolbar3: 'link image media | charmap emoticons | code fullscreen preview | insertvariavel | help',
  
  // Configurações de tabela avançadas
  table_toolbar: 'tableprops tabledelete | tableinsertrowbefore tableinsertrowafter tabledeleterow | tableinsertcolbefore tableinsertcolafter tabledeletecol',
  table_appearance_options: true,
  table_grid: true,
  table_tab_navigation: true,
  table_default_attributes: {
    border: '1'
  },
  table_default_styles: {
    'border-collapse': 'collapse',
    'width': '100%'
  },
  
  // Estilos de conteúdo
  content_style: `
    body { 
      font-family: Arial, sans-serif; 
      font-size: 14px;
      padding: 20px;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      margin: 10px 0;
    }
    table td, table th {
      border: 1px solid #ddd;
      padding: 8px;
    }
    table th {
      background-color: #f3f4f6;
      font-weight: bold;
    }
    .variavel {
      background-color: #f3e8ff;
      color: #9333ea;
      font-weight: bold;
      padding: 2px 4px;
      border-radius: 3px;
    }
  `,
  
  // Formatos disponíveis
  block_formats: 'Parágrafo=p; Título 1=h1; Título 2=h2; Título 3=h3; Pré-formatado=pre',
  
  // Fontes disponíveis
  font_family_formats: 'Arial=arial,helvetica,sans-serif; Courier New=courier new,courier,monospace; Georgia=georgia,palatino; Times New Roman=times new roman,times; Verdana=verdana,geneva',
  
  // Tamanhos de fonte
  font_size_formats: '8pt 10pt 12pt 14pt 16pt 18pt 24pt 36pt 48pt',
  
  // Permitir todos os elementos e atributos
  extended_valid_elements: '*[*]',
  valid_children: '+body[style]',
  
  // Configurações de imagem
  image_advtab: true,
  image_caption: true,
  image_title: true,
  
  // Auto-resize
  autoresize_bottom_margin: 50,
  
  // Botão customizado para inserir variáveis
  setup: function(editor) {
    // Botão Inserir Variável
    editor.ui.registry.addButton('insertvariavel', {
      text: 'Variável',
      icon: 'code-sample',
      tooltip: 'Inserir Variável',
      onAction: function() {
        const nomeVariavel = prompt('Nome da variável (ex: nome_servidor, data_emissao):');
        if (nomeVariavel) {
          editor.insertContent(`<span class="variavel">{{${nomeVariavel}}}</span> `);
        }
      }
    });
    
    // Atualizar preview em tempo real
    editor.on('change keyup', function() {
      // Aqui você pode adicionar lógica de preview se quiser
    });
  }
});

// Salvar conteúdo antes de submeter
document.getElementById('formTemplate').addEventListener('submit', function(e) {
  tinymce.triggerSave();
});
</script>

<%- include('../partials/footer') %>
