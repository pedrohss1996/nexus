# ============================================
# Autenticação JWT
# ============================================
# IMPORTANTE: Gere um secret seguro (mínimo 32 caracteres)
# Você pode gerar um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=bd8354e0b0b0734332d5ffcd0f3ea4cf3e84d446ae1104647355840020d4d7ff
JWT_EXPIRES_IN=24h

# ============================================
# Session
# ============================================
